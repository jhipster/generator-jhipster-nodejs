/*
 * This is the application and entity model for university elearning
 * default values: https://www.jhipster.tech/jdl/#annexes
 * Use "jhipster import-jdl model-name.jdl --blueprints nodejs" to generate the entire application
 * Use jhipster 6.x (example 6.8.0)
 * relationship info: https://www.jhipster.tech/managing-relationships/
 * REMEMBER TO FILL authenticationType and clientFramework
 */

application {
    config {
        applicationType monolith,
        baseName monolithClientAuthSqlJdlApp,
        packageName com.jhipster.node,
        databaseType sql,
        enableTranslation false,
        testFrameworks [cypress]
        // jhipster-needle-jdl-application-config
    }
    entities *
}

// JDL definition entity for application

enum Gender {
MALE,
FEMALE
}

enum UserType {
STUDENT,
TEACHER
}


entity DemetraUser {
    gender Gender required,
    address String minlength(1) maxlength(100) required,
    borndate LocalDate required,
    cf String required unique,
    usertype UserType required,
    // profileimage ImageBlob
}

// The roles of the entity, like @PreAuthorize of JHipster Spring Boot: ROLE_USER writes, ROLE_ADMIN reads too.
@EntityAuthority(ROLE_USER)
@EntityReadAuthority(ROLE_ADMIN)
entity SingleCourse {
    title String,
    // description String pattern(/^[A-Z]$/),
    // isnotonlyfordegree Boolean required,
    cfu Integer,
    // courseimage Blob,
    // amount BigDecimal
}

entity Activity {
    name UUID unique,
    description String,
    // mynumber Double,
    // creationtime ZonedDateTime
}

// relationship OneToOne {
//    Activity to SingleCourse
//}

// A String primary key, a UUID the server generates, referenced by a relationship.
entity Classroom {
    id String,
    name String required,
}

// A primary key the client gives, not named id, referenced by relationships.
entity Campus {
    @Id slug String required,
    name String,
}

relationship ManyToOne {
    Activity {demetrauser required} to DemetraUser
    SingleCourse {classroom(name)} to Classroom
    SingleCourse {campus(name)} to Campus
}

relationship ManyToMany {
    Activity {campuses(name)} to Campus {activities}
}


