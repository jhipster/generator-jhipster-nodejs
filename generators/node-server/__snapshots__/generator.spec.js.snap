exports[`SubGenerator node-server of nodejs JHipster blueprint > entity validators > should accept a missing value of an optional validated field 1`] = `
{
  "server/src/entities/book/dto/book.dto.ts": {
    "contents": "import { ApiProperty } from '@nestjs/swagger';
import { Allow, IsNotEmpty, IsOptional, IsEnum, MinLength, MaxLength, Length, Min, Max, Matches, IsInt, IsNumber, IsBoolean, IsUUID, IsISO8601 } from 'class-validator';
import { BaseDTO } from '../../../common/dto/base.dto.ts';


import { Genre } from '../../enumeration/genre.ts';
import { BookFormat } from '../../enumeration/book-format.ts';


/**
 * A BookDTO object.
 */
export class BookDTO extends BaseDTO {
  @Allow()
  id?: number;

            @IsNotEmpty()
    @MaxLength(50)
            @ApiProperty({description: 'title field'})
        title!: string;

            @IsOptional()
    @Matches("^(?:^\\\\d{3}-[0-9]{6}$)$")
            @ApiProperty({description: 'isbn field', required: false})
        isbn?: string;

            @IsOptional()
    @Min(1)
    @Max(5000)
    @IsInt()
            @ApiProperty({description: 'pages field', required: false})
        pages?: number;

            @IsOptional()
    @IsEnum(Genre)
            @ApiProperty({ enum: Genre,description: 'genre enum field', required: false})
        genre?: Genre;

            @IsNotEmpty()
    @IsEnum(BookFormat)
            @ApiProperty({ enum: BookFormat,description: 'format enum field'})
        format!: BookFormat;

            @IsNotEmpty()
            @ApiProperty({description: 'cover field'})
        cover!: string;


        @Allow()
        coverContentType!: string;


  // jhipster-needle-entity-add-field - JHipster will add fields here, do not remove
}
",
    "stateCleared": "modified",
  },
}
`;

