{
  "server/src/entities/sample/sample.entity.ts": {
    "contents": "import {PrimaryGeneratedColumn, Entity, Column, JoinColumn, OneToOne, ManyToOne, OneToMany, ManyToMany, JoinTable, type Relation} from 'typeorm';
import { BaseEntity } from '../../common/database/base.entity.ts';
import { numberTransformer } from '../../common/database/column-transformers.ts';


import { Level } from '../enumeration/level.ts';


/**
 * A Sample.
 */
@Entity('sample')
export class Sample extends BaseEntity  {

  @PrimaryGeneratedColumn()
  id?: number;

    @Column({ type: 'integer', name: 'count', nullable: true })
    count?: number;

    @Column({ type: 'bigint', name: 'big', nullable: true, transformer: numberTransformer })
    big?: number;

    @Column({ type: 'float', name: 'ratio', nullable: true })
    ratio?: number;

    @Column({ type: 'double precision', name: 'rate', nullable: true })
    rate?: number;

    @Column({ type: 'decimal', name: 'amount', precision: 21, scale: 2, nullable: true, transformer: numberTransformer })
    amount?: number;

    @Column({ type: 'date', name: 'day', nullable: true })
    day?: string;

    @Column({ name: 'active', nullable: true })
    active?: boolean;

    @Column({ type: 'simple-enum', name: 'level', enum: Level, nullable: true })
    level?: Level;

    @Column({ type: 'text', name: 'photo', nullable: true })
    photo?: string;

    @Column({ name: 'photo_content_type', nullable: true })
    photoContentType?: string;
    @Column({ type: 'text', name: 'notes', nullable: true })
    notes?: string;


    // jhipster-needle-entity-add-field - JHipster will add fields here, do not remove

}
",
    "stateCleared": "modified",
  },
}
`;

