// DataSource of the typeorm CLI (the typeorm npm scripts): the database of the application, of the profiles BACKEND_ENV activates.
import 'dotenv/config';
import { DataSource, DataSourceOptions } from 'typeorm';
import { ormConfig } from './src/orm.config';
<%_ if (databaseTypeMongodb) { _%>
import { activeProfiles, config } from './src/config';
<%_ } _%>

<%_ if (databaseTypeMongodb) { _%>
// An embedded database (the in-memory MongoDB server of the test profile) is a new and empty database for each command.
if (config.get('database.embedded')) {
  throw new Error(`The typeorm scripts need a MongoDB database, not the embedded one of the ${activeProfiles.join(',')} profiles.`);
}

// The configuration of MongoDB is asynchronous, the typeorm CLI awaits the exported DataSource.
export default (async (): Promise<DataSource> =>
  new DataSource({
    ...(await ormConfig()),
<%_ } else { _%>
export default new DataSource({
  ...ormConfig(),
<%_ } _%>
  // Every entity, the built-in ones loaded by autoLoadEntities in the application included.
  entities: [`${__dirname}/src/domain/*.entity.{ts,js}`],
  // Every migration, the ones created or generated by the scripts included.
  migrations: [`${__dirname}/src/migrations/*.{ts,js}`],
  // The CLI changes the schema only when a command asks it.
  synchronize: false,
  migrationsRun: false,
<%_ if (databaseTypeMongodb) { _%>
  } as DataSourceOptions))();
<%_ } else { _%>
} as DataSourceOptions);
<%_ } _%>
