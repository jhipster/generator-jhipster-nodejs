// DataSource of the typeorm CLI (the typeorm npm scripts): the database of the application, as BACKEND_ENV selects it.
import 'dotenv/config';
import { DataSource, DataSourceOptions } from 'typeorm';
import { ormConfig } from './src/orm.config';

export default new DataSource({
  ...ormConfig(),
  // Every entity, the built-in ones loaded by autoLoadEntities in the application included.
  entities: [`${__dirname}/src/domain/*.entity.{ts,js}`],
  // Every migration, the ones created or generated by the scripts included.
  migrations: [`${__dirname}/src/migrations/*.{ts,js}`],
  // The CLI changes the schema only when a command asks it.
  synchronize: false,
  migrationsRun: false,
} as DataSourceOptions);
