// DataSource of the typeorm CLI (the typeorm npm scripts): the database of the application, of the profiles BACKEND_ENV
// activates. Node.js runs this file as it is (type stripping) and imports the build in dist: the entities and the
// migrations of src have decorators, which Node.js does not run.
import { config as loadEnv } from 'dotenv';
import { DataSource, type DataSourceOptions } from 'typeorm';
import type * as OrmConfigModule from './src/orm.config.ts';
<%_ if (databaseTypeMongodb) { _%>
import type * as ConfigModule from './src/config.ts';
<%_ } _%>

// The local settings of .env, then the development profile of .env.dev, like the development scripts: a variable set in
// the environment wins, like BACKEND_ENV=prod.
loadEnv({ path: ['.env', '.env.dev'], quiet: true });

const build = './dist';
const { ormConfig } = (await import(`${build}/orm.config.js`)) as typeof OrmConfigModule;
<%_ if (databaseTypeMongodb) { _%>
const { activeProfiles, config } = (await import(`${build}/config.js`)) as typeof ConfigModule;

// An embedded database (the in-memory MongoDB server of the test profile) is a new and empty database for each command.
if (config.get('database.embedded')) {
  throw new Error(`The typeorm scripts need a MongoDB database, not the embedded one of the ${activeProfiles.join(',')} profiles.`);
}
<%_ } _%>

export default new DataSource({
  ...<%- databaseTypeMongodb ? '(await ormConfig())' : 'ormConfig()' %>,
  // Every entity, the built-in ones loaded by autoLoadEntities in the application included.
  entities: [`${import.meta.dirname}/dist/**/*.entity.js`],
  // Every migration, the ones created or generated by the scripts included.
  migrations: [`${import.meta.dirname}/dist/migrations/*.js`],
  // The CLI changes the schema only when a command asks it.
  synchronize: false,
  migrationsRun: false,
} as DataSourceOptions);
