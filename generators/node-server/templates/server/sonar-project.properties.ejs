# --- properties for sonar ---
sonar.projectKey=<%= baseName %>-nodejs
sonar.projectVersion=0.0.1
sonar.host.url=http://localhost:9001
sonar.sources=src
# The specs next to the code, the unit tests of test and the end-to-end tests of e2e are the tests, not sources.
sonar.exclusions=src/**/*.spec.ts
sonar.tests=src,test,e2e
sonar.test.inclusions=**/*.spec.ts,**/*.e2e-spec.ts
sonar.typescript.lcov.reportPaths=coverage/lcov.info
