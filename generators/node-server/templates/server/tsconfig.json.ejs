{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS output ("type": "commonjs"), resolving packages like Node.js does; allows require() of the ESM-only NestJS packages.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    // Required by the NestJS decorators and dependency injection.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "**/*spec.ts", "e2e/setup.test.js", "scripts/*.ts", "ormconfig.ts"]
}
