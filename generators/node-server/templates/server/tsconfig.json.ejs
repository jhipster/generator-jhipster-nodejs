{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // ES modules ("type": "module"), resolved like Node.js does.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    // Relative imports name the TypeScript file (./app.module.ts), emitted as the JavaScript one (./app.module.js), like
    // the TypeScript files Node.js runs directly.
    "rewriteRelativeImportExtensions": true,
    // The ambient types (TypeScript 6 includes none by default); the specs import the test API from vitest.
    "types": ["node"],
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    // Required by the NestJS decorators and dependency injection.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "**/*spec.ts", "e2e/setup.test.js", "scripts/*.ts", "ormconfig.ts", "vitest.config*.ts"]
}
