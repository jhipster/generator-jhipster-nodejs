{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS output ("type": "commonjs"), resolving packages like Node.js does; allows require() of the ESM-only NestJS packages.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    // Relative imports name the TypeScript file (./app.module.ts), emitted as the JavaScript one (./app.module.js), like
    // the TypeScript files Node.js runs directly.
    "rewriteRelativeImportExtensions": true,
    // The ambient types (TypeScript 6 includes none by default); the specs import the test API from vitest.
    "types": ["node"],
    "outDir": "dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    // Required by the NestJS decorators and dependency injection.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // ts-node (npm start, the typeorm scripts) resolves the emitted ./x.js imports to the ./x.ts files.
  "ts-node": {
    "experimentalResolver": true
  },
  "include": ["src/**/*", "**/*spec.ts", "e2e/setup.test.js", "scripts/*.ts", "ormconfig.ts", "vitest.config*.ts"]
}
