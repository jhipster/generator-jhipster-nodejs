import type { TransformFnParams } from 'class-transformer';
import { isUUID, ValidateBy, type ValidationOptions } from 'class-validator';

import { UNREADABLE } from '../errors/problem.exception.ts';

/** A JSON number: an integer or a decimal, with an exponent or not. */
const NUMBER = /^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/;

/**
 * The @Transform of a number field: a number given as a text is the number, like the JSON deserialization (Jackson) of
 * JHipster Spring Boot accepts "12.50" for a BigDecimal. Any other value is kept for the validators of the field to refuse.
 */
export const numberFromString = ({ value }: TransformFnParams): unknown =>
  typeof value === 'string' && NUMBER.test(value) ? Number(value) : value;

/**
 * The type of a relationship of a DTO, like the Relation of the TypeORM entities: two related DTOs import each other, and
 * ES modules evaluate such a cycle one module at a time, so the decorator metadata of the property must not reference
 * the other class (with this type it is Object), or the first module fails with "Cannot access ... before initialization".
 */
export type RelatedDTO<T> = T;

/**
 * The size of a binary blob, like the @Size of a byte[] of JHipster Spring Boot: the bytes of its base64, from min to max
 * (no maximum when it is not given). A value that is not a text is left to the type validator of the field (@IsBase64).
 */
export const ByteLength = (min: number, max?: number, options?: ValidationOptions): PropertyDecorator =>
  ValidateBy(
    {
      name: 'byteLength',
      constraints: [min, max],
      validator: {
        validate: (value: unknown): boolean => {
          if (typeof value !== 'string') return true;
          const size = Buffer.from(value, 'base64').length;
          return size >= min && (max === undefined || size <= max);
        },
        defaultMessage: args =>
          max === undefined
            ? `${args?.property} must be at least ${min} bytes`
            : `${args?.property} must be between ${min} and ${max} bytes`,
      },
    },
    options,
  );

/** The JSON type of an id: an integer (Long, Integer), a UUID, or another text (a String, the ObjectId of MongoDB). */
export type IdType = 'integer' | 'uuid' | 'string';

const ID_TYPES: Record<IdType, (id: unknown) => boolean> = {
  integer: id => Number.isInteger(id),
  uuid: id => typeof id === 'string' && isUUID(id),
  string: id => typeof id === 'string',
};

/** An id of its type, or no id (null or undefined): a record without one, which the rules of its route answer. */
const isIdOrEmpty = (type: IdType, id: unknown): boolean => id === undefined || id === null || ID_TYPES[type](id);

/** A related record: an object with an id of its type, or without an id. */
const isReference = (type: IdType, id: string, related: unknown): boolean =>
  typeof related === 'object' && related !== null && !Array.isArray(related) && isIdOrEmpty(type, (related as Record<string, unknown>)[id]);

/**
 * The id of a DTO, of its JSON type: like the contract of the backends, a value of another type (the text "1" of a Long)
 * is a body that is not read (400), not converted. A missing id is left to the rules of the route (error.idnull).
 */
export const IsId = (type: IdType): PropertyDecorator =>
  ValidateBy(
    {
      name: 'isId',
      constraints: [type],
      validator: {
        validate: (value: unknown): boolean => isIdOrEmpty(type, value),
        defaultMessage: args => `${args?.property} must be an id of type ${type}`,
      },
    },
    UNREADABLE,
  );

/**
 * A relationship of a DTO, its related record (or the list of them, for a collection) with an id of its JSON type: like
 * @IsId, a value of another type (the text "1" of a Long, a text for the record) is a body that is not read (400), not
 * converted. A related record without its id is left to the reference of the service (a data integrity violation).
 */
export const IsRelated = (id: string, type: IdType, collection = false): PropertyDecorator =>
  ValidateBy(
    {
      name: 'isRelated',
      constraints: [id, type],
      validator: {
        validate: (value: unknown): boolean => {
          if (value === undefined || value === null) return true;
          if (!collection) return isReference(type, id, value);
          return Array.isArray(value) && value.every(related => isReference(type, id, related));
        },
        defaultMessage: args => `${args?.property} must be ${collection ? 'a list of records' : 'a record'} with an id of type ${type}`,
      },
    },
    UNREADABLE,
  );
