import { Transform, type TransformFnParams } from 'class-transformer';
import { isUUID, ValidateBy, type ValidationOptions } from 'class-validator';

import { UNREADABLE } from '../errors/problem.exception.ts';

/** A JSON number: an integer or a decimal, with an exponent or not. */
const NUMBER = /^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/;

/**
 * The @Transform of a Long or a BigDecimal field: a number given as a text is the number, like the contract of the
 * backends accepts "12.50" for a BigDecimal (I-JSON, RFC 7493, recommends a text for a number beyond the precision of a
 * double). Any other value is kept for the validators of the field to refuse.
 */
export const numberFromString = ({ value }: TransformFnParams): unknown =>
  typeof value === 'string' && NUMBER.test(value) ? Number(value) : value;

/**
 * The type of a relationship of a DTO, like the Relation of the TypeORM entities: two related DTOs import each other, and
 * ES modules evaluate such a cycle one module at a time, so the decorator metadata of the property must not reference
 * the other class (with this type it is Object), or the first module fails with "Cannot access ... before initialization".
 */
export type RelatedDTO<T> = T;

/**
 * The size of a binary blob, like the @Size of a byte[] of JHipster Spring Boot: the bytes of its base64, from min to max
 * (no maximum when it is not given). A value that is not a text is left to the type validator of the field (@IsBase64).
 */
export const ByteLength = (min: number, max?: number, options?: ValidationOptions): PropertyDecorator =>
  ValidateBy(
    {
      name: 'byteLength',
      constraints: [min, max],
      validator: {
        validate: (value: unknown): boolean => {
          if (typeof value !== 'string') return true;
          const size = Buffer.from(value, 'base64').length;
          return size >= min && (max === undefined || size <= max);
        },
        defaultMessage: args =>
          max === undefined
            ? `${args?.property} must be at least ${min} bytes`
            : `${args?.property} must be between ${min} and ${max} bytes`,
      },
    },
    options,
  );

/**
 * The JSON type of an id: a Long (a number, or its text), an Integer (a number only), a UUID, or another text (a String,
 * the ObjectId of MongoDB).
 */
export type IdType = 'long' | 'integer' | 'uuid' | 'string';

/** The text of an integer, the text a Long may be given as. */
const INTEGER = /^[-+]?\d+$/;

const ID_TYPES: Record<IdType, (id: unknown) => boolean> = {
  // A Long given as a text is converted before the validation (idFromText).
  long: id => Number.isInteger(id),
  integer: id => Number.isInteger(id),
  uuid: id => typeof id === 'string' && isUUID(id),
  string: id => typeof id === 'string',
};

/** An id of its type, or no id (null or undefined): a record without one, which the rules of its route answer. */
const isIdOrEmpty = (type: IdType, id: unknown): boolean => id === undefined || id === null || ID_TYPES[type](id);

/** A related record: an object with an id of its type, or without an id. */
const isReference = (type: IdType, id: string, related: unknown): boolean =>
  typeof related === 'object' && related !== null && !Array.isArray(related) && isIdOrEmpty(type, (related as Record<string, unknown>)[id]);

/** A Long id given as a text is the number; any other value is kept for the validation to refuse. */
const idFromText = (type: IdType, id: unknown): unknown => (type === 'long' && typeof id === 'string' && INTEGER.test(id) ? Number(id) : id);

/** A related record with its Long id given as a text, with the number. */
const referenceFromText = (type: IdType, id: string, related: unknown): unknown =>
  typeof related === 'object' && related !== null && !Array.isArray(related) && id in related
    ? { ...related, [id]: idFromText(type, (related as Record<string, unknown>)[id]) }
    : related;

/**
 * The id of a DTO, of its JSON type, like the contract of the backends: a Long given as a text is the number, a value of
 * another type (the text "1" of an Integer, a text that is not a UUID) is a body that is not read (400), not converted. A
 * missing id is left to the rules of the route (error.idnull).
 */
export const IsId =
  (type: IdType): PropertyDecorator =>
  (target, property) => {
    Transform(({ value }) => idFromText(type, value), { toClassOnly: true })(target, property);
    ValidateBy(
      {
        name: 'isId',
        constraints: [type],
        validator: {
          validate: (value: unknown): boolean => isIdOrEmpty(type, value),
          defaultMessage: args => `${args?.property} must be an id of type ${type}`,
        },
      },
      UNREADABLE,
    )(target, property);
  };

/**
 * A relationship of a DTO, its related record (or the list of them, for a collection) with an id of its JSON type, like
 * @IsId: a Long given as a text is the number, a value of another type (a text for the record, the text of an Integer
 * id) is a body that is not read (400), not converted. A related record without its id is left to the reference of the
 * service (a data integrity violation).
 */
export const IsRelated =
  (id: string, type: IdType, collection = false): PropertyDecorator =>
  (target, property) => {
    Transform(
      ({ value }) =>
        collection && Array.isArray(value) ? value.map(related => referenceFromText(type, id, related)) : referenceFromText(type, id, value),
      { toClassOnly: true },
    )(target, property);
    ValidateBy(
      {
        name: 'isRelated',
        constraints: [id, type],
        validator: {
          validate: (value: unknown): boolean => {
            if (value === undefined || value === null) return true;
            if (!collection) return isReference(type, id, value);
            return Array.isArray(value) && value.every(related => isReference(type, id, related));
          },
          defaultMessage: args => `${args?.property} must be ${collection ? 'a list of records' : 'a record'} with an id of type ${type}`,
        },
      },
      UNREADABLE,
    )(target, property);
  };
