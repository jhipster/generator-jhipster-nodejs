import type { TransformFnParams } from 'class-transformer';

/** A JSON number: an integer or a decimal, with an exponent or not. */
const NUMBER = /^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/;

/**
 * The @Transform of a number field: a number given as a text is the number, like the JSON deserialization (Jackson) of
 * JHipster Spring Boot accepts "12.50" for a BigDecimal. Any other value is kept for the validators of the field to refuse.
 */
export const numberFromString = ({ value }: TransformFnParams): unknown =>
  typeof value === 'string' && NUMBER.test(value) ? Number(value) : value;

/**
 * A DTO base object.
 */
export class BaseDTO {
  createdBy?: string;

  createdDate?: Date;

  lastModifiedBy?: string;

  lastModifiedDate?: Date;
}

/**
 * The type of a relationship of a DTO, like the Relation of the TypeORM entities: two related DTOs import each other, and
 * ES modules evaluate such a cycle one module at a time, so the decorator metadata of the property must not reference
 * the other class (with this type it is Object), or the first module fails with "Cannot access ... before initialization".
 */
export type RelatedDTO<T> = T;
