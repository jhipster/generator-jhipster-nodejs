import { EntityMetadata<% if (databaseTypeMongodb) { %>, FindOptionsOrder<% } %> } from 'typeorm';

export interface SortableOptions {
  /** Columns of the entity no list can be sorted on, like the password of a user. */
  unsortable?: string[];
  /** The label of each relationship, the field of the other entity a list of the entity displays, like `name`. */
  labels?: Record<string, string>;
}

/**
 * Whether a list of the entity can be sorted on a property, found by introspection of its TypeORM metadata like Spring
 * Data validates the sort of a pageable: a column of the entity, or, for a relationship to one it owns, the id or the label of
 * the other entity (`region.id`, `region.name`). A relationship itself, a collection, another column of the other
 * entity or a deeper path cannot be sorted on.
 */
export function isSortableProperty(metadata: EntityMetadata, property: string, { unsortable = [], labels = {} }: SortableOptions = {}): boolean {
  const [name, otherProperty, ...deeper] = property.split('.');
  const relation = metadata.findRelationWithPropertyPath(name);
  if (otherProperty === undefined) {
    return relation === undefined && !unsortable.includes(name) && metadata.findColumnWithPropertyPath(name) !== undefined;
  }
  if (relation === undefined || !relation.isOwning || relation.isOneToMany || relation.isManyToMany || deeper.length > 0) {
    return false;
  }
  const otherMetadata = relation.inverseEntityMetadata;
  const isId = otherMetadata.primaryColumns.some(column => column.propertyName === otherProperty);
  return (isId || labels[name] === otherProperty) && otherMetadata.findColumnWithPropertyPath(otherProperty) !== undefined;
}
<%_ if (databaseTypeMongodb) { _%>

/**
 * The order of a MongoDB query by the names of the fields of the documents: TypeORM sorts a MongoDB query by the keys of
 * the order as given, the names of the properties, and the id of a document is its _id.
 */
export function documentOrder<T>(metadata: EntityMetadata, order?: FindOptionsOrder<T>): FindOptionsOrder<T> | undefined {
  return (
    order &&
    (Object.fromEntries(
      Object.entries(order).map(([property, direction]) => [metadata.findColumnWithPropertyPath(property)?.databaseName ?? property, direction]),
    ) as FindOptionsOrder<T>)
  );
}
