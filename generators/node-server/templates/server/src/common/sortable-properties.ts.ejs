import { EntityMetadata<%- databaseTypeMongodb ? ', FindOptionsOrder' : '' %> } from 'typeorm';

/** The properties marked by @NotSortable, by the prototype of the class declaring them. */
const notSortableProperties = new WeakMap<object, Set<string>>();

/**
 * Marks a property no list of the entity can be sorted by, like the NotSortable annotation of JHipster Spring Boot: a
 * secret of the user, or a binary blob. On a relationship, no property of the related entity can be sorted by.
 */
export function NotSortable(): PropertyDecorator {
  return (target, propertyKey) => {
    const properties = notSortableProperties.get(target) ?? new Set<string>();
    properties.add(String(propertyKey));
    notSortableProperties.set(target, properties);
  };
}

/** Whether a property of the entity, or of a class it extends, is marked by @NotSortable. */
const isNotSortable = (metadata: EntityMetadata, property: string): boolean => {
  // The target of an entity class is the class; the one of an entity schema, a name without properties marked.
  const target = typeof metadata.target === 'function' ? (metadata.target.prototype as object) : undefined;
  for (let prototype = target; prototype; prototype = Object.getPrototypeOf(prototype) as object | undefined) {
    if (notSortableProperties.get(prototype)?.has(property)) {
      return true;
    }
  }
  return false;
};

/** Whether a property is a column of the entity a list can be sorted by. */
const isSortableColumn = (metadata: EntityMetadata, property: string): boolean =>
  metadata.findRelationWithPropertyPath(property) === undefined &&
  metadata.findColumnWithPropertyPath(property) !== undefined &&
  !isNotSortable(metadata, property);

/**
 * Whether a list of the entity can be sorted by a property, found by introspection of its TypeORM metadata like the
 * SortValidator of JHipster Spring Boot: a column of the entity, or a column of an entity it relates to by a relationship
 * to one it owns, one level (`region.name`), but not a property marked by @NotSortable. A relationship itself, a
 * collection, a deeper path or what is not a column cannot be sorted by, nor the inverse side of a one-to-one, which the
 * lists do not load (JHipster Spring Boot sorts by it).
 */
export function isSortableProperty(metadata: EntityMetadata, property: string): boolean {
  const [name, otherProperty, ...deeper] = property.split('.');
  if (otherProperty === undefined) {
    return isSortableColumn(metadata, name);
  }
  const relation = metadata.findRelationWithPropertyPath(name);
  if (relation === undefined || !relation.isOwning || relation.isManyToMany || deeper.length > 0 || isNotSortable(metadata, name)) {
    return false;
  }
  return isSortableColumn(relation.inverseEntityMetadata, otherProperty);
}
<%_ if (databaseTypeMongodb) { _%>

/**
 * The order of a MongoDB query by the names of the fields of the documents: TypeORM sorts a MongoDB query by the keys of
 * the order as given, the names of the properties, and the id of a document is its _id.
 */
export function documentOrder<T>(metadata: EntityMetadata, order?: FindOptionsOrder<T>): FindOptionsOrder<T> | undefined {
  return (
    order &&
    (Object.fromEntries(
      Object.entries(order).map(([property, direction]) => [
        metadata.findColumnWithPropertyPath(property)?.databaseName ?? property,
        direction,
      ]),
    ) as FindOptionsOrder<T>)
  );
}
<%_ } _%>
