import { Body, CallHandler, ExecutionContext, Injectable, NestInterceptor, UnauthorizedException, UnsupportedMediaTypeException } from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { Request } from 'express';
import { Observable } from 'rxjs';

import { unreadableBodyException } from './problem.exception.ts';

/** The content types of a JSON body: application/json and the ones of its suffix, like application/merge-patch+json. */
const JSON_TYPE = /^application\/(?:[\w.-]+\+)?json$/i;

/**
 * A route whose body is a form (application/x-www-form-urlencoded), not JSON: the session login, which reads the parameters
 * of a form only, like the formLogin of Spring Security.
 */
export const FormBody = Reflector.createDecorator<void, boolean>({ transform: () => true });

/** A route whose body is a JSON object, marked by its @JsonBody() parameter. */
const JsonBodyRoute = Reflector.createDecorator<void, boolean>({ transform: () => true });

/**
 * The detail of a content type not supported, the one of JHipster Spring Boot: a type without / is not a media type, and
 * the type of a request gets the UTF-8 charset of the servlet when it tells none; a PATCH, whose route consumes its JSON
 * types, tells the type as it came.
 */
const unsupportedDetail = (contentType: string, method: string): string => {
  if (!contentType.split(';')[0].includes('/')) {
    return `Invalid mime type "${contentType}": does not contain '/'`;
  }
  const withCharset = method === 'PATCH' || /;\s*charset=/i.test(contentType) ? contentType : `${contentType};charset=UTF-8`;
  return `Content-Type '${withCharset}' is not supported`;
};

/**
 * The body of a route, a JSON object, like the @RequestBody of JHipster Spring Boot: the @Body() of Nest, and its route
 * refuses another content type (415) and a request without a body (400). A body that is not an object (a text) is a
 * @Body() of Nest.
 */
export const JsonBody =
  (): ParameterDecorator =>
  (target, key, index): void => {
    Body()(target, key, index);
    if (key !== undefined) {
      JsonBodyRoute()(target, key, Object.getOwnPropertyDescriptor(target, key)!);
    }
  };

/** What a route handler reads as its body: a JSON object, a form, or neither. */
type BodyKind = 'json' | 'form' | undefined;

/**
 * Refuses the body of another content type than JSON of a route that reads an object (@JsonBody()), like JHipster Spring
 * Boot: 415, and 400 without a body. A route of a form (@FormBody()) logs nobody in with another body, like the formLogin of Spring Security:
 * 401. Its place is after the guards, the authorization of the route (and the CSRF check of the login) first, and before the
 * validation.
 */
@Injectable()
export class JsonBodyInterceptor implements NestInterceptor {
  constructor(private readonly reflector: Reflector) {}

  intercept(context: ExecutionContext, next: CallHandler): Observable<unknown> {
    const kind = context.getType() === 'http' ? this.bodyKind(context) : undefined;
    if (kind === 'form' && !context.switchToHttp().getRequest<Request>().is('application/x-www-form-urlencoded')) {
      throw new UnauthorizedException();
    }
    if (kind === 'json') {
      const { headers, method } = context.switchToHttp().getRequest<Request>();
      const contentType = headers['content-type'];
      const hasBody = headers['transfer-encoding'] !== undefined || Number(headers['content-length'] ?? 0) > 0;
      // A body without content type is of an unknown one.
      if (contentType === undefined ? hasBody : !JSON_TYPE.test(contentType.split(';')[0].trim())) {
        throw new UnsupportedMediaTypeException(unsupportedDetail(contentType ?? 'application/octet-stream', method));
      }
      if (!hasBody) {
        throw unreadableBodyException();
      }
    }
    return next.handle();
  }

  private bodyKind(context: ExecutionContext): BodyKind {
    const handler = context.getHandler();
    if (this.reflector.get(FormBody, handler)) {
      return 'form';
    }
    return this.reflector.get(JsonBodyRoute, handler) ? 'json' : undefined;
  }
}
