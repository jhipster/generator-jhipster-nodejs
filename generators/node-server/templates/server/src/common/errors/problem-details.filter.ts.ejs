import { STATUS_CODES } from 'http';

import { ArgumentsHost, Catch, ExceptionFilter, HttpException, HttpStatus, Injectable, Logger, NotFoundException } from '@nestjs/common';
import { HttpAdapterHost } from '@nestjs/core';
import { Request, Response } from 'express';

import { HeaderUtil } from '../header-util.ts';

import { DataIntegrityViolationException, isDataIntegrityViolation } from './data-integrity.ts';
import { DEFAULT_TYPE } from './error-constants.ts';
import { BadRequestAlertException, ProblemException } from './problem.exception.ts';
import { routeMethods } from './route-methods.ts';

/**
 * Answers the errors as the problem details (RFC 9457, application/problem+json) of JHipster Spring Boot, which the
 * JHipster clients read: the type of the problem, the translation key of the error (message), the path of the request
 * (path, and instance, the member of the RFC) and the errors of the fields. The title is the text of the status, the
 * validation and the account apart, like the one of JHipster Spring Boot. An unexpected error is logged, and answered
 * without its message; a violation of the integrity of the database is a bad request. A path whose routes are of
 * other methods answers 405 with the Allow header (RFC 9110), and its OPTIONS the methods alone, like JHipster Spring Boot.
 */
@Catch()
@Injectable()
export class ProblemDetailsFilter implements ExceptionFilter {
  private readonly logger = new Logger(ProblemDetailsFilter.name);

  constructor(
    private readonly headerUtil: HeaderUtil,
    /** The HTTP server of the application, the methods of the routes of a path read from its router. */
    private readonly adapterHost: HttpAdapterHost,
  ) {}

  catch(thrown: unknown, host: ArgumentsHost): void {
    const http = host.switchToHttp();
    const request = http.getRequest<Request>();
    const response = http.getResponse<Response>();
    // The path of the request, not the one left of it by a middleware answering before the routes.
    const path = request.originalUrl.split('?')[0];
    const methods = !response.headersSent && isWithoutRoute(thrown, request) ? routeMethods(this.adapterHost, path) : [];
    if (methods.length > 0 && request.method === 'OPTIONS') {
      // A GET route answers HEAD too.
      const allowed = [...methods, ...(methods.includes('GET') ? ['HEAD'] : []), 'OPTIONS'];
      response.status(HttpStatus.OK).setHeader('Allow', allowed.join(',')).end();
      return;
    }
    if (methods.length > 0) {
      response.setHeader('Allow', methods.join(', '));
    }
    const exception = methods.length > 0 ? methodNotAllowed(request) : isDataIntegrityViolation(thrown) ? new DataIntegrityViolationException() : thrown;
    const status = exception instanceof HttpException ? exception.getStatus() : HttpStatus.INTERNAL_SERVER_ERROR;
    if (!(exception instanceof HttpException)) {
      this.logger.error(`${request.method} ${request.originalUrl}`, exception instanceof Error ? exception.stack : String(exception));
    }
    if (response.headersSent) {
      return;
    }
    if (exception instanceof BadRequestAlertException) {
      // Like the ExceptionTranslator of JHipster Spring Boot, the alert headers the JHipster clients read first.
      this.headerUtil.addFailureAlertHeaders(response, exception.entityName, exception.errorKey);
    }
    response
      .status(status)
      .type('application/problem+json')
      .json({
        type: DEFAULT_TYPE,
        title: STATUS_CODES[status],
        status,
        detail: exception instanceof HttpException ? detailOf(exception, request) : undefined,
        instance: path,
        message: `error.http.${status}`,
        path,
        ...(exception instanceof ProblemException ? exception.problem : {}),
      });
  }
}

/**
 * The message of an HttpException of Nest: the string it was created with, or the message of its response body. A path
 * without route answers its status text, like JHipster Spring Boot, instead of the message of the router.
 */
const detailOf = (exception: HttpException, request: Request): string | undefined => {
  if (exception instanceof ProblemException) {
    return exception.problem.detail;
  }
  if (exception.cause instanceof SyntaxError) {
    // Malformed JSON, which the body parser of Express refuses: like JHipster Spring Boot, without the message of the parser.
    return 'Failed to read request';
  }
  if (isWithoutRoute(exception, request)) {
    return STATUS_CODES[exception.getStatus()];
  }
  const body = exception.getResponse();
  if (typeof body === 'string') {
    return body;
  }
  const { message } = body as { message?: string | string[] };
  return Array.isArray(message) ? message.join(', ') : message;
};

/** The error of the router of Nest for a request no route answers. */
const isWithoutRoute = (exception: unknown, request: Request): boolean =>
  exception instanceof NotFoundException && exception.message === `Cannot ${request.method} ${request.originalUrl}`;

/** The error of a method the routes of the path do not have. */
const methodNotAllowed = (request: Request): HttpException =>
  new HttpException(`Request method '${request.method}' is not supported`, HttpStatus.METHOD_NOT_ALLOWED);
