import { STATUS_CODES } from 'http';

import { ArgumentsHost, Catch, ExceptionFilter, HttpException, HttpStatus, Logger } from '@nestjs/common';
import { Request, Response } from 'express';

import { HeaderUtil } from '../header-util.ts';

import { DEFAULT_TYPE } from './error-constants.ts';
import { BadRequestAlertException, ProblemException } from './problem.exception.ts';

/**
 * Answers the errors as the problem details (RFC 9457, application/problem+json) of JHipster Spring Boot, which the
 * JHipster clients read: the type of the problem, the translation key of the error (message), the path of the request
 * and the errors of the fields. An unexpected error is logged, and answered without its message.
 */
@Catch()
export class ProblemDetailsFilter implements ExceptionFilter {
  private readonly logger = new Logger('ProblemDetailsFilter');

  constructor(private readonly headerUtil: HeaderUtil) {}

  catch(exception: unknown, host: ArgumentsHost): void {
    const http = host.switchToHttp();
    const request = http.getRequest<Request>();
    const response = http.getResponse<Response>();
    const status = exception instanceof HttpException ? exception.getStatus() : HttpStatus.INTERNAL_SERVER_ERROR;
    if (!(exception instanceof HttpException)) {
      this.logger.error(`${request.method} ${request.originalUrl}`, exception instanceof Error ? exception.stack : String(exception));
    }
    if (response.headersSent) {
      return;
    }
    if (exception instanceof BadRequestAlertException) {
      // Like the ExceptionTranslator of JHipster Spring Boot, the alert headers the JHipster clients read first.
      this.headerUtil.addFailureAlertHeaders(response, exception.entityName, exception.errorKey);
    }
    response
      .status(status)
      .type('application/problem+json')
      .json({
        type: DEFAULT_TYPE,
        title: STATUS_CODES[status],
        status,
        detail: exception instanceof HttpException ? detailOf(exception) : undefined,
        message: `error.http.${status}`,
        path: request.path,
        ...(exception instanceof ProblemException ? exception.problem : {}),
      });
  }
}

/** The message of an HttpException of Nest: the string it was created with, or the message of its response body. */
const detailOf = (exception: HttpException): string | undefined => {
  if (exception instanceof ProblemException) {
    return exception.problem.detail;
  }
  const body = exception.getResponse();
  if (typeof body === 'string') {
    return body;
  }
  const { message } = body as { message?: string | string[] };
  return Array.isArray(message) ? message.join(', ') : message;
};
