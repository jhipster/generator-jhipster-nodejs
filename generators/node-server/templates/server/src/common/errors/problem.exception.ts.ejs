import { BadRequestException, HttpException, HttpStatus, ValidationError } from '@nestjs/common';

import { CONSTRAINT_VIOLATION_TYPE, DEFAULT_TYPE, ERR_VALIDATION<%- generateUserManagement ? ', EMAIL_ALREADY_USED_TYPE, INVALID_PASSWORD_TYPE, LOGIN_ALREADY_USED_TYPE' : '' %> } from './error-constants.ts';

/** An error of a field, like the FieldErrorVM of JHipster Spring Boot. */
export interface FieldErrorVM {
  objectName: string;
  field: string;
  message: string;
}

/** The properties of a problem detail the exception gives, the others are completed by the ProblemDetailsFilter. */
export interface ProblemProperties {
  type?: string;
  title?: string;
  detail?: string;
  /** The translation key of the error. */
  message?: string;
  /** The parameter of the translation, the entity name. */
  params?: string;
  fieldErrors?: FieldErrorVM[];
}

/** An exception answered as the problem detail it gives. */
export class ProblemException extends HttpException {
  constructor(
    status: number,
    readonly problem: ProblemProperties,
  ) {
    super(problem, status);
  }
}

/**
 * The errors of the validation of a request body, like the field errors of JHipster Spring Boot: the object (the class
 * of the body without its <%- dtoSuffix %> suffix), the field and the message of the first constraint it fails.
 */
export const toFieldErrors = (errors: ValidationError[], parentPath = ''): FieldErrorVM[] =>
  errors.flatMap(error => {
    const field = `${parentPath}${error.property}`;
    const objectName = (error.target?.constructor.name ?? '').replace(/^./, first => first.toLowerCase()).replace(/<%- dtoSuffix %>$/, '');
    return [
      ...Object.values(error.constraints ?? {})
        .slice(0, 1)
        .map(message => ({ objectName, field, message })),
      ...toFieldErrors(error.children ?? [], `${field}.`),
    ];
  });

/** The validation of a request body failed, like the MethodArgumentNotValidException of Spring. */
export class ValidationException extends ProblemException {
  constructor(errors: ValidationError[]) {
    super(HttpStatus.BAD_REQUEST, {
      type: CONSTRAINT_VIOLATION_TYPE,
      title: 'Method argument not valid',
      message: ERR_VALIDATION,
      fieldErrors: toFieldErrors(errors),
    });
  }
}

/** The validation option of a pattern that tells the type of a value (a date, a time, a duration), not a rule of the entity. */
export const UNREADABLE = { context: { unreadable: true } };

/** The constraints of the type of a value. */
const TYPE_CONSTRAINTS = ['isEnum', 'isInt', 'isNumber', 'isBoolean', 'isUuid', 'isIso8601', 'isString'];

/**
 * Whether a value is of another type than its property: one a JSON deserializer refuses before any validation, like
 * Jackson in JHipster Spring Boot. A number out of its rules (a decimal for an integer) is a validation error.
 */
const isUnreadable = ({ value, constraints = {}, contexts = {}, children = [] }: ValidationError): boolean => {
  if (value === undefined || value === null) {
    return false;
  }
  const failed = Object.keys(constraints);
  return (
    (typeof value !== 'number' && failed.some(constraint => TYPE_CONSTRAINTS.includes(constraint))) ||
    failed.some(constraint => (contexts[constraint] as { unreadable?: boolean } | undefined)?.unreadable) ||
    (typeof value === 'object' && failed.length > 0 && children.length === 0) ||
    children.some(isUnreadable)
  );
};

/** A request body that is not read: not an object, or a value of another type than its property. */
export const unreadableBodyException = (): BadRequestException => new BadRequestException('Failed to read request');

/**
 * The exception of the errors of a request body, like JHipster Spring Boot: a value of another type is a body that is
 * not read (error.http.400, without the errors of the fields), else the errors of the validation of its fields.
 */
export const validationException = (errors: ValidationError[]): HttpException =>
  errors.some(isUnreadable) ? unreadableBodyException() : new ValidationException(errors);

/**
 * A bad request of an entity, like the BadRequestAlertException of JHipster Spring Boot: the translation key of the error
 * and its parameter tell it to the clients, its default message stays out of the response.
 */
export class BadRequestAlertException extends ProblemException {
  constructor(
    readonly defaultMessage: string,
    readonly entityName: string,
    readonly errorKey: string,
    type = DEFAULT_TYPE,
  ) {
    super(HttpStatus.BAD_REQUEST, { type, message: `error.${errorKey}`, params: entityName });
  }
}
<%_ if (generateUserManagement) { _%>

export class LoginAlreadyUsedException extends BadRequestAlertException {
  constructor() {
    super('Login name already used!', 'userManagement', 'userexists', LOGIN_ALREADY_USED_TYPE);
  }
}

export class EmailAlreadyUsedException extends BadRequestAlertException {
  constructor() {
    super('Email is already in use!', 'userManagement', 'emailexists', EMAIL_ALREADY_USED_TYPE);
  }
}

export class InvalidPasswordException extends ProblemException {
  constructor() {
    super(HttpStatus.BAD_REQUEST, { type: INVALID_PASSWORD_TYPE, detail: 'Incorrect password' });
  }
}

/** A request of an account no user answers, like the AccountResourceException of JHipster Spring Boot. */
export class AccountResourceException extends ProblemException {
  constructor(detail: string) {
    super(HttpStatus.BAD_REQUEST, { title: 'Account resource request invalid', detail });
  }
}
<%_ } _%>
