import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { Response } from 'express';
import { URL } from 'url';

import type { ApplicationConfig } from '../application-config.ts';
import { Page } from '../domain/base/pagination.entity.ts';

/**
 * The headers of the responses the JHipster clients read, like the HeaderUtil and the PaginationUtil of JHipster Spring
 * Boot: the alerts, named after the application (jhipster.clientApp.name), and the pagination.
 */
@Injectable()
export class HeaderUtil {
  private readonly applicationName: string;

  constructor(configService: ConfigService<ApplicationConfig, true>) {
    this.applicationName = configService.get('jhipster.clientApp.name', { infer: true });
  }

  createAlert(res: Response, message: string, param: string): any {
    res.set(`X-${this.applicationName}-alert`, message);
    res.set(`X-${this.applicationName}-params`, param);
  }

  addEntityCreatedHeaders(res: Response, entityName: string, param: string | number | undefined): any {
    res.status(201);
<%_ if (enableTranslation) { _%>
    // The translation key of the alert, translated by the client.
    this.createAlert(res, `${this.applicationName}.${entityName}.created`, String(param));
<%_ } else { _%>
    this.createAlert(res, `A new ${entityName} is created with identifier ${param}`, String(param));
<%_ } _%>
  }

  addEntityUpdatedHeaders(res: Response, entityName: string, param: string | number | undefined): any {
    res.status(200);
<%_ if (enableTranslation) { _%>
    // The translation key of the alert, translated by the client.
    this.createAlert(res, `${this.applicationName}.${entityName}.updated`, String(param));
<%_ } else { _%>
    this.createAlert(res, `A ${entityName} is updated with identifier ${param}`, String(param));
<%_ } _%>
  }

  addEntityDeletedHeaders(res: Response, entityName: string, param: string | number | undefined): any {
    res.status(204);
<%_ if (enableTranslation) { _%>
    // The translation key of the alert, translated by the client.
    this.createAlert(res, `${this.applicationName}.${entityName}.deleted`, String(param));
<%_ } else { _%>
    this.createAlert(res, `A ${entityName} is deleted with identifier ${param}`, String(param));
<%_ } _%>
  }

  /**
   * Like the failure alert of JHipster Spring Boot (BadRequestAlertException), the status comes from the thrown exception.
   */
  addFailureAlertHeaders(res: Response, entityName: string, errorKey: string): any {
    res.set(`X-${this.applicationName}-error`, `error.${errorKey}`);
    res.set(`X-${this.applicationName}-params`, entityName);
  }

  /**
   * The pagination headers, like the PaginationUtil of JHipster Spring Boot: the total count of the elements, and the
   * links of the next, previous, last and first pages.
   */
  addPaginationHeaders<T>(res: Response, page: Page<T>): any {
    const url = res.req.url;
    res.set('X-Total-Count', page.total.toString());
    const pageNumber = page.pageable.page;
    const pageSize = page.pageable.size;
    const totalPages = Math.ceil(page.total / pageSize);
    const links: string[] = [];
    if (pageNumber < totalPages - 1) {
      links.push(this.prepareLink(url, pageNumber + 1, pageSize, 'next'));
    }
    if (pageNumber > 0) {
      links.push(this.prepareLink(url, pageNumber - 1, pageSize, 'prev'));
    }
    links.push(this.prepareLink(url, Math.max(totalPages - 1, 0), pageSize, 'last'));
    links.push(this.prepareLink(url, 0, pageSize, 'first'));
    res.set('Link', links.join(','));
  }

  private prepareLink(url: string, pageNumber: number, pageSize: number, relType: string): string {
    const link = new URL(`http://localhost${url}`);
    link.searchParams.set('page', String(pageNumber));
    link.searchParams.set('size', String(pageSize));
    return `<${link.toString().replace('http://localhost', '')}>; rel="${relType}"`;
  }
}
