import { describe, expect, it } from 'vitest';

import {
  blobTransformer,
  durationTransformer,
  formatDuration,
  numberTransformer,
  parseDuration,
} from './column-transformers.ts';

describe('column transformers', () => {
  it('should read a bigint or a decimal given as a string as a number', () => {
    expect(numberTransformer.from('25179')).toBe(25179);
    expect(numberTransformer.from('25829.80')).toBe(25829.8);
    expect(numberTransformer.from(null)).toBeNull();
  });

  it('should read a blob given as a Buffer as the string it stored', () => {
    expect(blobTransformer.from(Buffer.from('aGlwc3Rlcg=='))).toBe('aGlwc3Rlcg==');
    expect(blobTransformer.from('aGlwc3Rlcg==')).toBe('aGlwc3Rlcg==');
  });

  it('should store a duration as its nanoseconds and read it back as an ISO-8601 duration', () => {
    expect(durationTransformer.to('PT1H30M')).toBe('5400000000000');
    expect(durationTransformer.from('5400000000000')).toBe('PT1H30M');
    expect(durationTransformer.to(null)).toBeNull();
  });

  it.each([
    ['PT0S', 'PT0S'],
    ['PT90M', 'PT1H30M'],
    ['PT0.5S', 'PT0.5S'],
    ['PT-0.5S', 'PT-0.5S'],
    ['PT-1.5S', 'PT-1.5S'],
    ['P2DT3H', 'PT51H'],
    ['PT-90M', 'PT-1H-30M'],
    ['-PT1H', 'PT-1H'],
    ['PT1.000000001S', 'PT1.000000001S'],
  ])('should format the duration %s as %s, like Duration of Java', (text, formatted) => {
    expect(formatDuration(parseDuration(text))).toBe(formatted);
  });

  it.each(['PT', 'P', 'P1DT', '1H', 'PTXS'])('should refuse %s, not an ISO-8601 duration', text => {
    expect(() => parseDuration(text)).toThrow('is not an ISO-8601 duration');
  });
});
