import "reflect-metadata";
import { describe, expect, it } from 'vitest';
import { PageRequest } from './pagination.entity.ts';

describe('PageRequest', () => {
  it('passing default number parameters', () => {
    const pageRequest = new PageRequest(
      0,
      20,
      'id,ASC',
    );
    expect(pageRequest.page).toBe(0);
    expect(pageRequest.size).toBe(20);
    expect(pageRequest.asOrder()).toMatchObject({ id: 'ASC' });
  });

  it('passing default strings parameters', () => {
    const pageRequest = new PageRequest(
      '0',
      '20',
      'id,ASC',
    );
    expect(pageRequest.page).toBe(0);
    expect(pageRequest.size).toBe(20);
    expect(pageRequest.asOrder()).toMatchObject({ id: 'ASC' });
  });

  it('passing non default strings parameters', () => {
    const pageRequest = new PageRequest(
      '10',
      '30',
      'foo,DESC',
    );
    expect(pageRequest.page).toBe(10);
    expect(pageRequest.size).toBe(30);
    expect(pageRequest.asOrder()).toMatchObject({ foo: 'DESC' });
  });

  it('caps the size like Spring Data, and ignores a negative page or a size below 1', () => {
    expect(new PageRequest(0, 100000).size).toBe(2000);
    const pageRequest = new PageRequest(-1, 0);
    expect(pageRequest.page).toBe(0);
    expect(pageRequest.size).toBe(20);
  });

  it('sorts on several properties, the direction case insensitive and ascending by default', () => {
    const pageRequest = new PageRequest(0, 20, ['name,desc', 'id']);
    expect(pageRequest.asOrder()).toEqual({ name: 'DESC', id: 'ASC' });
  });

  it('sorts on the properties of a relationship', () => {
    const pageRequest = new PageRequest(0, 20, ['region.name,asc', 'region.id,desc']);
    expect(pageRequest.asOrder()).toEqual({ region: { name: 'ASC', id: 'DESC' } });
  });

  it('rejects a property out of the sort properties', () => {
    expect(() => new PageRequest(0, 20, 'password,asc', ['id', 'name'])).toThrow('Invalid sort property: password');
    expect(new PageRequest(0, 20, 'name,asc', ['id', 'name']).asOrder()).toEqual({ name: 'ASC' });
  });

  it('rejects a property the sort check refuses', () => {
    const isSortable = (property: string): boolean => property !== 'password';
    expect(() => new PageRequest(0, 20, 'password,asc', isSortable)).toThrow('Invalid sort property: password');
    expect(new PageRequest(0, 20, 'name,asc', isSortable).asOrder()).toEqual({ name: 'ASC' });
  });
});
