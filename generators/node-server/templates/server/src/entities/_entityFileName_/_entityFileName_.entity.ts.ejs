<%_
// A String id of the JDL (autoGenerate), whose UUID the entity generates like the @GeneratedValue of JHipster Spring Boot:
// the databases generate numbers and uuids only.
const generatedStringId = databaseTypeSql && primaryKey.typeString && primaryKey.autoGenerate;
_%>
<%_ if (generatedStringId) { _%>
import { randomUUID } from 'node:crypto';
<%_ } _%>
import { <%_ if (databaseType === 'mongodb') { _%> ObjectIdColumn <%_ } else if (primaryKey.typeString) { _%> <% if (generatedStringId) { %>BeforeInsert, <% } %>PrimaryColumn <%_ } else { _%> PrimaryGeneratedColumn <%_ } _%>, Entity, Column <%_ if (databaseType !== 'mongodb') { _%>, JoinColumn, OneToOne, ManyToOne, OneToMany, ManyToMany, JoinTable, type Relation <%_ } _%> } from 'typeorm';
import { BaseEntity } from '../../common/database/base.entity.ts';
<%_ if (nodejsCriteria) { _%>
import { Filterable } from '../../common/database/criteria.ts';
<%_ } _%>
<%_ if (nodejsColumnTransformers.length > 0) { _%>
import { <%- nodejsColumnTransformers.map(name => `${name}Transformer`).join(', ') %> } from '../../common/database/column-transformers.ts';
<%_ } _%>
<%_ if (nodejsColumnTypeImports.length > 0) { _%>
import { <%- nodejsColumnTypeImports.join(', ') %> } from '../../common/database/column-types.ts';
<%_ } _%>

<%_
let isUserRelationship = false;
const uniqueEntities = {};
const uniqueEnums = {};

for (idx in fields) {
    if (fields[idx].fieldIsEnum && (
            !uniqueEnums[fields[idx].fieldType] || (uniqueEnums[fields[idx].fieldType] && fields[idx].fieldValues.length !== 0))) {
        uniqueEnums[fields[idx].fieldType] = this._.kebabCase(fields[idx].fieldType);
    }
}
for (idx in relationships) {
    const relationship = relationships[idx];
    const otherEntityClass = relationship.otherEntity.persistClass;
    if (relationship.otherEntity.entityClass === 'User'){
        isUserRelationship = true;
    }
    else if (!uniqueEntities[otherEntityClass] && otherEntityClass != persistClass) {
        uniqueEntities[otherEntityClass] = relationship.otherEntity.nodejsEntityPath;
    }
}
_%>

<%_ Object.keys(uniqueEntities).forEach(function(entityClass) { _%>
import { <%= entityClass %> } from '../../<%= uniqueEntities[entityClass] %>';
<%_ }); _%>
<%_ Object.keys(uniqueEnums).forEach(function(enumClass) { _%>
import { <%= enumClass %> } from '../enumeration/<%= uniqueEnums[enumClass] %>.ts';
<%_ }); _%>

<%_ if (isUserRelationship === true) { _%>
import { <%= user.persistClass %> } from '../../users/user.entity.ts';
<%_ } _%>

<%_ if (typeof javadoc == 'undefined') { _%>
/**
 * A <%= persistClass %>.
 */
<%_ } else { _%>
<%- formatAsClassJavadoc(javadoc) %>
<%_ } _%>
@Entity('<%= entityTableName %>')
export class <%= persistClass %> extends BaseEntity  {

<%_ if (databaseTypeMongodb) { _%>
  @ObjectIdColumn({ name: '_<%- primaryKey.name %>' })
<%_ } else if (databaseTypeSql && primaryKey.typeString) { _%>
  // A varchar, like the String id of the Liquibase changelog of JHipster Spring Boot.
  @PrimaryColumn()
<%_ } else if (databaseTypeSql) { _%>
  @PrimaryGeneratedColumn(<%- primaryKey.typeUUID ? "'uuid'" : '' %>)
<%_ } _%>
<%_ if (nodejsCriteria) { _%>
  <%- nodejsCriteria.decorators[primaryKey.name] %>
<%_ } _%>
  <%- primaryKey.name %>?: <%- primaryKey.tsType %>;
<%_ if (generatedStringId) { _%>

  /** A UUID for a new record, like the @GeneratedValue of the String id of JHipster Spring Boot. */
  @BeforeInsert()
  generate<%- primaryKey.nameCapitalized %>(): void {
    this.<%- primaryKey.name %> ??= randomUUID();
  }
<%_ } _%>

<%_ for (const field of fields.filter(field => !field.id)) {
    if (typeof field.javadoc !== 'undefined') { _%>
<%- formatAsFieldJavadoc(field.javadoc) %>
    <%_ }
    const { fieldType, fieldTypeBlobContent, fieldName } = field; _%>
    @Column({ <%- field.nodejsColumnOptions.join(', ') %> })
    <%_ if (nodejsCriteria?.decorators[fieldName]) { _%>
    <%- nodejsCriteria.decorators[fieldName] %>
    <%_ } _%>
    <%= fieldName %><%- field.fieldValidationRequired ? '!' : '?' %>: <%= field.nodejsFieldType %>;

    <%_ if ((fieldType === 'byte[]' || fieldType === 'ByteBuffer') && fieldTypeBlobContent !== 'text') { _%>
    @Column({ <%- field.nodejsContentTypeColumnOptions.join(', ') %> })
    <%= fieldName %>ContentType<%- field.fieldValidationRequired ? '!' : '?' %>: string;
    <%_ }
    } _%>

    <%_ for (const relationship of relationships) {
        const { otherEntityRelationshipName, otherEntityRelationshipNamePlural, relationshipFieldName, relationshipFieldNamePlural, ownerSide, otherEntityUser } = relationship;
        const otherEntityClass = relationship.otherEntity.persistClass;
        if (relationship.relationshipOneToMany) { _%>
    @OneToMany(() => <%= otherEntityClass %> <%_ if (!otherEntityUser) { _%>, other => other.<%= otherEntityRelationshipName %><%_ } _%>)
    <%= relationshipFieldNamePlural %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>[]>;

    <%_ } else if (relationship.relationshipManyToOne) { _%>
    @ManyToOne(() => <%= otherEntityClass %> <%_ if (!ownerSide && !otherEntityUser) { _%>, other => other.<%= otherEntityRelationshipNamePlural %>  <%_ } _%><% if (relationship.columnRequired) { %>, { nullable: false }<% } %>)
    <%_ if (nodejsCriteria?.decorators[relationshipFieldName]) { _%>
    <%- nodejsCriteria.decorators[relationshipFieldName] %>
    <%_ } _%>
    <%= relationshipFieldName %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>>;

    <%_ } else if (relationship.relationshipManyToMany) { _%>
    @ManyToMany(() => <%= otherEntityClass %> )
        <%_ if (relationship.nodejsJoinTable) { _%>
    @JoinTable({
        name: '<%= relationship.nodejsJoinTable.name %>',
        joinColumn: { name: '<%= relationship.nodejsJoinTable.joinColumn.name %>', referencedColumnName: '<%= relationship.nodejsJoinTable.joinColumn.referencedColumnName %>' },
        inverseJoinColumn: { name: '<%= relationship.nodejsJoinTable.inverseJoinColumn.name %>', referencedColumnName: '<%= relationship.nodejsJoinTable.inverseJoinColumn.referencedColumnName %>' }
    })
        <%_ } _%>
    <%= relationshipFieldNamePlural %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>[]>;

    <%_ } else { _%>
    <%_ if (ownerSide) { _%>
    @OneToOne(() => <%= otherEntityClass %><% if (relationship.columnRequired) { %>, { nullable: false }<% } %>)
    @JoinColumn()
    <%_ } else { _%>
    @OneToOne(() => <%= otherEntityClass %>, other => other.<%= otherEntityRelationshipName %>)
    <%_ } _%>
    <%_ if (nodejsCriteria?.decorators[relationshipFieldName]) { _%>
    <%- nodejsCriteria.decorators[relationshipFieldName] %>
    <%_ } _%>
    <%= relationshipFieldName %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>>;

    <%_ }
    } _%>
    // jhipster-needle-entity-add-field - JHipster will add fields here, do not remove

}
