<%_
// The relationships the other entity owns (its join column or its join table), like the mappedBy side of JHipster
// Spring Boot: never stored from this entity.
const inverseProperties = relationships
  .filter(relationship => !relationship.ownerSide && ['one-to-many', 'one-to-one', 'many-to-many'].includes(relationship.relationshipType))
  .map(relationship => relationship.propertyName);
_%>
import { <%= persistClass %> } from '../../domain/<%= entityFileName %>.entity.ts';
import { <%= dtoClass %> } from '../dto/<%= entityFileName %>.dto.ts';


/**
 * A <%= entityClass %> mapper object.
 */
export class <%= entityClass %>Mapper {

  static fromDTOtoEntity(entityDTO: <%= dtoClass %>): <%= persistClass %>;
  static fromDTOtoEntity(entityDTO: <%= dtoClass %> | null | undefined): <%= persistClass %> | undefined;
  static fromDTOtoEntity(entityDTO: <%= dtoClass %> | null | undefined): <%= persistClass %> | undefined {
    if (!entityDTO) {
      return undefined;
    }
<%_ if (inverseProperties.length > 0) { _%>
    // The relationships the other entity owns are not stored from this one.
    const { <%- inverseProperties.map(property => `${property}: _${property}`).join(', ') %>, ...fields } = entityDTO;
    return Object.assign(new <%= persistClass %>(), fields);
<%_ } else { _%>
    return Object.assign(new <%= persistClass %>(), entityDTO);
<%_ } _%>
  }

  static fromEntityToDTO(entity: <%= persistClass %>): <%= dtoClass %>;
  static fromEntityToDTO(entity: <%= persistClass %> | null | undefined): <%= dtoClass %> | undefined;
  static fromEntityToDTO(entity: <%= persistClass %> | null | undefined): <%= dtoClass %> | undefined {
    if (!entity) {
      return undefined;
    }
    return Object.assign(new <%= dtoClass %>(), entity);
  }
}
