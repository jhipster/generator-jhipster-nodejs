import { Injectable, <%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%> HttpException, HttpStatus, InternalServerErrorException, <%_ } _%> Logger } from '@nestjs/common';
<%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
import { randomBytes } from 'crypto';
<%_ } _%>
<%_ if (generateBuiltInAuthorityEntity) { _%>
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
<%_ } _%>
<%_ if (generateBuiltInUserEntity) { _%>
import { FindManyOptions } from 'typeorm';
<%_ } _%>
<%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
import { comparePassword } from '../security/password-util';
import { JwtService } from '@nestjs/jwt';
import { UserLoginDTO } from '../service/dto/user-login.dto';
import { Payload } from '../security/payload.interface';
<%_ } _%>
<%_ if (generateBuiltInAuthorityEntity) { _%>
import { Authority } from '../domain/authority.entity';
<%_ } _%>
<%_ if (generateBuiltInUserEntity) { _%>
import { UserService } from '../service/user.service';
<%_ } _%>
import { <%= userLoginVmClass %> } from './dto/user.dto';
<%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
import { ConfigService } from '@nestjs/config';
<%_ } _%>

<%_
const userIdType = user?.primaryKey.tsType;
_%>


@Injectable()
export class AuthService {
    logger = new Logger('AuthService');
  constructor(
    <%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
    private readonly jwtService: JwtService,
    private readonly configService: ConfigService,
    <%_ } _%>
    <%_ if (generateBuiltInAuthorityEntity) { _%>
    @InjectRepository(Authority) private authorityRepository: Repository<Authority>,
    <%_ } _%>
    <%_ if (generateBuiltInUserEntity) { _%>
    private userService: UserService,
    <%_ } _%>
  ) {}

  <%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
  async login(userLogin: UserLoginDTO): Promise<any> {
    const loginUserName = userLogin.username;
    const loginPassword = userLogin.password;
    if (!loginUserName || !loginPassword) {
      throw new HttpException('Username and password are required!', HttpStatus.BAD_REQUEST);
    }

    const userFind = await this.userService.findByFields({ where: { login: loginUserName } });
    const validPassword = !!userFind && comparePassword(loginPassword, userFind.password);
    if (!userFind || !validPassword) {
      throw new HttpException('Invalid login name or password!', HttpStatus.UNAUTHORIZED);
    }

    if (userFind && !userFind.activated) {
      throw new HttpException('Your account is not been activated!', HttpStatus.UNAUTHORIZED);
    }

    const user = await this.findUserWithAuthById(userFind.id!);
    if (!user) {
      throw new HttpException('Invalid login name or password!', HttpStatus.UNAUTHORIZED);
    }

    const payload: Payload = { sub: user.login, auth: (user.authorities ?? []).join(' '), userId: user.id };

    const expiresIn = Number(
      userLogin.rememberMe
        ? this.configService.getOrThrow('jhipster.security.authentication.jwt.token-validity-in-seconds-for-remember-me')
        : this.configService.getOrThrow('jhipster.security.authentication.jwt.token-validity-in-seconds'),
    );
    return {
      id_token: this.jwtService.sign(payload, { expiresIn }),
    };
  }

  async validateUser(payload: Payload): Promise<<%= user.dtoClass %> | undefined> {
    // The user of the token subject, like the login of JHipster Spring Boot tokens.
    return await this.userService.findByFields({ where: { login: payload.sub } });
  }

  async findUserWithAuthById(userId: <%= userIdType %>): Promise<<%= user.dtoClass %> | undefined> {
    <%_ if (databaseType === 'mongodb') { _%>
    const userDTO = await this.userService.findById(userId);
    <%_ } else { _%>
    const userDTO = await this.userService.findByFields({ where: { id: userId } });
    <%_ } _%>
    return userDTO;
  }

  async getAccount(userId: <%= userIdType %>): Promise<<%= user.dtoClass %> | undefined> {
    const userDTO = await this.findUserWithAuthById(userId);
    if (!userDTO) {
      return;
    }
    return userDTO;
  }

  async changePassword(userLogin: string, currentClearTextPassword: string, newPassword: string): Promise<void> {
    const userFind = await this.userService.findByFields({ where: { login: userLogin } });
    if (!userFind) {
      throw new HttpException('Invalid login name!', HttpStatus.BAD_REQUEST);
    }

    if (!comparePassword(currentClearTextPassword, userFind.password)) {
      throw new HttpException('Invalid password!', HttpStatus.BAD_REQUEST);
    }
    userFind.password = newPassword;
    await this.userService.save(userFind, userLogin, true);
    return;
  }

  /**
   * Like JHipster Spring Boot, gives a reset key, valid one day, to the activated user of the mail: the user returned
   * is the one the mail with the key is for, undefined for another mail.
   */
  async requestPasswordReset(mail: string): Promise<<%= user.dtoClass %> | undefined> {
    const userFind = await this.userService.findByFields({ where: { email: mail.trim().toLowerCase() } });
    if (!userFind?.activated) {
      return undefined;
    }
    userFind.resetKey = randomBytes(15).toString('base64url');
    userFind.resetDate = new Date();
    return this.userService.save(userFind, userFind.login);
  }

  /** Like JHipster Spring Boot, sets the new password of the user of a reset key given less than one day ago. */
  async completePasswordReset(newPassword: string, key: string): Promise<void> {
    const userFind = await this.userService.findByFields({ where: { resetKey: key } });
    if (!userFind?.resetDate || new Date(userFind.resetDate).getTime() < Date.now() - 24 * 60 * 60 * 1000) {
      throw new InternalServerErrorException('No user was found for this reset key');
    }
    userFind.password = newPassword;
    // null clears the columns (TypeORM leaves the undefined properties unchanged).
    Object.assign(userFind, { resetKey: null, resetDate: null });
    await this.userService.save(userFind, userFind.login, true);
  }

  async registerNewUser (newUser: <%= user.dtoClass %>) : Promise<<%= user.dtoClass %>> {
    let userFind = await this.userService.findByFields({ where: { login: newUser.login} });
    if (userFind) {
      throw new HttpException('Login name already used!', HttpStatus.BAD_REQUEST);
    }
    userFind = await this.userService.findByFields({ where: { email: newUser.email } });
    if (userFind) {
      throw new HttpException('Email is already in use!', HttpStatus.BAD_REQUEST);
    }
    newUser.authorities = ['ROLE_USER'];
    const user = await this.userService.save(newUser, newUser.login, true);
    return user;
  }

  async updateUserSettings(userLogin: string, newUserInfo: <%= user.dtoClass %>) : Promise<<%= user.dtoClass %>> {
    const userFind = await this.userService.findByFields({ where: { login: userLogin } });
    if (!userFind) {
      throw new HttpException('Invalid login name!', HttpStatus.BAD_REQUEST);
    }
    const userFindEmail = await this.userService.findByFields({ where: { email: newUserInfo.email } });
    if (userFindEmail && newUserInfo.email !== userFind.email) {
      throw new HttpException('Email is already in use!', HttpStatus.BAD_REQUEST);
    }

    userFind.firstName = newUserInfo.firstName;
    userFind.lastName = newUserInfo.lastName;
    userFind.email = newUserInfo.email;
    userFind.langKey = newUserInfo.langKey;
    await this.userService.save(userFind, userLogin);
    return userFind;
  }

  <%_ } else if (authenticationType === 'oauth2') { _%>
    <%_ if (generateBuiltInUserEntity) { _%>
    async findUserOrSave(loginUser: <%= userLoginVmClass %>): Promise<<%= userLoginVmClass %> | undefined> {
        if (loginUser.login && loginUser.password && !loginUser.email) {
            loginUser.email = loginUser.login + '@localhost.it';
        }
        const userFound = await this.userService.findByFields({ where: { login: loginUser.login } });

        if (!userFound) {
          const authoritiesName: { name: string }[] = [];
          loginUser.authorities?.forEach(authority => authoritiesName.push({ name: authority }));
          await this.userService.save({ ...loginUser, authorities: authoritiesName }, loginUser.login);
        }
        return loginUser;
      }
    <%_ } _%>

   getAccount(userDTO: <%= userLoginVmClass %>): any {
    if (!userDTO) {
       return;
    }
    return userDTO;
   }

  <%_ } _%>

  <%_ if (generateBuiltInUserEntity) { _%>
  async getAllUsers(options: FindManyOptions<<%= user.dtoClass %>>): Promise<[<%= user.dtoClass %>[], number]> {
    return await this.userService.findAndCount(options);
  }
  <%_ } _%>
}
