import { hostname } from 'os';

import { BeforeApplicationShutdown, Injectable, Logger } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import Consul from 'consul';

import type { ApplicationConfig } from '../application-config.ts';
import { activeProfiles } from '../config.ts';

/**
 * The registration of the application in Consul, like Spring Cloud Consul: the service of cloud.consul.discovery with
 * the HTTP health check of the application, registered once it listens and deregistered when it stops, so a gateway
 * routes to it while it answers only.
 */
@Injectable()
export class ConsulService implements BeforeApplicationShutdown {
  private readonly logger = new Logger('ConsulService');

  constructor(private readonly configService: ConfigService<ApplicationConfig, true>) {}
  private consul?: Consul;
  private serviceId?: string;

  /** Registers the application listening on the port, when cloud.consul.enabled. */
  async register(port: number): Promise<void> {
    const { enabled, host, port: consulPort, discovery } = this.configService.get('cloud.consul', { infer: true });
    if (!enabled) {
      return;
    }
    const consul = new Consul({ host, port: Number(consulPort) });
    const name = discovery['service-name'];
    const id = discovery['instance-id'];
    const address = discovery['prefer-ip-address'] ? this.configService.get('ipAddress', { infer: true }) || '127.0.0.1' : hostname();
    this.logger.log(`Registering ${name} with Consul at ${host}:${consulPort}`);
    try {
      await consul.agent.service.register({
        name,
        id,
        address,
        port,
        tags: [`profile=${activeProfiles.join(',')}`],
        check: {
          name: `Service '${name}' check`,
          http: `http://${address}:${port}${discovery['health-check-path']}`,
          interval: discovery['health-check-interval'],
          timeout: discovery['health-check-timeout'],
        },
      });
      this.consul = consul;
      this.serviceId = id;
      this.logger.log('Consul registration complete');
    } catch (error) {
      this.logger.error(`Consul registration failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /** Deregisters the application before the server stops, so a gateway no longer routes to it. */
  async beforeApplicationShutdown(): Promise<void> {
    const { consul, serviceId } = this;
    if (!consul || !serviceId) {
      return;
    }
    this.consul = undefined;
    try {
      await consul.agent.service.deregister(serviceId);
      this.logger.log('Consul deregistration complete');
    } catch (error) {
      this.logger.warn(`Consul deregistration failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }
}
