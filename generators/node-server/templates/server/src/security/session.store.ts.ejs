import { Injectable, Logger, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import session from 'express-session';
import { <% if (databaseTypeSql) { %>LessThan, <% } %>Repository } from 'typeorm';
import { Session } from '../domain/session.entity.ts';
import { SESSION_MAX_AGE } from './csrf.middleware.ts';

/** The interval of the removal of the expired sessions. */
export const PRUNE_INTERVAL = 60 * 60 * 1000;

type Callback<T = unknown> = (error?: any, value?: T) => void;

/** A session of a user, its id and its data. */
export interface StoredSession {
  sid: string;
  data: session.SessionData & Record<string, any>;
}

/**
 * The sessions of the server in the database of the application, the store of express-session: a session outlives a
 * restart of the application and is shared by its instances, unlike the MemoryStore of express-session, and the expired
 * sessions are removed every hour.
 */
@Injectable()
export class SessionStore extends session.Store implements OnModuleInit, OnModuleDestroy {
  private readonly logger = new Logger('SessionStore');
  private pruneTimer?: NodeJS.Timeout;

  constructor(@InjectRepository(Session) private readonly repository: Repository<Session>) {
    super();
  }

  onModuleInit(): void {
    this.pruneTimer = setInterval(() => {
      this.prune().catch((error: Error) => this.logger.warn(`The expired sessions could not be removed: ${error.message}`));
    }, PRUNE_INTERVAL);
    // The removal does not keep the process alive.
    this.pruneTimer.unref();
  }

  onModuleDestroy(): void {
    clearInterval(this.pruneTimer);
  }

  get(sid: string, callback: Callback<session.SessionData | null>): void {
    this.repository.findOne({ where: { sid } }).then(
      found => callback(null, found && found.expires.getTime() > Date.now() ? JSON.parse(found.data) : null),
      callback,
    );
  }

  set(sid: string, data: session.SessionData, callback?: Callback): void {
    this.save(sid, data).then(() => callback?.(), error => callback?.(error));
  }

  touch(sid: string, data: session.SessionData, callback?: Callback): void {
    // The rolling expiry of a session its request did not change.
    this.repository.update({ sid }, { expires: expiresOf(data) }).then(() => callback?.(), error => callback?.(error));
  }

  destroy(sid: string, callback?: Callback): void {
    this.repository.delete({ sid }).then(() => callback?.(), error => callback?.(error));
  }

  all(callback: Callback<Record<string, session.SessionData>>): void {
    this.repository.find().then(
      sessions => callback(null, Object.fromEntries(alive(sessions).map(({ sid, data }) => [sid, data]))),
      callback,
    );
  }

  /** The sessions of a user, not expired. */
  async sessionsOf(login: string): Promise<StoredSession[]> {
    return alive(await this.repository.find({ where: { login } }));
  }

  /** Removes the expired sessions. */
  async prune(): Promise<void> {
<%_ if (databaseTypeSql) { _%>
    await this.repository.delete({ expires: LessThan(new Date()) });
<%_ } else { _%>
    await this.repository.delete({ expires: { $lt: new Date() } } as any);
<%_ } _%>
  }

  private async save(sid: string, data: session.SessionData): Promise<void> {
    const found = await this.repository.findOne({ where: { sid } });
    await this.repository.save({ ...found, sid, login: (data as any).user?.login ?? null, expires: expiresOf(data), data: JSON.stringify(data) });
  }
}

/** The end of a session: the expiry of its cookie. */
function expiresOf(data: session.SessionData): Date {
  return data.cookie?.expires ? new Date(data.cookie.expires) : new Date(Date.now() + SESSION_MAX_AGE);
}

/** The sessions not expired, with their data. */
function alive(sessions: Session[]): StoredSession[] {
  const now = Date.now();
  return sessions.filter(stored => stored.expires.getTime() > now).map(({ sid, data }) => ({ sid, data: JSON.parse(data) }));
}
