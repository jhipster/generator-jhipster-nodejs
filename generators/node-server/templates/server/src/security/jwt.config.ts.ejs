import { ConfigService } from '@nestjs/config';

/**
 * The algorithm and the key of the JWTs, like JHipster Spring Boot: HS512, with the base64 decoded
 * `jhipster.security.authentication.jwt.base64-secret` as the key, so the applications of a microservice architecture
 * sharing that secret (a Spring Boot gateway and NodeJS microservices, or the reverse) accept each other's tokens.
 */
export const JWT_ALGORITHM = 'HS512';

export function jwtSecretKey(configService: ConfigService): Buffer {
  const secret = configService.getOrThrow<string>('jhipster.security.authentication.jwt.base64-secret');
  if (!secret) {
    // Like JHipster Spring Boot, the application does not start without a secret: the secret-samples profile has a
    // sample for development, production sets its own.
    throw new Error(
      'jhipster.security.authentication.jwt.base64-secret is not set: set the JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64SECRET environment variable, or activate the secret-samples profile',
    );
  }
  return Buffer.from(secret, 'base64');
}
