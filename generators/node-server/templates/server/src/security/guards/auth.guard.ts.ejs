<%_ if (authenticationType === 'oauth2') { _%>
import { ExecutionContext, Injectable, UnauthorizedException } from '@nestjs/common';
import { AuthGuard as NestAuthGuard } from '@nestjs/passport';

/**
 * The authentication of the API, like JHipster Spring Boot with OAuth2: the session of the login (the clients of the
 * application, their unsafe requests checked by the CsrfMiddleware), else an access token of the identity provider as
 * bearer token (oauth2ResourceServer), else 401.
 */
@Injectable()
export class AuthGuard extends NestAuthGuard('oauth2-bearer') {
  canActivate(context: ExecutionContext): any {
    const request = context.switchToHttp().getRequest();

    if (request.session?.user) {
      request.user = request.session.user;
      return true;
    }
    // The authentication scheme is case insensitive, like HTTP gives it.
    if (!/^bearer\s+\S/i.test(request.headers.authorization ?? '')) {
      throw new UnauthorizedException();
    }
    return super.canActivate(context);
  }
}
<%_ } else if (authenticationTypeSession) { _%>
import { CanActivate, ExecutionContext, Injectable, UnauthorizedException } from '@nestjs/common';

/**
 * The authentication of the API, like JHipster Spring Boot with sessions: the user of the session of the login (its unsafe
 * requests checked by the CsrfMiddleware), else 401.
 */
@Injectable()
export class AuthGuard implements CanActivate {
  canActivate(context: ExecutionContext): boolean {
    const request = context.switchToHttp().getRequest();
    if (!request.session?.user) {
      throw new UnauthorizedException();
    }
    request.user = request.session.user;
    return true;
  }
}
<%_ } else { _%>
import { Injectable } from '@nestjs/common';
import { AuthGuard as NestAuthGuard } from '@nestjs/passport';

@Injectable()
export class AuthGuard extends NestAuthGuard('<%= authenticationType %>') {}
<%_ } _%>
