import { Module } from '@nestjs/common';
import { ConfigModule, ConfigService } from '@nestjs/config';
import { APP_INTERCEPTOR } from '@nestjs/core';
import { TypeOrmModule } from '@nestjs/typeorm';
<%_ if (generateUserManagement) { _%>
import { ScheduleModule } from '@nestjs/schedule';
<%_ } _%>
import { AuthModule } from './module/auth.module.ts';
import { CommonModule } from './module/common.module.ts';
import { HealthModule } from './module/health.module.ts';
import { ManagementModule } from './module/management.module.ts';
import { ormConfig } from './orm.config.ts';
import { configuration } from './config.ts';
import { LoggingInterceptor } from './common/interceptors/logging.interceptor.ts';
<%_ if (serviceDiscoveryEureka) { _%>
import { EurekaService } from './service/eureka.service.ts';
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
import { ConsulService } from './service/consul.service.ts';
<%_ } _%>
<%_ if (!skipClient) { _%>
import { config } from './config.ts';
import { ServeStaticModule } from '@nestjs/serve-static';
<%_ } _%>
// jhipster-needle-add-entity-module-to-main-import - JHipster will import entity modules here, do not remove
// jhipster-needle-add-controller-module-to-main-import - JHipster will import controller modules here, do not remove
// jhipster-needle-add-service-module-to-main-import - JHipster will import service modules here, do not remove

@Module({
  imports: [
    // The configuration of the application*.yml files, read with ConfigService. main.ts loads the .env file.
    ConfigModule.forRoot({ isGlobal: true, ignoreEnvFile: true, cache: true, load: [configuration] }),
    CommonModule,
  // The database of the active profiles, from the configuration (their application-{profile}.yml files and the environment).
  TypeOrmModule.forRootAsync({
    inject: [ConfigService],
    useFactory: (configService: ConfigService) => ormConfig(key => configService.get(key)),
  }),
    <%_ if (!skipClient) { _%>
    ServeStaticModule.forRoot({
        rootPath: config.getClientPath(),
      }),
    <%_ } _%>
<%_ if (generateUserManagement) { _%>
    // The scheduled tasks, like the removal of the users not activated (@Cron of UserService).
    ScheduleModule.forRoot(),
<%_ } _%>
    AuthModule,
    HealthModule,
    ManagementModule,
  // jhipster-needle-add-entity-module-to-main - JHipster will add entity modules here, do not remove
  ],
  controllers: [
  // jhipster-needle-add-controller-module-to-main - JHipster will add controller modules here, do not remove
  ],
  providers: [
    // Logs the requests of every controller, opt out with @SkipLogging().
    { provide: APP_INTERCEPTOR, useClass: LoggingInterceptor },
<%_ if (serviceDiscoveryEureka) { _%>
    // The registration in the Eureka server, started by main.ts once the application listens.
    EurekaService,
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
    // The registration in Consul, started by main.ts once the application listens.
    ConsulService,
<%_ } _%>
  // jhipster-needle-add-service-module-to-main - JHipster will add service modules here, do not remove
  ],
})
export class AppModule  {

}
