        inverseJoinColumn: { name: '<%= relationship.columnName %>_id', referencedColumnName: "id" }
    })
        <%_ } _%>
    <%= relationshipFieldNamePlural %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>[]>;

    <%_ } else { _%>
    <%_ if (ownerSide === true) { _%>
    @OneToOne(() => <%= otherEntityClass %><% if (relationship.columnRequired) { %>, { nullable: false }<% } %>)
    @JoinColumn()
    <%_ } else { _%>
    @OneToOne(() => <%= otherEntityClass %>, other => other.<%= otherEntityRelationshipName %>)
    <%_ } _%>
    <%= relationshipFieldName %><%- relationship.relationshipRequired ? '!' : '?' %>: Relation<<%= otherEntityClass %>>;

    <%_ }
    } _%>
