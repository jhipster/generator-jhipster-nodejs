<%_ if (typeormOrderSupport) { _%>
import { BadRequestException } from '@nestjs/common';
<%_ } _%>
import { BaseEntity } from './base.entity';
import { Type, Expose as JsonProperty } from 'class-transformer';
import { ParsedQs } from 'qs';

<%_ if (typeormOrderSupport) { _%>
export type SortDirection = 'ASC' | 'DESC';

export class Sort {
  public property = 'id';
  public direction: SortDirection = 'ASC';
  constructor(sort?: string) {
    if (sort) {
      const [property, direction] = sort.split(',');
      this.property = property.trim();
      // Like Spring Data, the direction is case insensitive and ascending by default.
      this.direction = direction?.trim().toUpperCase() === 'DESC' ? 'DESC' : 'ASC';
    }
  }

  /** The TypeORM order of the property, nested for a property of a relationship like `region.name`. */
  asOrder(): any {
    return this.property
      .split('.')
      .reverse()
      .reduce<any>((order, key) => ({ [key]: order }), this.direction);
  }
}
<%_ } _%>

export type PaginationQueryType = string | ParsedQs | (string | ParsedQs)[];

export class PageRequest {
  /** The maximum size of a page, the default of Spring Data. */
  static readonly MAX_SIZE = 2000;

  @JsonProperty()
  page = 0;
  @JsonProperty()
  size = 20;
<%_ if (typeormOrderSupport) { _%>
  @Type(() => Sort)
  sort: Sort[] = [new Sort('id,ASC')];
<%_ } _%>

  constructor(
    page?: number | PaginationQueryType,
    size?: number | PaginationQueryType
<%_ if (typeormOrderSupport) { _%>
    ,sort?: PaginationQueryType,
    /** The properties a request can sort on, like the allowed ordered properties of JHipster's UserResource: any when not given. */
    sortProperties?: string[]
<%_ } _%>
  ) {
    this.page = Math.max(PageRequest.handleNumberTypes(page, this.page), 0);
    const requestedSize = PageRequest.handleNumberTypes(size, this.size);
    this.size = requestedSize < 1 ? this.size : Math.min(requestedSize, PageRequest.MAX_SIZE);
<%_ if (typeormOrderSupport) { _%>
    const sorts = PageRequest.handleQueryTypes(sort).map(value => new Sort(value));
    const invalid = sortProperties ? sorts.find(each => !sortProperties.includes(each.property)) : undefined;
    if (invalid) {
      throw new BadRequestException(`Invalid sort property: ${invalid.property}`);
    }
    if (sorts.length > 0) {
      this.sort = sorts;
    }
<%_ } _%>
  }

<%_ if (typeormOrderSupport) { _%>
  /** The TypeORM order of every sort, in the order of the request, the properties of a relationship merged. */
  asOrder(): any {
    const order: any = {};
    for (const { property, direction } of this.sort) {
      const keys = property.split('.');
      let target = order;
      for (const key of keys.slice(0, -1)) {
        target = target[key] ??= {};
      }
      target[keys[keys.length - 1]] = direction;
    }
    return order;
  }

  /** Every string of a query parameter given several times, like several `sort` parameters. */
  public static handleQueryTypes(pa: PaginationQueryType | undefined): string[] {
    return (Array.isArray(pa) ? pa : [pa]).filter((value): value is string => typeof value === 'string' && value.length > 0);
  }

<%_ } _%>
  public static handleNumberTypes(pp: number | PaginationQueryType | undefined, fallback: number): number {
    if (typeof pp === 'number') {
      return pp;
    }
    const query = PageRequest.handleQueryType(pp);
    if (query) {
      const parsed = parseInt(query, 10);
      return Number.isNaN(parsed) ? fallback : parsed;
    }
    return fallback;
  }

  public static handleQueryType(pa: PaginationQueryType | undefined): string | undefined {
    pa = Array.isArray(pa) ? pa[0] : pa;
    if (typeof pa === 'string') {
      return pa;
    }
    return undefined;
  }
}

export class Page<T extends BaseEntity> {
  constructor(public content: T[], public total: number, public pageable: PageRequest) {}
}
