import { BaseEntity } from './base.entity';
import { Type, Expose as JsonProperty } from 'class-transformer';
import { ParsedQs } from 'qs';

<%_ if (typeormOrderSupport) { _%>
export class Sort {
  public property = 'id';
  public direction: 'ASC' | 'DESC' | string = 'ASC';
  constructor(sort?: string) {
    if (sort) {
      [this.property, this.direction] = sort.split(',');
    }
  }

  asOrder(): any {
    const order: Record<string, string> = {};
    order[this.property] = this.direction;
    return order;
  }
}
<%_ } _%>

export type PaginationQueryType = string | ParsedQs | (string | ParsedQs)[];

/** Same as the default page size of Spring Data. */
export const DEFAULT_PAGE_SIZE = 20;
/** Same as the default `spring.data.web.pageable.max-page-size` of Spring Data, used by JHipster Spring Boot. */
export const MAX_PAGE_SIZE = 2000;

export class PageRequest {
  @JsonProperty()
  page = 0;
  @JsonProperty()
  size = DEFAULT_PAGE_SIZE;
<%_ if (typeormOrderSupport) { _%>
  @Type(() => Sort)
  sort: Sort = new Sort('id,ASC');
<%_ } _%>

  constructor(
    page?: number | PaginationQueryType,
    size?: number | PaginationQueryType
<%_ if (typeormOrderSupport) { _%>
    ,sort?: PaginationQueryType
<%_ } _%>
  ) {
    // Like Spring Data: a negative page is the first one, a size below 1 is the default one, and the size is capped
    this.page = Math.max(PageRequest.handleNumberTypes(page, this.page), 0);
    const requestedSize = PageRequest.handleNumberTypes(size, this.size);
    this.size = requestedSize < 1 ? DEFAULT_PAGE_SIZE : Math.min(requestedSize, MAX_PAGE_SIZE);
<%_ if (typeormOrderSupport) { _%>
    this.sort = new Sort(PageRequest.handleQueryType(sort));
<%_ } _%>
  }

  public static handleNumberTypes(pp: number | PaginationQueryType | undefined, fallback: number): number {
    if (typeof pp === 'number') {
      return pp;
    }
    const query = PageRequest.handleQueryType(pp);
    if (query) {
      const parsed = parseInt(query, 10);
      return Number.isNaN(parsed) ? fallback : parsed;
    }
    return fallback;
  }

  public static handleQueryType(pa: PaginationQueryType | undefined): string | undefined {
    pa = Array.isArray(pa) ? pa[0] : pa;
    if (typeof pa === 'string') {
      return pa;
    }
    return undefined;
  }
}

export class Page<T extends BaseEntity> {
  constructor(public content: T[], public total: number, public pageable: PageRequest) {}
}
