import { Logger, INestApplication } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { SwaggerModule, DocumentBuilder } from '@nestjs/swagger';

import { ApiDocsService } from './management/api-docs.service.ts';

export function setupSwagger(app: INestApplication): void {

  const logger: Logger = new Logger('Swagger');
  const configService = app.get(ConfigService);

  const options = new DocumentBuilder()
    .setTitle(configService.getOrThrow<string>('jhipster.swagger.title'))
    .setDescription(configService.getOrThrow<string>('jhipster.swagger.description'))
    .setVersion(configService.getOrThrow<string>('jhipster.swagger.version'))
    <%_ if (authenticationType === 'jwt') { _%>
    .addBearerAuth()
    <%_ } _%>
    .build();
  // Served by ApiDocsController at /v3/api-docs, the path of springdoc, for the administrators.
  app.get(ApiDocsService).document = SwaggerModule.createDocument(app, options);
  logger.log('Added the API documentation on /v3/api-docs');

}
