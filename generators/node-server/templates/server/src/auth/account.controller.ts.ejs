import { 
<%_ if (generateUserManagement) { _%> BadRequestException, Body, Post, 
<%_ } _%>UseGuards, Controller, Get, HttpCode, Logger, Req, UseInterceptors, ClassSerializerInterceptor } from '@nestjs/common';
import { AuthGuard } from './index.ts';
<%_ if (generateUserManagement) { _%>
import { PasswordChangeDTO } from './dto/password-change.dto.ts';
import { KeyAndPasswordDTO } from './dto/key-and-password.dto.ts';
import { MailService } from '../mail/mail.service.ts';
<%_ } _%>
import { <%- userLoginVmClass %> } from '../users/dto/user.dto.ts';
import { ApiBearerAuth, ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { AuthService } from './auth.service.ts';
<%_ if (authenticationTypeOauth2) { _%>
import { OidcUser } from './oauth2.authorities.ts';
<%_ } _%>

@Controller('api')
@UseInterceptors(ClassSerializerInterceptor)
@ApiTags('account-resource')
export class AccountController {
  logger = new Logger('AccountController');

  constructor(
    private readonly authService: AuthService,
<%_ if (generateUserManagement) { _%>
    private readonly mailService: MailService,
<%_ } _%>
  ) {}
<%_ if (generateUserManagement) { _%>

  @Get('/authenticate')
  @HttpCode(204)
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Check if the user is authenticated' })
  @ApiResponse({
    status: 204,
    description: 'authenticated',
  })
  isAuthenticated(): void {
    // The guard answers 401 to a request without a user.
  }

  @Get('/account')
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Get the current user.' })
  @ApiResponse({
    status: 200,
    description: 'user retrieved',
  })
  async getAccount(@Req() req: { user: <%- userLoginVmClass %> }): Promise<<%- user.dtoClass %> | undefined> {
    const { user } = req;
    const userProfileFound = await this.authService.getAccount(user.id!);
  <%_ if (databaseType === 'mongodb') { _%>
    if (userProfileFound && !userProfileFound.firstName) {
      userProfileFound.firstName = '';
    }
    if (userProfileFound && !userProfileFound.lastName) {
      userProfileFound.lastName = '';
    }
  <%_ } _%>
    return userProfileFound;
  }

  @Post('/account')
  @HttpCode(200)
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Update the current user information' })
  @ApiResponse({
    status: 200,
    description: 'user info updated',
  })
  async saveAccount(@Req() req: { user: <%- userLoginVmClass %> }, @Body() newUserInfo: <%- user.dtoClass %>): Promise<void> {
    const { user } = req;
    await this.authService.updateUserSettings(user.login, newUserInfo);
  }

  @Post('/account/change-password')
  @HttpCode(200)
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Change current password' })
  @ApiResponse({
    status: 200,
    description: 'user password changed',
    type: PasswordChangeDTO,
  })
  async changePassword(@Req() req: { user: <%- userLoginVmClass %> }, @Body() passwordChange: PasswordChangeDTO): Promise<void> {
    const { user } = req;
    return await this.authService.changePassword(user.login, passwordChange.currentPassword, passwordChange.newPassword);
  }

  @Post('/account/reset-password/init')
  @HttpCode(200)
  @ApiOperation({ summary: 'Send an email to reset the password of the user' })
  @ApiResponse({
    status: 200,
    description: 'Reset key given to the activated user of the mail, if any',
  })
  async requestPasswordReset(@Body() mail: unknown): Promise<void> {
    // Like JHipster Spring Boot, the mail is the body of the request, a text: 400 without it.
    if (typeof mail !== 'string' || !mail) {
      throw new BadRequestException('Failed to read request');
    }
    const user = await this.authService.requestPasswordReset(mail);
    if (user) {
      void this.mailService.sendPasswordResetMail(user);
    } else {
      this.logger.warn('Password reset requested for non existing mail');
    }
  }

  @Post('/account/reset-password/finish')
  @HttpCode(200)
  @ApiOperation({ summary: 'Finish to reset the password of the user' })
  @ApiResponse({
    status: 200,
    description: 'password reset',
  })
  async finishPasswordReset(@Body() keyAndPassword: KeyAndPasswordDTO): Promise<void> {
    await this.authService.completePasswordReset(keyAndPassword.newPassword, keyAndPassword.key);
  }

<%_ } else if (authenticationType === 'oauth2') { _%>

  @Get('/account')
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Get the current user, of the session or of the bearer token, else 401' })
  @ApiResponse({
    status: 200,
    description: 'User retrieved',
    type: <%- userLoginVmClass %>,
  })
  getAccount(@Req() req: { user: OidcUser }): <%- userLoginVmClass %> | undefined {
    return this.authService.getAccount(req.user);
  }

<%_ } else { _%>

  @Get('/account')
  @ApiBearerAuth()
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Get the current user.' })
  @ApiResponse({
    status: 200,
    description: 'user retrieved',
  })
  <%_ if (generateBuiltInUserEntity) { _%>
  async getAccount(@Req() req: { user: <%- userLoginVmClass %> }): Promise<<%- user.dtoClass %> | undefined> {
    const { user } = req;
    return await this.authService.getAccount(user.id!);
  }
  <%_ } else { _%>
  getAccount(@Req() req: { user: <%- userLoginVmClass %> }): <%- userLoginVmClass %> {
    // The user of the token, without built-in User.
    return req.user;
  }
  <%_ } _%>
<%_ } _%>

}
