import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

import type { ApplicationConfig } from '../application-config.ts';
import { comparePassword, encodePassword } from './password-util.ts';

/**
 * The passwords of the users, like the PasswordEncoder of JHipster Spring Boot: bcrypt, with the rounds of
 * <%- nodejsPasswordRoundsProperty %>.
 */
@Injectable()
export class PasswordService {
  private readonly rounds: number;

  constructor(configService: ConfigService<ApplicationConfig, true>) {
    this.rounds = Number(configService.get('<%- nodejsPasswordRoundsProperty %>', { infer: true }));
  }

  encode(password: string): Promise<string> {
    return encodePassword(password, this.rounds);
  }

  matches(password: string, hash: string): Promise<boolean> {
    return comparePassword(password, hash);
  }
}
