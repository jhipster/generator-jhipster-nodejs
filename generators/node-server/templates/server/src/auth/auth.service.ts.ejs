<%_ const userIdType = user?.primaryKey.tsType; _%>
<%_ if (generateUserManagement) { _%>

/**
 * The auditor of the account actions done without an authenticated user (register, activate, reset the password), like
 * the Constants.SYSTEM of JHipster Spring Boot.
 */
export const SYSTEM_AUDITOR = 'system';

/** Like the AccountResource of JHipster Spring Boot: a password of less characters or of more bytes than its length. */
export function isPasswordLengthInvalid(password?: string): boolean {
  return !password || password.length < PASSWORD_MIN_LENGTH || Buffer.byteLength(password) > PASSWORD_MAX_LENGTH;
}
<%_ } _%>


@Injectable()
export class AuthService {
    logger = new Logger('AuthService');
  constructor(
<%_ if (authenticationType === 'jwt' && generateBuiltInUserEntity) { _%>
    private readonly jwtService: JwtService,
    private readonly configService: ConfigService,
<%_ } _%>
<%_ if (generateUserManagement) { _%>
    private readonly passwordService: PasswordService,
<%_ } _%>
<%_ if (generateBuiltInAuthorityEntity) { _%>
    @InjectRepository(Authority) private authorityRepository: Repository<Authority>,
<%_ } _%>
<%_ if (generateBuiltInUserEntity) { _%>
    private userService: UserService,
<%_ } _%>
  ) {}

<%_ if (generateUserManagement) { _%>
  /** The hash an unknown login is checked with, like the timing attack protection of the DaoAuthenticationProvider of Spring Security. */
  private unknownUserPasswordHash?: Promise<string>;

  /** The activated user of a login and its password, with its authorities, else 401, like the login of JHipster Spring Boot. */
  async authenticate(loginUserName: string, loginPassword: string): Promise<<%- user.dtoClass %>> {
    // The logins are in lower case, like the ones of JHipster Spring Boot.
    const userFind = await this.userService.findByFields({ where: { login: loginUserName.toLowerCase() } });
    // An unknown login checks the password with a hash too: it answers in the time of a known one, which does not tell
    // the logins of the users.
    this.unknownUserPasswordHash ??= this.passwordService.encode(randomBytes(16).toString('hex'));
    const validPassword = await this.passwordService.matches(loginPassword, userFind?.password ?? (await this.unknownUserPasswordHash));
    if (!userFind || !validPassword) {
      throw new HttpException('Invalid login name or password!', HttpStatus.UNAUTHORIZED);
    }

    if (userFind && !userFind.activated) {
      throw new HttpException('Your account is not been activated!', HttpStatus.UNAUTHORIZED);
    }

    const user = await this.findUserWithAuthById(userFind.id!);
    if (!user) {
      throw new HttpException('Invalid login name or password!', HttpStatus.UNAUTHORIZED);
    }
    return user;
  }
  <%_ if (authenticationTypeJwt) { _%>

  async login(userLogin: UserLoginDTO): Promise<{ id_token: string }> {
    const loginUserName = userLogin.username;
    const loginPassword = userLogin.password;
    if (!loginUserName || !loginPassword) {
      throw new HttpException('Username and password are required!', HttpStatus.BAD_REQUEST);
    }
    const user = await this.authenticate(loginUserName, loginPassword);

    const payload: Payload = { sub: user.login, auth: (user.authorities ?? []).join(' '), userId: user.id };

    const expiresIn = Number(
      userLogin.rememberMe
        ? this.configService.getOrThrow('jhipster.security.authentication.jwt.token-validity-in-seconds-for-remember-me')
        : this.configService.getOrThrow('jhipster.security.authentication.jwt.token-validity-in-seconds'),
    );
    return {
      id_token: this.jwtService.sign(payload, { expiresIn }),
    };
  }

  async validateUser(payload: Payload): Promise<<%- user.dtoClass %> | undefined> {
    // The user of the token subject, like the login of JHipster Spring Boot tokens.
    return await this.userService.findByFields({ where: { login: payload.sub } });
  }
  <%_ } _%>

  async findUserWithAuthById(userId: <%- userIdType %>): Promise<<%- user.dtoClass %> | undefined> {
  <%_ if (databaseType === 'mongodb') { _%>
    const userDTO = await this.userService.findById(userId);
  <%_ } else { _%>
    const userDTO = await this.userService.findByFields({ where: { id: userId } });
  <%_ } _%>
    return userDTO;
  }

  async getAccount(userId: <%- userIdType %>): Promise<<%- user.dtoClass %> | undefined> {
    const userDTO = await this.findUserWithAuthById(userId);
    if (!userDTO) {
      return;
    }
    return userDTO;
  }

  async changePassword(userLogin: string, currentClearTextPassword: string, newPassword: string): Promise<void> {
    // Like the AccountResource of JHipster Spring Boot, the length of the new password.
    if (isPasswordLengthInvalid(newPassword)) {
      throw new InvalidPasswordException();
    }
    const userFind = await this.userService.findByFields({ where: { login: userLogin } });
    if (!userFind) {
      throw new HttpException('Invalid login name!', HttpStatus.BAD_REQUEST);
    }

    if (!(await this.passwordService.matches(currentClearTextPassword, userFind.password))) {
      throw new InvalidPasswordException();
    }
    userFind.password = newPassword;
    await this.userService.save(userFind, userLogin, true);
    return;
  }

  /**
   * Like JHipster Spring Boot, gives a reset key, valid one day, to the activated user of the mail: the user returned
   * is the one the mail with the key is for, undefined for another mail.
   */
  async requestPasswordReset(mail: string): Promise<<%- user.dtoClass %> | undefined> {
    const userFind = await this.userService.findByFields({ where: { email: mail.trim().toLowerCase() } });
    if (!userFind?.activated) {
      return undefined;
    }
    userFind.resetKey = randomBytes(15).toString('base64url');
    userFind.resetDate = new Date();
    return this.userService.save(userFind, SYSTEM_AUDITOR);
  }

  /** Like JHipster Spring Boot, sets the new password of the user of a reset key given less than one day ago. */
  async completePasswordReset(newPassword: string, key: string): Promise<void> {
    // Like the AccountResource of JHipster Spring Boot, the length of the new password before its key.
    if (isPasswordLengthInvalid(newPassword)) {
      throw new InvalidPasswordException();
    }
    const userFind = await this.userService.findByFields({ where: { resetKey: key } });
    if (!userFind?.resetDate || new Date(userFind.resetDate).getTime() < Date.now() - 24 * 60 * 60 * 1000) {
      throw new AccountResourceException('No user was found for this reset key');
    }
    userFind.password = newPassword;
    // null clears the columns (TypeORM leaves the undefined properties unchanged).
    Object.assign(userFind, { resetKey: null, resetDate: null });
    await this.userService.save(userFind, SYSTEM_AUDITOR, true);
  }

  async updateUserSettings(userLogin: string, newUserInfo: <%- user.dtoClass %>) : Promise<<%- user.dtoClass %>> {
    const userFind = await this.userService.findByFields({ where: { login: userLogin } });
    if (!userFind) {
      throw new HttpException('Invalid login name!', HttpStatus.BAD_REQUEST);
    }
    // Like JHipster Spring Boot, the mail in lower case, of no other user.
    const email = newUserInfo.email.toLowerCase();
    const userFindEmail = await this.userService.findByFields({ where: { email } });
    if (userFindEmail && userFindEmail.login !== userFind.login) {
      throw new EmailAlreadyUsedException();
    }

    userFind.firstName = newUserInfo.firstName;
    userFind.lastName = newUserInfo.lastName;
    userFind.email = email;
    userFind.langKey = newUserInfo.langKey;
    await this.userService.save(userFind, userLogin);
    return userFind;
  }

<%_ } else if (authenticationType === 'oauth2') { _%>
  <%_ if (generateBuiltInUserEntity) { _%>
    /**
     * The user of the identity provider in the database, like the user synchronization of JHipster Spring Boot: the
     * authorities the database misses saved first, then the user created, or updated with the names, the mail, the
     * language and the authorities of the identity provider.
     */
    async findUserOrSave(loginUser: <%- userLoginVmClass %>): Promise<<%- userLoginVmClass %> | undefined> {
        const authorities = loginUser.authorities ?? [];
    <%_ if (generateBuiltInAuthorityEntity) { _%>
        for (const name of authorities) {
          if (!(await this.authorityRepository.findOne({ where: { name } }))) {
            await this.authorityRepository.save(this.authorityRepository.create({ name }));
          }
        }
    <%_ } _%>
        const userFound = await this.userService.findByFields({ where: { login: loginUser.login } });
        const email = loginUser.email ?? userFound?.email ?? `${loginUser.login}@localhost`;
        // The values the identity provider gives, over the ones of the user found: not the undefined properties of the user of
        // the claims (its id among them), which would make another user.
        const claims = Object.fromEntries(Object.entries(loginUser).filter(([, value]) => value !== undefined));
        // Activated, like the users of JHipster Spring Boot synchronized from the identity provider, without a password.
        await this.userService.save({ ...userFound, ...claims, email, activated: true, authorities } as <%- userLoginVmClass %>, loginUser.login);
        return loginUser;
      }
  <%_ } _%>

  getAccount(userDTO: OidcUser): <%- userLoginVmClass %> | undefined {
    if (!userDTO) {
      return;
    }
    // Without the ID token of the session, kept for the logout only.
    const { idToken: _idToken, ...account } = userDTO;
    return account;
  }

<%_ } _%>

}
