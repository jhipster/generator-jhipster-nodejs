import { Authority } from '../users/authority.entity.ts';
<%_ } _%>
<%_ if (generateBuiltInUserEntity) { _%>
import { UserService } from '../users/user.service.ts';
  <%_ if (generateUserManagement) { _%>
import { AccountResourceException, EmailAlreadyUsedException, InvalidPasswordException } from '../common/errors/problem.exception.ts';
