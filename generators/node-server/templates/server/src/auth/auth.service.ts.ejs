import { <%- generateUserManagement ? 'PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH, ' : '' %><%- userLoginVmClass %> } from '../users/dto/user.dto.ts';
<%_ if (authenticationTypeOauth2) { _%>
import { OidcUser } from './oauth2.authorities.ts';
