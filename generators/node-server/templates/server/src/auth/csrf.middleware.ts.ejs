import { randomUUID } from 'crypto';
import { ForbiddenException, Injectable, NestMiddleware } from '@nestjs/common';
import { NextFunction, Request, Response } from 'express';

/** The idle lifetime of a session, on the server: its cookie lasts until the browser is closed. */
export const SESSION_MAX_AGE = 30 * 60 * 1000;

/** The methods that change nothing, which the CSRF token does not protect, like the ones of Spring Security. */
const SAFE_METHODS = ['GET', 'HEAD', 'OPTIONS', 'TRACE'];

/**
 * The XSRF-TOKEN cookie the clients (Angular HttpClient, axios) send back as the X-XSRF-TOKEN header: until the browser is
 * closed, like the one of JHipster Spring Boot, a remember-me session included.
 */
export function setCsrfCookie(res: Response, token: string): void {
  res.cookie('XSRF-TOKEN', token, { sameSite: 'lax', path: '/' });
}

/** A cookie of a request. */
export function cookieOf(req: Request, name: string): string | undefined {
  const cookie = req.headers.cookie
    ?.split(';')
    .map(value => value.trim())
    .find(value => value.startsWith(`${name}=`));
  try {
    return cookie ? decodeURIComponent(cookie.slice(name.length + 1)) : undefined;
  } catch {
    // Not a value a server gave.
    return undefined;
  }
}

/** The XSRF-TOKEN cookie of a request. */
const csrfCookie = (req: Request): string | undefined => cookieOf(req, 'XSRF-TOKEN');
<%_ if (authenticationTypeSession) { _%>

/**
 * The CSRF check of the unsafe requests of a client without a logged session, like the CookieCsrfTokenRepository of Spring
 * Security: the X-XSRF-TOKEN header is the token of the XSRF-TOKEN cookie of the client, else 403 (401 in Spring Security,
 * its answer to an anonymous client), so another site cannot log the browser of a user into another account, nor register
 * or reset a password from it. Called by the login itself too, whatever the path Express routes to it (its case, a
 * trailing slash).
 */
export function checkLoginCsrfToken(req: Request): void {
  const token = csrfCookie(req);
  if (!token || req.headers['x-xsrf-token'] !== token) {
    throw new ForbiddenException('Invalid CSRF token');
  }
}
<%_ } _%>

/**
 * The CSRF protection of the sessions, like the CSRF filter of Spring Security and the CookieCsrfFilter of JHipster Spring
 * Boot: a logged session gives its token as the XSRF-TOKEN cookie to a client without it, and every unsafe request of it,
 * the logout included, must send it as X-XSRF-TOKEN, else 403. A request with a bearer token has no session to protect.
<%_ if (authenticationTypeSession) { _%>
 * A client without a logged session gets a token cookie, which its unsafe requests, the login included, must send back
 * (checkLoginCsrfToken), else 403.
<%_ } _%>
 */
@Injectable()
export class CsrfMiddleware implements NestMiddleware {
  use(req: Request, res: Response, next: NextFunction): void {
    const session = req.session;
    if (!session?.user) {
<%_ if (authenticationTypeSession) { _%>
      if (!SAFE_METHODS.includes(req.method)) {
        checkLoginCsrfToken(req);
      } else if (!csrfCookie(req)) {
        setCsrfCookie(res, randomUUID());
      }
<%_ } _%>
      next();
      return;
    }
    session.csrfToken ??= randomUUID();
    if (csrfCookie(req) !== session.csrfToken) {
      // Like Spring Security, the cookie is set when the client has not the token of its session only (the session
      // of a remember-me login): a response of a session ended by a login meanwhile does not put the token
      // of the ended session back.
      setCsrfCookie(res, session.csrfToken);
    }
    // The token of the session is the one checked (the synchronizer token of OWASP): unlike the CookieCsrfTokenRepository of
    // Spring Security, which has the cookie only to compare with, the header is enough.
    if (!SAFE_METHODS.includes(req.method) && req.headers['x-xsrf-token'] !== session.csrfToken) {
      throw new ForbiddenException('Invalid CSRF token');
    }
    next();
  }
}
