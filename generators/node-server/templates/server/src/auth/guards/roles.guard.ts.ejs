import { CanActivate, ExecutionContext, Injectable } from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { <%= userLoginVmClass%> } from '../../users/dto/user.dto.ts';

/**
 * Allows a request when its user has one of the roles of the route, the @Roles of the handler, else the ones of its
 * controller class, like a @PreAuthorize of JHipster Spring Boot on a method or on its class.
 */
@Injectable()
export class RolesGuard implements CanActivate {
  constructor(private readonly reflector: Reflector) {}

  canActivate(context: ExecutionContext): boolean {
    const roles = this.reflector.getAllAndOverride<string[] | undefined>('roles', [context.getHandler(), context.getClass()]);

    if (!roles) {
      return true;
    }

    const request = context.switchToHttp().getRequest();
    const user = request.user as <%= userLoginVmClass%>;

    return !!user?.authorities?.some(role => roles.includes(role));
  }
}
