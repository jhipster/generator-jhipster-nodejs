import { describe, expect, it, vi } from 'vitest';
import { ForbiddenException } from '@nestjs/common';
import { <% if (authenticationTypeSession) { %>checkLoginCsrfToken, <% } %>CsrfMiddleware } from './csrf.middleware.ts';

const call = (method: string, session: any, headers: Record<string, string> = {}): { res: any; next: any } => {
  const res = { cookie: vi.fn() };
  const next = vi.fn();
  new CsrfMiddleware().use({ method, headers, session } as any, res as any, next);
  return { res, next };
};

describe('CsrfMiddleware', () => {
<%_ if (authenticationTypeSession) { _%>
  it('lets the requests without a logged session pass, giving a token cookie to a client without one', () => {
    const { res, next } = call('POST', {});
    expect(next).toHaveBeenCalled();
    expect(res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', expect.any(String), expect.objectContaining({ path: '/' }));
    expect(call('POST', {}, { cookie: 'XSRF-TOKEN=t0k' }).res.cookie).not.toHaveBeenCalled();
  });

  it('refuses a login without the token of its cookie, like Spring Security', () => {
    expect(() => checkLoginCsrfToken({ headers: {} } as any)).toThrow(ForbiddenException);
    expect(() => checkLoginCsrfToken({ headers: { 'x-xsrf-token': 't0k' } } as any)).toThrow(ForbiddenException);
    expect(() => checkLoginCsrfToken({ headers: { cookie: 'XSRF-TOKEN=t0k', 'x-xsrf-token': 'other' } } as any)).toThrow(ForbiddenException);
  });

  it('accepts a login with the token of its cookie', () => {
    expect(() => checkLoginCsrfToken({ headers: { cookie: 'SESSION=1; XSRF-TOKEN=t0k', 'x-xsrf-token': 't0k' } } as any)).not.toThrow();
  });

  it('gives the CSRF cookie of a remember-me session its lifetime', () => {
    const { res } = call('GET', { user: { login: 'user' }, csrfToken: 't0k', cookie: { originalMaxAge: 1000 } });
    expect(res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', 't0k', expect.objectContaining({ maxAge: 1000 }));
  });

  it('gives a CSRF cookie until the browser is closed to a client without a session, like JHipster Spring Boot', () => {
    expect(call('GET', {}).res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', expect.any(String), expect.not.objectContaining({ maxAge: expect.anything() }));
  });
<%_ } else { _%>
  it('lets the requests without a logged session pass, without the cookie', () => {
    const { res, next } = call('POST', {});
    expect(next).toHaveBeenCalled();
    expect(res.cookie).not.toHaveBeenCalled();
  });
<%_ } _%>

  it('gives the token of a logged session as the XSRF-TOKEN cookie on its safe requests too, until the browser is closed', () => {
    const { res, next } = call('GET', { user: { login: 'user' }, csrfToken: 't0k' });
    expect(next).toHaveBeenCalled();
    expect(res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', 't0k', expect.objectContaining({ path: '/' }));
    expect(res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', 't0k', expect.not.objectContaining({ maxAge: expect.anything() }));
  });

  it('does not set the cookie of a client with the token of its session: a response of a session ended meanwhile puts no old token back', () => {
    const { res, next } = call('GET', { user: { login: 'user' }, csrfToken: 't0k' }, { cookie: 'JSESSIONID=s1; XSRF-TOKEN=t0k' });
    expect(next).toHaveBeenCalled();
    expect(res.cookie).not.toHaveBeenCalled();
  });

  it('refuses an unsafe request of a logged session without its token, the logout too, like Spring Security', () => {
    expect(() => call('POST', { user: { login: 'user' }, csrfToken: 't0k' })).toThrow(ForbiddenException);
    expect(() => call('POST', { user: { login: 'user' }, csrfToken: 't0k' }, { 'x-xsrf-token': 'other' })).toThrow(ForbiddenException);
  });

  it('accepts an unsafe request of a logged session with its token', () => {
    const { next } = call('DELETE', { user: { login: 'user' }, csrfToken: 't0k' }, { 'x-xsrf-token': 't0k' });
    expect(next).toHaveBeenCalled();
  });

  it('creates the token of a session without one', () => {
    const session: any = { user: { login: 'user' } };
    const { res } = call('GET', session);
    expect(session.csrfToken).toEqual(expect.any(String));
    expect(res.cookie).toHaveBeenCalledWith('XSRF-TOKEN', session.csrfToken, expect.any(Object));
  });
});
