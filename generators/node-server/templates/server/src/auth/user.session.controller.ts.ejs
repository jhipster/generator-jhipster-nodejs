import { randomUUID } from 'node:crypto';

import { Body, Controller, Delete, Get, HttpCode, Logger, Param, Post, Req, Res, UnauthorizedException, UseGuards } from '@nestjs/common';
import { ApiConsumes, ApiOperation, ApiResponse, ApiTags } from '@nestjs/swagger';
import { Request, Response } from 'express';
import { AuthService } from './auth.service.ts';
import { checkLoginCsrfToken, setCsrfCookie } from './csrf.middleware.ts';
import { sessionUser } from './session-user.middleware.ts';
import { AuthGuard } from './guards/auth.guard.ts';
import { describeSession, RememberMeService } from './remember-me.service.ts';
import { SessionStore } from './session.store.ts';

/** The form of the session login, the one the JHipster clients post, like the formLogin of JHipster Spring Boot. */
interface LoginForm {
  username?: string;
  password?: string;
  'remember-me'?: string;
}

/** The values of the remember-me parameter that ask for it, like the ones of the RememberMeServices of Spring Security. */
const REMEMBER_ME_VALUES = ['true', 'on', 'yes', '1'];

/** An open session or a remember-me login of the user, as the sessions page of the clients shows it, like the PersistentToken of JHipster Spring Boot. */
interface SessionDTO {
  series: string;
  tokenDate: string;
  ipAddress: string | null;
  userAgent: string | null;
}

@Controller('api')
@ApiTags('user-session-controller')
export class UserSessionController {
  logger = new Logger('UserSessionController');

  constructor(
    private readonly authService: AuthService,
    private readonly rememberMeService: RememberMeService,
    private readonly sessionStore: SessionStore,
  ) {}

  @Post('/authentication')
  @HttpCode(200)
  @ApiConsumes('application/x-www-form-urlencoded')
  @ApiOperation({ summary: 'Log in, in a new session' })
  @ApiResponse({ status: 200, description: 'Logged in' })
  @ApiResponse({ status: 401, description: 'Invalid login, password, or a user not activated' })
  @ApiResponse({ status: 403, description: 'Without the CSRF token of the XSRF-TOKEN cookie' })
  async authenticate(@Req() req: Request, @Res({ passthrough: true }) res: Response, @Body() form: LoginForm): Promise<void> {
    checkLoginCsrfToken(req);
    if (typeof form?.username !== 'string' || typeof form.password !== 'string' || !form.username || !form.password) {
      throw new UnauthorizedException();
    }
    const user = sessionUser(await this.authService.authenticate(form.username, form.password));
    // Like Spring Security, a new session for the authenticated user (the id of the session before the login is not
    // kept), with the CSRF token the clients send back as X-XSRF-TOKEN.
    await new Promise<void>((resolve, reject) => req.session.regenerate((error?: Error) => (error ? reject(error) : resolve())));
    const session = req.session;
    session.user = user;
    session.csrfToken = randomUUID();
    // Like the remember-me of JHipster Spring Boot, a cookie of its own logs the user in after the session ended.
    const remembered = REMEMBER_ME_VALUES.includes(String(form['remember-me']).toLowerCase());
    describeSession(req, remembered ? await this.rememberMeService.remember(req, res, user.login) : undefined);
    setCsrfCookie(res, session.csrfToken);
    await new Promise<void>((resolve, reject) => session.save((error?: Error) => (error ? reject(error) : resolve())));
  }

  @Post('/logout')
  @HttpCode(200)
  @ApiOperation({ summary: 'Log out, ending the session and its remember-me login' })
  @ApiResponse({ status: 200, description: 'Logged out' })
  async logout(@Req() req: Request, @Res({ passthrough: true }) res: Response): Promise<void> {
    await this.rememberMeService.forget(req, res);
    await new Promise<void>(resolve => req.session.destroy(() => resolve()));
  }

  @Get('/account/sessions')
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'The open sessions and the remember-me logins of the current user, for the sessions page of the clients' })
  @ApiResponse({ status: 200, description: 'The open sessions and the remember-me logins of the user' })
  async getCurrentSessions(@Req() req: Request): Promise<SessionDTO[]> {
    const { login } = req.session.user!;
    // The remember-me logins, like the persistent tokens of JHipster Spring Boot, then the open sessions of no remember-me
    // login: a session of one is the same line, by its series.
    const logins = (await this.rememberMeService.tokensOf(login)).map(({ series, tokenDate, ipAddress, userAgent }) => ({
      series,
      tokenDate: tokenDate.toISOString().slice(0, 10),
      ipAddress,
      userAgent,
    }));
    const sessions = (await this.sessionStore.sessionsOf(login))
      .map(({ data }) => data)
      .filter(({ series }) => series && !logins.some(found => found.series === series));
    return [...logins, ...sessions].map(({ series, tokenDate, ipAddress, userAgent }) => ({
      series,
      tokenDate,
      ipAddress: ipAddress ?? null,
      userAgent: userAgent ?? null,
    }));
  }

  @Delete('/account/sessions/:series')
  @UseGuards(AuthGuard)
  @ApiOperation({ summary: 'Ends an open session or a remember-me login of the current user, a line of the sessions page of the clients' })
  @ApiResponse({ status: 200, description: 'The remember-me login and the open sessions of the series, if they are of the user, ended' })
  async invalidateSession(@Req() req: Request, @Param('series') series: string): Promise<void> {
    const { login } = req.session.user!;
    await this.rememberMeService.removeSeries(login, series);
    for (const { sid } of (await this.sessionStore.sessionsOf(login)).filter(({ data }) => data.series === series)) {
      await new Promise<void>((resolve, reject) => this.sessionStore.destroy(sid, error => (error ? reject(error) : resolve())));
    }
  }
}
