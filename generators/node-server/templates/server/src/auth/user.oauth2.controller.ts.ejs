import { randomUUID } from 'node:crypto';

import { Controller, Get, Logger, Post, Res, UseGuards, Req } from '@nestjs/common';
import { Request, Response } from 'express';
import { AuthService } from './auth.service.ts';
import { ApiTags, ApiResponse, ApiOperation, ApiExcludeEndpoint } from '@nestjs/swagger';
import { setCsrfCookie } from './csrf.middleware.ts';
import { OAuth2LoginGuard } from './guards/oauth2-login.guard.ts';
import { OAuth2Config } from './oauth2.config.ts';
import { OidcUser } from './oauth2.authorities.ts';

@Controller()
@ApiTags('user-oauth2-controller')
export class UserOauth2Controller {
  logger = new Logger('UserOauth2Controller');

  constructor(
    private readonly authService: AuthService,
    private readonly oauth2Config: OAuth2Config,
  ) {}

  @ApiExcludeEndpoint()
  @UseGuards(OAuth2LoginGuard)
  @Get('/login/oauth2/code/oidc')
  @ApiOperation({ summary: 'Backend redirect' })
  @ApiResponse({
    status: 200,
    description: 'Redirect oauth2 oidc after login',
  })
  redirect(@Req() req: Request, @Res() res: Response): void {
    // The user of the login (OAuth2Strategy).
    const user = req.user as OidcUser;
    // Like Spring Security, a new session for the authenticated user (the id of the session before the login is not
    // kept), with the CSRF token the clients send back as X-XSRF-TOKEN.
    req.session.regenerate((error?: Error) => {
      if (error) {
        this.logger.error(`The session of the login could not be created: ${error.message}`);
        res.status(500).end();
        return;
      }
      const csrfToken = randomUUID();
      req.session.user = user;
      req.session.csrfToken = csrfToken;
      setCsrfCookie(res, csrfToken);
      req.session.save(() => res.redirect('/'));
    });
  }

  @ApiExcludeEndpoint()
  @Get('/oauth2/authorization/oidc')
  @UseGuards(OAuth2LoginGuard)
  @ApiOperation({ summary: 'Perform login oauth2 oidc from client' })
  @ApiResponse({
    status: 200,
    description: 'Redirect to login oauth2 oidc',
  })
  loginAuthOidc(): void {
    return;
  }

  @ApiExcludeEndpoint()
  @Post('/api/logout')
  @ApiOperation({ summary: 'Perform logout oauth2 oidc from client' })
  @ApiResponse({
    status: 201,
    description: 'Logout oauth2 oidc',
  })
  logoutAuthOidc(@Req() req: Request): { idToken?: string; logoutUrl: string } | undefined {
    if (req.session?.user) {
      const idToken = req.session.user.idToken;
      req.session.destroy(() => undefined);
      // Like JHipster Spring Boot, the logout URL of the provider logs out the session of the user there, and redirects
      // back to the application (the client goes to it).
      const logoutUrl = new URL(this.oauth2Config.logoutUrl);
      if (idToken) {
        logoutUrl.searchParams.set('id_token_hint', idToken);
      }
      logoutUrl.searchParams.set('post_logout_redirect_uri', req.headers.origin ?? `${req.protocol}://${req.get('host')}`);
      return { idToken, logoutUrl: logoutUrl.toString() };
    }
    return;
  }

}
