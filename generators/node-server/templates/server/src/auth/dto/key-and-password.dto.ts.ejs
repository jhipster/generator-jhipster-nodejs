import { ApiProperty } from '@nestjs/swagger';
import { IsOptional, IsString } from 'class-validator';

/**
 * The reset key and the new password of a password reset, like the KeyAndPasswordVM of JHipster Spring Boot: no
 * constraint, a password missing or of an invalid length is an invalid password problem, checked before the key.
 */
export class KeyAndPasswordDTO {
  @ApiProperty({ description: 'Reset key' })
  @IsOptional()
  @IsString()
  readonly key?: string;

  @ApiProperty({ description: 'New password' })
  @IsOptional()
  @IsString()
  readonly newPassword?: string;
}
