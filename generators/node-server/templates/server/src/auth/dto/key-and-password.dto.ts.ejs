import { ApiProperty } from '@nestjs/swagger';
import { IsString, IsNotEmpty } from 'class-validator';

/**
 * The reset key and the new password of a password reset, like the KeyAndPasswordVM of JHipster Spring Boot.
 */
export class KeyAndPasswordDTO {
  @ApiProperty({ description: 'Reset key' })
  @IsString()
  @IsNotEmpty()
  readonly key!: string;

  // Its length is checked with the key, an invalid password problem like the one of JHipster Spring Boot.
  @ApiProperty({ description: 'New password' })
  @IsString()
  readonly newPassword!: string;
}
