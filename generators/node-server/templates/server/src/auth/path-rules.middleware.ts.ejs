/**
 * The authorization of the paths, before the routes, like the one of Spring Security in JHipster Spring Boot: the request
 * authenticated, its user set for the guards, then its path checked by the first rule matching it (PATH_RULES): a public
 * path passes, else a request without user is 401 and a user lacking the authority of the rule 403, whether the route
 * exists or not, so that the responses tell nothing of the routes of the server.
 * A URL Express reads another way than its text is refused first (400).
<%_ if (!authenticationTypeSession) { _%>
 * The responses to a bearer token tell their reason in WWW-Authenticate (RFC 6750), and the metadata of the server as a
 * protected resource (RFC 9728) are answered before the authentication.
<%_ } _%>
<%_ if (skipClient) { _%>
 * A path no rule matches is denied, like Spring Security.
<%_ } else { _%>
 * A path no rule matches goes on to the client (its files, else its index for the routes of the client).
<%_ } _%>
 */
@Injectable()
export class PathRulesMiddleware implements NestMiddleware {
  constructor(private readonly authenticator: RequestAuthenticator) {}

  async use(req: Request, res: Response, next: NextFunction): Promise<void> {
    if (isRejectedUrl(req.originalUrl)) {
      throw new BadRequestException();
    }
<%_ if (authenticationTypeSession) { _%>
    req.user = await this.authenticator.authenticate(req);
<%_ } else { _%>
    const path = requestPath(req.originalUrl);
    const metadata = req.method === 'GET' ? resourceMetadata(req, path) : undefined;
    if (metadata) {
      // Like the filter of Spring Security, before the authentication.
      res.json(metadata);
      return;
    }
    try {
      req.user = await this.authenticator.authenticate(req);
    } catch (error) {
      if (error instanceof InvalidBearerTokenException) {
        res.setHeader('WWW-Authenticate', invalidTokenChallenge(req, error.expired));
      }
      throw error;
    }
<%_ } _%>
    const access = pathAccess(req.method, <%- authenticationTypeSession ? 'requestPath(req.originalUrl)' : 'path' %>);
    if (access === 'permitAll'<%- skipClient ? '' : ' || access === undefined' %>) {
      next();
      return;
    }
    if (!req.user) {
<%_ if (authenticationTypeJwt || (authenticationTypeOauth2 && applicationTypeMicroservice)) { _%>
      res.setHeader('WWW-Authenticate', missingTokenChallenge(req));
<%_ } _%>
      throw new UnauthorizedException();
    }
    if (access !== 'authenticated' && !(access === 'admin' && req.user.authorities?.includes(RoleType.ADMIN))) {
<%_ if (!authenticationTypeSession) { _%>
      if (hasBearerScheme(req)) {
        res.setHeader('WWW-Authenticate', insufficientScopeChallenge());
      }
<%_ } _%>
      throw new ForbiddenException();
    }
    next();
  }
}
