import { BadRequestException, ForbiddenException, Injectable, NestMiddleware, UnauthorizedException } from '@nestjs/common';
import { NextFunction, Response } from 'express';
import { Request } from '../common/request.ts';
<%_ if (!authenticationTypeSession) { _%>
import {
  InvalidBearerTokenException,
  hasBearerScheme,
  insufficientScopeChallenge,
  invalidTokenChallenge,
  <%_ if (authenticationTypeJwt || (authenticationTypeOauth2 && applicationTypeMicroservice)) { _%>
  missingTokenChallenge,
