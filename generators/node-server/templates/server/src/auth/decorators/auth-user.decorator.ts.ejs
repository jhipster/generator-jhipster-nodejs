import { createParamDecorator, ExecutionContext } from '@nestjs/common';
import { Request } from '../../common/request.ts';

/**
 * The user of the request, which the PathRulesMiddleware authenticated, like the @AuthenticationPrincipal of Spring
 * Security: undefined on a public route (@Public()) without user.
 */
export const AuthUser = createParamDecorator(
  (_data: unknown, context: ExecutionContext): Request['user'] => context.switchToHttp().getRequest<Request>().user,
);
