import { Controller, Post, Res, HttpCode } from '@nestjs/common';
import { JsonBody } from '../common/errors/json-body.interceptor.ts';
import { Response } from 'express';
import { UserLoginDTO } from './dto/user-login.dto.ts';
import { AuthService } from './auth.service.ts';
import { Public } from './decorators/public.decorator.ts';
import { ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';

@Controller('api')
@Public()
@ApiTags('user-jwt-controller')
export class UserJWTController {

  constructor(private readonly authService: AuthService) {}

  @Post('/authenticate')
  @HttpCode(200)
  @ApiOperation({ summary: 'Authorization api retrieving token' })
  @ApiResponse({
    status: 200,
    description: 'Authorized',
  })
  async authorize(@JsonBody() user: UserLoginDTO, @Res({ passthrough: true }) res: Response): Promise<{ id_token: string }> {
    const jwt = await this.authService.login(user);
    res.setHeader('Authorization', `Bearer ${jwt.id_token}`);
    return jwt;
  }
}
