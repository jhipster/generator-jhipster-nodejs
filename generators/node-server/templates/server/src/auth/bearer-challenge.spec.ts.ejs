import { describe, expect, it } from 'vitest';
import { Request } from '../common/request.ts';
import { insufficientScopeChallenge, invalidTokenChallenge, missingTokenChallenge, resourceMetadata } from './bearer-challenge.ts';

const req = { protocol: 'https', host: 'api.example.com' } as unknown as Request;

describe('bearer challenge', () => {
  it('tells where the metadata of the resource are to a request without token', () => {
    expect(missingTokenChallenge(req)).toBe('Bearer resource_metadata="https://api.example.com/.well-known/oauth-protected-resource"');
  });

  it('keeps out of a challenge what its quotes cannot hold', () => {
    const forged = { protocol: 'https', host: 'x", error="y\\' } as unknown as Request;
    expect(missingTokenChallenge(forged)).toBe('Bearer resource_metadata="https://x, error=y/.well-known/oauth-protected-resource"');
  });

  it('tells a token is invalid, or expired', () => {
    expect(invalidTokenChallenge(req)).toBe(
      'Bearer error="invalid_token", error_description="The access token is invalid", error_uri="https://tools.ietf.org/html/rfc6750#section-3.1", resource_metadata="https://api.example.com/.well-known/oauth-protected-resource"',
    );
    expect(invalidTokenChallenge(req, true)).toContain('error="invalid_token", error_description="The access token expired", error_uri=');
  });

  it('tells a token lacks the authority of the path', () => {
    expect(insufficientScopeChallenge()).toBe(
      'Bearer error="insufficient_scope", error_description="The request requires higher privileges than provided by the access token.", error_uri="https://tools.ietf.org/html/rfc6750#section-3.1"',
    );
  });

  it('gives the metadata of the server and of its paths, of no other path', () => {
    expect(resourceMetadata(req, '/.well-known/oauth-protected-resource')).toEqual({
      resource: 'https://api.example.com',
      bearer_methods_supported: ['header'],
    });
    expect(resourceMetadata(req, '/.well-known/oauth-protected-resource/api/notes')?.resource).toBe('https://api.example.com/api/notes');
    expect(resourceMetadata(req, '/.well-known/oauth-protected-resources')).toBeUndefined();
    expect(resourceMetadata(req, '/.well-known/nothing')).toBeUndefined();
    expect(resourceMetadata(req, '/.WELL-KNOWN/oauth-protected-resource')).toBeUndefined();
  });
});
