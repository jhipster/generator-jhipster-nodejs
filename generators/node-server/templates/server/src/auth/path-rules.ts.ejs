/** The access of a path: public, of an authenticated user, or of an administrator. */
export type PathAccess = 'permitAll' | 'authenticated' | 'admin';

export interface PathRule {
  /** The methods of the rule, all of them when not given. */
  methods?: string[];
  /** The path pattern of Spring Security. */
  pattern: string;
  access: PathAccess;
}

/** Escapes the characters of a regular expression. */
const escapeRegExp = (text: string): string => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

/**
 * The paths of a path pattern of Spring (PathPattern), case insensitive like the routes of Express: `**` as the last
 * segment any number of segments, none included, `*` any characters of a segment. A trailing slash is allowed, as Express
 * routes a path with one to the route without it.
 */
export function pathPatternRegExp(pattern: string): RegExp {
  const segments = pattern.split('/').slice(1);
  const anySegments = segments.at(-1) === '**';
  const path = (anySegments ? segments.slice(0, -1) : segments)
    .map(segment => `/${segment.split('*').map(escapeRegExp).join('[^/]*')}`)
    .join('');
  return new RegExp(`^${path}${anySegments ? '(?:/.*)?' : '/?'}$`, 'i');
}

/**
 * The access rules of the paths, like the SecurityConfiguration of JHipster Spring Boot: in their order, the first one
 * matching a request decides. A route a guard protects has its rule here too, the guard checking it again.
 */
export const PATH_RULES: PathRule[] = [
<%_ for (const rule of nodejsPathRules) { _%>
  { <%- rule.methods ? `methods: [${rule.methods.map(method => `'${method}'`).join(', ')}], ` : '' %>pattern: '<%- rule.pattern %>', access: '<%- rule.access %>' },
<%_ } _%>
];

/** The rules with the paths of their patterns. */
const PATH_MATCHERS = PATH_RULES.map(rule => ({ ...rule, path: pathPatternRegExp(rule.pattern) }));

/** The path of a request URL, as Express routes it: without its query, and without the origin of an absolute URL. */
export function requestPath(url: string): string {
  return url.replace(/^[a-z][a-z\d+.-]*:\/\/[^/?#]*/i, '').split('?', 1)[0] || '/';
}

/**
 * A request URL whose path Express reads another way than its text, a backslash taken for a slash once it has a fragment:
 * refused, like the firewall of Spring Security, so that the rules and the routes read the same path.
 */
export function isRejectedUrl(url: string): boolean {
  return /[\\#]/.test(url);
}

/** The access of a request, by the first rule matching it, undefined when none does. */
export function pathAccess(method: string, path: string): PathAccess | undefined {
  return PATH_MATCHERS.find(rule => (!rule.methods || rule.methods.includes(method)) && rule.path.test(path))?.access;
}
