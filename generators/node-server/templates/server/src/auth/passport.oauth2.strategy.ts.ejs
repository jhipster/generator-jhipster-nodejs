import { jwtDecode } from 'jwt-decode';
import Strategy from 'passport-oauth2';
import { PassportStrategy } from '@nestjs/passport';
import { Injectable, Logger } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { AuthService } from './auth.service.ts';
import { <%= userLoginVmClass %> } from '../users/dto/user.dto.ts';
import { OAuth2Config } from './oauth2.config.ts';
import { oidcUserOfClaims } from './oauth2.authorities.ts';

@Injectable()
export class Oauth2Strategy extends PassportStrategy(Strategy, undefined, true) {
    logger = new Logger('oauth2');

    constructor(private readonly authService: AuthService, configService: ConfigService, oauth2Config: OAuth2Config) {
        super({
            authorizationURL: oauth2Config.authorizationURL,
            tokenURL: oauth2Config.tokenURL,
            clientID: `${configService.get('jhipster.security.oauth2.client.registration.oidc.client-id')}`,
            clientSecret: `${configService.get('jhipster.security.oauth2.client.registration.oidc.client-secret')}`,
            callbackURL: oauth2Config.callbackURL,
            proxy: true,
            scope: 'openid profile',
            state: true,
            pkce: true,
            // The user comes from the tokens of the response (validate), not from a profile request.
            skipUserProfile: true,
        });
    }

    /**
     * The user of the login, like the OIDC user of JHipster Spring Boot: the claims of the ID token over the ones of the
     * access token (the access token of some providers, like Okta, has no login nor mail). With its 4 parameters, passport-oauth2
     * gives it the params of the token response (the ID token): with 3, it gives the profile instead, undefined here.
     */
    <%- generateBuiltInUserEntity ? 'async ' : '' %>validate(accessToken: string, refreshToken: string, params: any, _profile: unknown): <%- generateBuiltInUserEntity ? `Promise<${userLoginVmClass} & { idToken?: string }>` : `${userLoginVmClass} & { idToken?: string }` %> {
        const user = oidcUserOfClaims({ ...jwtDecode(accessToken), ...(params.id_token ? jwtDecode(params.id_token) : {}) });
<%_ if (generateBuiltInUserEntity) { _%>
        await this.authService.findUserOrSave(user);
<%_ } _%>
        // The ID token of the session, for the logout.
        return Object.assign(user, { idToken: params.id_token });
    }
}
