import * as yaml from 'js-yaml';

import { type ApplicationConfig, validateConfiguration } from './application-config.ts';
import * as fs from 'fs';
import { randomBytes } from 'crypto';
import { networkInterfaces } from 'os';
import * as path from 'path';
import { Logger } from '@nestjs/common';

const logger = new Logger('Config');

export class Config {
  [key: string]: any;

  // The level of the loggers without a level of their own, like Spring Boot.
  'logging.level.ROOT' = 'INFO';
  'server.port' = '<%= serverPort %>';
  'jhipster.clientApp.name' = '<%= baseName %>';
<%_ if (serviceDiscoveryEureka) { _%>
  'jhipster.registry.password' = 'admin';
<%_ } _%>
<%_ if (!skipClient) { _%>
  'jhipster.security.content-security-policy' = "default-src 'self'; frame-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'<%- locals.microfrontend && locals.clientFrameworkAngular ? ' blob:' : '' %> https://storage.googleapis.com; style-src 'self'<%- locals.clientThemeAny ? ' https://fonts.googleapis.com' : '' %> 'unsafe-inline'; img-src 'self' data:; font-src 'self'<%- locals.clientThemeAny ? ' https://fonts.gstatic.com' : '' %> data:";
<%_ } _%>
<%_ if (authenticationType === 'jwt') { _%>
  'jhipster.security.authentication.jwt.base64-secret' = '';
  'jhipster.security.authentication.jwt.token-validity-in-seconds' = 86400;
  'jhipster.security.authentication.jwt.token-validity-in-seconds-for-remember-me' = 2592000;
  'jhipster.security.authentication.jwt.hash-salt-or-rounds' = 10;
<%_ } else if (authenticationType === 'oauth2') { _%>
  'jhipster.security.session.secret' = '';
  'jhipster.security.oauth2.client.provider.oidc.issuer-uri' = '';
  'jhipster.security.oauth2.client.registration.oidc.client-id' = '';
  'jhipster.security.oauth2.client.registration.oidc.client-secret' = '';
<%_ } _%>
  // The values of the env and configprops endpoints: never (shown as ******) like Spring Boot, or always.
  'management.endpoint.env.show-values' = 'never';
  'management.endpoint.configprops.show-values' = 'never';
  // CORS is disabled without allowed-origins nor allowed-origin-patterns, like JHipster Spring Boot (application-dev.yml).
  'jhipster.cors.allowed-origins' = '';
  'jhipster.cors.allowed-origin-patterns' = '';
  'jhipster.cors.allowed-methods' = '';
  'jhipster.cors.allowed-headers' = '';
  'jhipster.cors.exposed-headers' = '';
  'jhipster.cors.allow-credentials' = false;
  'jhipster.cors.max-age' = 1800;
  'jhipster.mail.base-url' = 'http://127.0.0.1:${server.port}';
  'jhipster.mail.from' = '<%= baseName %>@localhost';
<%_ if (generateUserManagement) { _%>
  'mail.host' = 'localhost';
  'mail.port' = 25;
  'mail.username' = '';
  'mail.password' = '';
<%_ } _%>
  'jhipster.swagger.default-include-pattern' = '/api/.*';
  'jhipster.swagger.title' = '<%= baseName %> API';
  'jhipster.swagger.description' = '<%= baseName %> API documentation';
  'jhipster.swagger.version' = '0.0.1';
  'info.display-ribbon-on-profiles' = 'dev';
  'server.ssl.enabled' = false;
  'server.ssl.key-store' = '';
  'server.ssl.key-store-password' = '';
  'server.ssl.key-store-type' = 'PKCS12';
<%_ if (serviceDiscoveryEureka) { _%>
  'eureka.client.enabled' = true;
  'eureka.client.fetch-registry' = true;
  'eureka.client.register-with-eureka' = true;
  'eureka.client.instance-info-replication-interval-seconds' = 10;
  'eureka.client.registry-fetch-interval-seconds' = 10;
  'eureka.instance.appname' = '<%= baseName %>';
  'eureka.instance.instanceId' = '<%= baseName %>:${random.value}';
  'eureka.instance.lease-renewal-interval-in-seconds' = 5;
  'eureka.instance.lease-expiration-duration-in-seconds' = 10;
  'eureka.instance.prefer-ip-address' = true;
  'eureka.client.service-url.defaultZone' = 'http://admin:${jhipster.registry.password}@localhost:8761/eureka/';
  'cloud.config.uri' = 'http://admin:${jhipster.registry.password}@localhost:8761/config';
  'cloud.config.name' = '<%= baseName %>';
  'cloud.config.profile' = 'prod';
  'cloud.config.label' = 'master';
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
  'cloud.consul.enabled' = false;
  'cloud.consul.host' = 'localhost';
  'cloud.consul.port' = 8500;
  'cloud.consul.discovery.service-name' = '<%= baseName.toLowerCase() %>';
  'cloud.consul.discovery.instance-id' = '<%= baseName.toLowerCase() %>:${random.value}';
  'cloud.consul.discovery.health-check-path' = '/management/health';
  'cloud.consul.discovery.health-check-interval' = '10s';
  'cloud.consul.discovery.health-check-timeout' = '5s';
  'cloud.consul.discovery.prefer-ip-address' = false;
<%_ } _%>

  constructor(properties: Record<string, any>) {
    this.addAll(properties);
  }

  public get(key: string): any {
    return this[key];
  }

  <%_ if (!skipClient) { _%>
  public getClientPath(): string {
    return path.join(import.meta.dirname, '../dist/static');
  }
  <%_ } _%>
  public addAll(properties: Record<string, any>): any {
    properties = objectToArray(properties);
    for (const property in properties) {
      if (properties.hasOwnProperty(property)) {
        this[property] = properties[property];
      }
    }
    this.applyEnvironment();
    this.postProcess();
  }

  /**
   * Environment variables override the properties, like the relaxed binding of Spring Boot: a property is set by its
   * name in upper case with the dots as underscores and the dashes removed, like JHIPSTER_MAIL_BASEURL for
   * jhipster.mail.base-url, or the dashes as underscores, like JHIPSTER_MAIL_BASE_URL.
   */
  private applyEnvironment(): void {
    for (const property of Object.keys(this)) {
      const name = property.toUpperCase().replace(/\./g, '_');
      const value = process.env[name.replace(/-/g, '')] ?? process.env[name.replace(/-/g, '_')];
      if (value !== undefined) {
        const current = this[property];
        this[property] = typeof current === 'number' ? Number(value) : typeof current === 'boolean' ? value === 'true' : value;
      }
    }
  }

  public postProcess(): any {
    // ${random.value} is a random value, like in Spring Boot (the Eureka instance id).
    const variables = { ...this, ...process.env, 'random.value': randomBytes(16).toString('hex') };
    for (const property in this) {
      if (this.hasOwnProperty(property)) {
        const value = this[property];
        const processedValue = this.processTemplate(value, variables);
        this[property] = processedValue;
      }
    }
  }

  private processTemplate(template: any, variables: Record<string, any>): any {
    // console.log(template);
    if (typeof template === 'string') {
      return template.replace(new RegExp('\\${[^{]+}', 'g'), name => variables[name.substring(2, name.length - 1)]);
    }
    return template;
  }
}

const configFolder = path.join(import.meta.dirname, 'config');
const yamlConfig: any = yaml.load(fs.readFileSync(path.join(configFolder, 'application.yml'), 'utf8'));

/**
 * The active profiles, like spring.profiles.active of Spring Boot: the comma separated profiles of BACKEND_ENV (the
 * default profile without it), each followed by the profiles of its group (profiles.group of application.yml), like dev
 * that activates secret-samples and api-docs.
 */
export const activeProfiles: string[] = expandProfiles((process.env.BACKEND_ENV || 'default').split(','), yamlConfig?.profiles?.group ?? {});

/** Whether one of the profiles is active, like Environment.acceptsProfiles of Spring. */
export function isProfileActive(...profiles: string[]): boolean {
  return profiles.some(profile => activeProfiles.includes(profile));
}

function expandProfiles(profiles: string[], groups: Record<string, string | string[]>, expanded: string[] = []): string[] {
  for (const profile of profiles.map(name => name.trim()).filter(Boolean)) {
    if (!expanded.includes(profile)) {
      expanded.push(profile);
      const group = groups[profile] ?? [];
      expandProfiles(typeof group === 'string' ? group.split(',') : group, groups, expanded);
    }
  }
  return expanded;
}

logger.log(`The following ${activeProfiles.length} profiles are active: ${activeProfiles.join(', ')}`);

// The application-{profile}.yml file of each active profile, when there is one, in the order of the profiles: the last
// one wins, like in Spring Boot.
const profileFiles = activeProfiles
  .map(profile => `application-${profile}.yml`)
  .filter(fileName => fs.existsSync(path.join(configFolder, fileName)));
const profileConfigs = profileFiles.map(fileName => objectToArray(yaml.load(fs.readFileSync(path.join(configFolder, fileName), 'utf8'))));

/**
 * The files of the configuration with their properties, like the property sources of Spring Boot the env endpoint
 * gives: the highest precedence first (the file of the last active profile), application.yml last.
 */
export const configFiles: { name: string; properties: Record<string, any> }[] = [
  ...profileFiles.map((fileName, index) => ({ name: `Config resource 'config/${fileName}'`, properties: profileConfigs[index] })).reverse(),
  { name: "Config resource 'config/application.yml'", properties: objectToArray(yamlConfig) },
];

const config = new Config(Object.assign(objectToArray(yamlConfig), ...profileConfigs, { ipAddress: ipAddress() }));

export { config };

/**
 * The configuration of the ConfigModule of @nestjs/config: the properties of config (the application*.yml files, the
 * environment variables and the cloud config), nested by their dotted names, so ConfigService.get('jhipster.swagger.title')
 * finds them. ConfigModule calls it when the application is created, after the cloud config is loaded by main.ts.
 * Providers and controllers read the configuration with ConfigService; config stays for the code running before the
 * application or outside of it (main.ts, tls.ts, the migrations). Validated like the configuration properties of Spring
 * Boot (application-config.ts): the application does not start with an invalid property.
 */
export function configuration(): ApplicationConfig {
  const nested: Record<string, any> = {};
  for (const [key, value] of Object.entries(config)) {
    const names = key.split('.');
    let target = nested;
    for (const name of names.slice(0, -1)) {
      target = target[name] = typeof target[name] === 'object' && target[name] !== null ? target[name] : {};
    }
    target[names[names.length - 1]] = value;
  }
  return validateConfiguration(nested) as unknown as ApplicationConfig;
}

function objectToArray(source: any, currentKey?: string, target?: Record<string, any>): Record<string, any> {
  target = target || {};
  for (const property in source) {
    if (source.hasOwnProperty(property)) {
      const newKey = currentKey ? currentKey + '.' + property : property;
      const newVal = source[property];

      if (typeof newVal === 'object') {
        objectToArray(newVal, newKey, target);
      } else {
        target[newKey] = newVal;
      }
    }
  }
  return target;
}

function ipAddress(): string | null {
  for (const aliases of Object.values(networkInterfaces())) {
    for (const alias of aliases ?? []) {
      if (alias.family === 'IPv4' && alias.address !== '127.0.0.1' && !alias.internal) {
        return alias.address;
      }
    }
  }
  return null;
}
