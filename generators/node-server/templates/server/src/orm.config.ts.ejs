/**
 * An in-memory MongoDB server, created again when another one took its port: mongodb-memory-server draws a free port and
 * releases it before mongod listens on it, so the test files running in parallel can draw the same port.
 */
async function createMongoMemoryServer(
  MongoMemoryServer: typeof import('mongodb-memory-server').MongoMemoryServer,
  attempts = 3,
): Promise<import('mongodb-memory-server').MongoMemoryServer> {
  try {
    return await MongoMemoryServer.create();
  } catch (error) {
    if (attempts > 1 && String(error).includes('already in use')) {
      return createMongoMemoryServer(MongoMemoryServer, attempts - 1);
    }
    throw error;
  }
}
<%_ } _%>

