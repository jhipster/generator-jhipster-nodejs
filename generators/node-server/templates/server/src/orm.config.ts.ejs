/**
 * The pg driver keeping the instants in UTC, like the hibernate.jdbc.time_zone of JHipster Spring Boot: a timestamp
 * (without time zone) is sent and read as UTC, not as the local time of the server.
 */
function pgDriver(): unknown {
  const pg = require('pg');
  pg.defaults.parseInputDatesAsUTC = true;
  pg.types.setTypeParser(pg.types.builtins.TIMESTAMP, (value: string) => new Date(`${value.replace(' ', 'T')}Z`));
  return pg;
}
<%_ } _%>
