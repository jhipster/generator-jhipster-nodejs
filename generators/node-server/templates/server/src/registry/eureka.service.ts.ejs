import { createRequire } from 'module';
import { hostname } from 'os';

import { BeforeApplicationShutdown, Injectable, Logger } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

import type { ApplicationConfig } from '../application-config.ts';
import { isProfileActive } from '../config.ts';

/** The client of eureka-js-client (the maintained fork of Rocket Software), which has no types. */
interface EurekaClient {
  start(callback: (error?: Error) => void): void;
  stop(callback: (error?: Error) => void): void;
  startHeartbeats(): void;
  startRegistryFetches(): void;
  on(event: 'registered', listener: () => void): void;
  logger: { level(level: string): void };
}

/**
 * The registration of the application in the Eureka server (the JHipster Registry), like Spring Cloud Netflix: at the
 * eureka.client.service-url.defaultZone, once the application listens, with the intervals of the configuration, and
 * cancelled when the application stops, so a gateway no longer routes to it.
 */
@Injectable()
export class EurekaService implements BeforeApplicationShutdown {
  private readonly logger = new Logger('EurekaService');

  constructor(private readonly configService: ConfigService<ApplicationConfig, true>) {}
  private client?: EurekaClient;

  /** Registers the application listening on the port, when eureka.client.enabled. */
  register(port: number): void {
    if (!this.configService.get('eureka.client.enabled', { infer: true })) {
      return;
    }
    const serviceUrl = new URL(this.configService.get('eureka.client.service-url.defaultZone', { infer: true }));
    const appName = this.configService.get('eureka.instance.appname', { infer: true });
    const ipAddress = this.configService.get('ipAddress', { infer: true }) || '127.0.0.1';
    const hostName = this.configService.get('eureka.instance.prefer-ip-address', { infer: true }) ? ipAddress : hostname();
    const baseUrl = `http://${hostName}:${port}`;
    const leaseRenewalInterval = Number(this.configService.get('eureka.instance.lease-renewal-interval-in-seconds', { infer: true }));
    const user = decodeURIComponent(serviceUrl.username) || this.configService.get('jhipster.registry.username', { infer: true }) || 'admin';
    const password = decodeURIComponent(serviceUrl.password) || this.configService.get('jhipster.registry.password', { infer: true }) || 'admin';
    const { Eureka } = createRequire(import.meta.url)('@rocketsoftware/eureka-js-client');
    const client: EurekaClient = new Eureka({
      instance: {
        app: appName,
        instanceId: this.configService.get('eureka.instance.instanceId', { infer: true }),
        hostName,
        ipAddr: ipAddress,
        status: 'UP',
        port: { $: port, '@enabled': 'true' },
        // The service id Spring Cloud looks the instances up by (the routes of a JHipster gateway), like its spring.application.name.
        vipAddress: appName,
        homePageUrl: `${baseUrl}/`,
        statusPageUrl: `${baseUrl}/management/info`,
        healthCheckUrl: `${baseUrl}/management/health`,
        leaseInfo: {
          renewalIntervalInSecs: leaseRenewalInterval,
          durationInSecs: Number(this.configService.get('eureka.instance.lease-expiration-duration-in-seconds', { infer: true })),
        },
        dataCenterInfo: {
          '@class': 'com.netflix.appinfo.InstanceInfo$DefaultDataCenterInfo',
          name: 'MyOwn',
        },
      },
      eureka: {
        host: serviceUrl.hostname,
        port: Number(serviceUrl.port) || (serviceUrl.protocol === 'https:' ? 443 : 80),
        ssl: serviceUrl.protocol === 'https:',
        servicePath: `${serviceUrl.pathname.replace(/\/$/, '')}/apps/`,
        heartbeatInterval: leaseRenewalInterval * 1000,
        registryFetchInterval: Number(this.configService.get('eureka.client.registry-fetch-interval-seconds', { infer: true })) * 1000,
        fetchRegistry: this.configService.get('eureka.client.fetch-registry', { infer: true }),
        registerWithEureka: this.configService.get('eureka.client.register-with-eureka', { infer: true }),
      },
      requestMiddleware: (requestOpts: Record<string, unknown>, done: (requestOpts: Record<string, unknown>) => void): void => {
        requestOpts.auth = { user, password };
        done(requestOpts);
      },
    });
    // The requests to the Eureka server are logged in development only.
    client.logger.level(isProfileActive('dev') ? 'debug' : 'warn');
    this.logger.log(`Registering ${appName} with Eureka at ${serviceUrl.host}`);
    let registered = false;
    client.on('registered', () => {
      registered = true;
    });
    client.start(error => {
      if (!error) {
        this.logger.log('Eureka registration complete');
        return;
      }
      if (registered || !this.configService.get('eureka.client.register-with-eureka', { infer: true })) {
        // The first registry fetch failed: the next ones are at its interval.
        this.logger.warn(`Eureka registry fetch failed: ${error.message}`);
        return;
      }
      this.logger.error(`Eureka registration failed, retried at each heartbeat: ${error.message}`);
      // Registered by the first heartbeat the server answers (404 for an unknown instance), like the Eureka client of Spring
      // Cloud keeps on registering: eureka-js-client starts the heartbeats and the registry fetches once registered only.
      client.startHeartbeats();
      if (this.configService.get('eureka.client.fetch-registry', { infer: true })) {
        client.startRegistryFetches();
      }
    });
    this.client = client;
  }

  /** Cancels the registration before the server stops, so a gateway no longer routes to the application. */
  beforeApplicationShutdown(): Promise<void> {
    const { client } = this;
    if (!client) {
      return Promise.resolve();
    }
    this.client = undefined;
    return new Promise(resolve => {
      client.stop(error => {
        if (error) {
          this.logger.warn(`Eureka deregistration failed: ${error.message}`);
        } else {
          this.logger.log('Eureka deregistration complete');
        }
        resolve();
      });
    });
  }
}
