import * as path from 'path';

import { DynamicModule, Module } from '@nestjs/common';
import { HelperOptions } from 'handlebars';
import { MailerModule, MailerOptions } from '@nestjs-modules/mailer';
import { HandlebarsAdapter } from '@nestjs-modules/mailer/adapters/handlebars.adapter';

import { ConfigMailSettingsProvider } from './mail-settings.provider.ts';
import { MailService } from './mail.service.ts';

/** The templates of the account mails, like the templates/mail of JHipster Spring Boot. */
export const mailTemplatesFolder = path.join(import.meta.dirname, '../templates/mail');

/**
 * The helpers of the templates: message, the message of a key in the language of the mail, its {0}, {1}... replaced by
 * the parameters, like the #{key(...)} of Thymeleaf. The messages are the ones of the context of the mail.
 */
export const mailTemplateHelpers = {
  message(key: string, ...parameters: unknown[]): string {
    const { data } = parameters.pop() as HelperOptions;
    const messages = (data?.root?.messages ?? {}) as Record<string, string>;
    const values = parameters.map(value => (typeof value === 'string' || typeof value === 'number' ? `${value}` : ''));
    return (messages[key] ?? key).replace(/\{(\d+)\}/g, (_, index: string) => values[Number(index)] ?? '');
  },
};

/**
 * The options of the mailer: its transports are the ones of the mail settings, which the MailService adds (the MailSettingsProvider),
 * and the Handlebars templates of the mails: they only interpolate values, escaped, and call the helpers of the server, they run no code.
 */
export function mailerOptions(): MailerOptions {
  return {
    transports: {},
    template: { dir: mailTemplatesFolder, adapter: new HandlebarsAdapter(mailTemplateHelpers), options: { strict: true } },
  };
}

/**
 * The mails of the application, a global module imported once by the application module with forRoot, like the ConfigModule:
 * the MailService is injected without importing it. Its settings are the ones of the MailSettingsProvider of a global module
 * of the application, else the ones of the mail properties (ConfigMailSettingsProvider, exported to fall back on them).
 */
@Module({})
export class MailModule {
  static forRoot(): DynamicModule {
    return {
      module: MailModule,
      global: true,
      imports: [MailerModule.forRoot(mailerOptions())],
      providers: [MailService, ConfigMailSettingsProvider],
      exports: [MailService, ConfigMailSettingsProvider],
    };
  }
}
