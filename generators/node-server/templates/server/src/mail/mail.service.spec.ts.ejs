import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

import { MailerService } from '@nestjs-modules/mailer';
import { Global, Module } from '@nestjs/common';
import { ConfigModule } from '@nestjs/config';
import { Test, TestingModule } from '@nestjs/testing';

import { MailError, type MailSettings, MailSettingsProvider } from './mail-settings.provider.ts';
import { MailModule } from './mail.module.ts';
import { MailService<%- generateUserManagement ? ', parseProperties' : '' %> } from './mail.service.ts';

describe('MailService', () => {
  let moduleRef: TestingModule;
  let mailService: MailService;
  let mailerService: MailerService;
  let sendMail: ReturnType<typeof vi.spyOn>;
  let addTransporter: ReturnType<typeof vi.spyOn>;
  let removeTransporter: ReturnType<typeof vi.spyOn>;
  let settings: MailSettings;
  const mailSettingsProvider = { get: vi.fn(() => Promise.resolve(settings)) };

  /** The provider of the mail settings of a global module, like the one of an application. */
  @Global()
  @Module({ providers: [{ provide: MailSettingsProvider, useValue: mailSettingsProvider }], exports: [MailSettingsProvider] })
  class MailSettingsModule {}
<%_ if (generateUserManagement) { _%>

  const user = {
    login: 'mailuser',
    email: 'mailuser@localhost.it',
    password: '',
    langKey: 'en',
    activationKey: 'activationKey',
    resetKey: 'resetKey',
  };
<%_ } _%>

  /** The mail the JSON transport of nodemailer gives back instead of sending it. */
  const sentMail = async (index = 0): Promise<{ from: { address: string }; to: { address: string }[]; subject: string; text: string; html: string }> =>
    JSON.parse(((await sendMail.mock.results[index].value) as { message: string }).message);

  beforeEach(async () => {
    settings = { host: 'localhost', port: 25, from: '<%- baseName %>@localhost', baseUrl: 'http://127.0.0.1:<%- serverPort %>' };
    mailSettingsProvider.get.mockClear();
    moduleRef = await Test.createTestingModule({
      imports: [ConfigModule.forRoot({ isGlobal: true, ignoreEnvFile: true, load: [() => ({})] }), MailSettingsModule, MailModule.forRoot()],
    }).compile();
    mailService = moduleRef.get(MailService);
    mailerService = moduleRef.get(MailerService);
    // The transports of the settings, as the JSON transport of nodemailer: the mail is given back instead of sent.
    const add = mailerService.addTransporter.bind(mailerService);
    addTransporter = vi.spyOn(mailerService, 'addTransporter').mockImplementation((name: string) => add(name, { jsonTransport: true }));
    removeTransporter = vi.spyOn(mailerService, 'removeTransporter');
    sendMail = vi.spyOn(mailerService, 'sendMail');
  });

  afterEach(async () => {
    await moduleRef.close();
  });

  it('should take the settings of the mail properties without a provider', async () => {
    const withoutProvider = await Test.createTestingModule({
      imports: [
        ConfigModule.forRoot({
          isGlobal: true,
          ignoreEnvFile: true,
          load: [() => ({ mail: { host: 'smtp.localhost', port: 587 }, jhipster: { mail: { from: '<%- baseName %>@localhost' } } })],
        }),
        MailModule.forRoot(),
      ],
    }).compile();

    expect(await withoutProvider.get(MailService).mailSettings()).toMatchObject({ host: 'smtp.localhost', port: 587 });
    await withoutProvider.close();
  });

  it('should send a mail from the sender of the settings', async () => {
    await mailService.sendMail({ to: 'someone@localhost.it', subject: 'Subject', text: 'Text' });

    const mail = await sentMail();
    expect(mail.from.address).toBe('<%- baseName %>@localhost');
    expect(mail.to[0].address).toBe('someone@localhost.it');
  });

  it('should keep the transport while the provider gives the same settings, and replace it for new ones', async () => {
    await mailService.sendMail({ to: 'someone@localhost.it', text: 'First' });
    await mailService.sendMail({ to: 'someone@localhost.it', text: 'Second' });
    expect(addTransporter).toHaveBeenCalledTimes(1);

    settings = { ...settings, from: 'changed@localhost' };
    await mailService.sendMail({ to: 'someone@localhost.it', text: 'Third' });

    expect(addTransporter).toHaveBeenCalledTimes(2);
    expect(removeTransporter).toHaveBeenCalledTimes(1);
    expect((await sentMail(2)).from.address).toBe('changed@localhost');
  });

  it('should tell when the settings are not available, and read them again at the next mail', async () => {
    mailSettingsProvider.get.mockRejectedValueOnce(new Error('No settings'));

    await expect(mailService.sendMail({ to: 'someone@localhost.it', text: 'Text' })).rejects.toMatchObject({
      messageKey: 'error.mail.settingsunavailable',
      message: 'The mail settings are not available: No settings',
    });
    await mailService.sendMail({ to: 'someone@localhost.it', text: 'Text' });
    expect(mailSettingsProvider.get).toHaveBeenCalledTimes(2);
  });

  it('should refuse a user without password', async () => {
    settings = { ...settings, auth: { type: 'password', username: 'smtpuser' } };

    await expect(mailService.sendMail({ to: 'someone@localhost.it', text: 'Text' })).rejects.toMatchObject({
      messageKey: 'error.mail.passwordundefined',
    });
    expect(sendMail).not.toHaveBeenCalled();
  });

  it('should tell the SMTP error of a mail not sent', async () => {
    sendMail.mockRejectedValueOnce(new Error('Connection refused'));

    const error = await mailService.sendMail({ to: 'someone@localhost.it', text: 'Text' }).catch((error: unknown) => error);
    expect(error).toBeInstanceOf(MailError);
    expect(error).toMatchObject({ messageKey: 'error.mail.sendfailed', message: 'The mail could not be sent: Connection refused' });
    expect((error as MailError).toProblem().getStatus()).toBe(502);
  });

  it('should send a test mail with the settings given over the ones in use, without keeping them', async () => {
    settings = { ...settings, auth: { type: 'password', username: 'smtpuser', password: 'secret' } };

    await mailService.sendTestEmail('someone@localhost.it', { host: 'smtp.localhost', auth: { type: 'password', username: 'other', password: '' } });

    expect(addTransporter).toHaveBeenCalledWith(expect.any(String), expect.anything());
    const [, transport] = addTransporter.mock.calls[0];
    expect(transport).toMatchObject({ host: 'smtp.localhost', port: 25, auth: { user: 'other', pass: 'secret' } });
    expect((await sentMail()).subject).toBe('<%- baseName %> test mail');
    expect(removeTransporter).toHaveBeenCalledTimes(1);
    expect(await mailService.mailSettings()).toMatchObject({ host: 'localhost' });
  });

  it('should take the security of the port of a test mail given without security', async () => {
    settings = { ...settings, security: 'NONE' };

    await mailService.sendTestEmail('someone@localhost.it', { port: 465 });

    const [, transport] = addTransporter.mock.calls[0];
    expect(transport).toMatchObject({ port: 465, secure: true, ignoreTLS: false });
  });

<%_ if (generateUserManagement) { _%>
  <%_ if (generateUserRegistration) { _%>
  it('should send the activation mail with the activation link', async () => {
    await mailService.sendActivationEmail(user);

    const mail = await sentMail();
    expect(mail.from.address).toBe('<%- baseName %>@localhost');
    expect(mail.subject).toBe('<%- baseName %> account activation');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%- serverPort %>/account/activate?key=activationKey">');
    expect(mail.html).toContain('<p>Dear mailuser</p>');
  });

  <%_ } _%>
  it('should send the creation mail with the link to set the password', async () => {
    await mailService.sendCreationEmail(user);

    const mail = await sentMail();
    expect(mail.subject).toBe('<%- baseName %> account activation');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%- serverPort %>/account/reset/finish?key=resetKey">');
  });

  it('should send the password reset mail with the reset link', async () => {
    await mailService.sendPasswordResetMail(user);

    const mail = await sentMail();
    expect(mail.subject).toBe('<%- baseName %> password reset');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%- serverPort %>/account/reset/finish?key=resetKey">');
  });

  it('should escape the user values in the mail', async () => {
    await mailService.sendCreationEmail({ ...user, login: '<b>mailuser</b>' });

    expect((await sentMail()).html).toContain('<p>Dear &lt;b&gt;mailuser&lt;/b&gt;</p>');
  });

  it('should use the default messages for a language without its messages file', async () => {
    await mailService.sendPasswordResetMail({ ...user, langKey: 'unknown' });

    expect((await sentMail()).subject).toBe('<%- baseName %> password reset');
  });

  it('should use the default messages for a langKey that is not a language tag', async () => {
    await mailService.sendPasswordResetMail({ ...user, langKey: '../config/application' });

    expect((await sentMail()).subject).toBe('<%- baseName %> password reset');
  });

  it('should not send a mail to a user without email', async () => {
    await mailService.sendCreationEmail({ ...user, email: '' });

    expect(sendMail).not.toHaveBeenCalled();
  });

  it('should not fail when the mail could not be sent', async () => {
    sendMail.mockRejectedValue(new Error('Connection refused'));

    await expect(mailService.sendCreationEmail(user)).resolves.toBeUndefined();
  });

  it('should parse the messages of a properties file', () => {
    expect(parseProperties('# comment\nemail.greeting=Caro {0}\nemail.title = \\u00c9quipe\n')).toEqual({
      'email.greeting': 'Caro {0}',
      'email.title': 'Équipe',
    });
  });
<%_ } _%>
});
