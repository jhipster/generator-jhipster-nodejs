import { Controller, ClassSerializerInterceptor, Get, Logger, Req, UseInterceptors } from '@nestjs/common';
import { PageRequest, Page } from '../../domain/base/pagination.entity';
import { <%= user.dtoClass%> } from '../../service/dto/user.dto';
import { Request } from '../../common/request';
import { HeaderUtil } from '../../common/header-util';
import { ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { AuthService } from '../../service/auth.service';
<%_ if (typeormOrderSupport) { _%>
import { UserService } from '../../service/user.service';
import { isSortableProperty } from '../../common/sortable-properties';
<%_ } _%>

<%_ if (typeormOrderSupport) { _%>
// The columns of a user no list can be sorted on: its password, its activation and reset keys and the date of its reset.
const UNSORTABLE_PROPERTIES = ['password', 'activationKey', 'resetKey', 'resetDate'];
<%_ } _%>

@Controller('api')
@UseInterceptors(ClassSerializerInterceptor)
@ApiTags('public-user-controller')
export class PublicUserController {

  logger = new Logger('PublicUserController');

  constructor(private readonly authService: AuthService<% if (typeormOrderSupport) { %>, private readonly userService: UserService<% } %>) { }

  @Get('/users')
  @ApiOperation({ summary: 'Get the list of users' })
  @ApiResponse({
      status: 200,
      description: 'List all users records',
      type: <%= user.dtoClass%>,
      isArray: true,
  })
  async getAllPublicUsers(@Req() req: Request): Promise<<%= user.dtoClass%>[]> {
      const pageRequest: PageRequest = new PageRequest(
        req.query.page,
        req.query.size,
<%_ if (typeormOrderSupport) { _%>
        req.query.sort ?? '<%- user.primaryKey.name %>,ASC',
        property => isSortableProperty(this.userService.metadata, property, { unsortable: UNSORTABLE_PROPERTIES }),
<%_ } _%>
      );
      const [results, count] = await this.authService.getAllUsers({
          skip: +pageRequest.page * pageRequest.size,
          take: +pageRequest.size,
<%_ if (typeormOrderSupport) { _%>
          order: pageRequest.asOrder(),
<%_ } _%>
      });
      HeaderUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
      return results;
  }


  @Get('/authorities')
  @ApiOperation({ summary: 'Get the list of user roles' })
  @ApiResponse({
    status: 200,
    description: 'List all user roles',
    type: 'string',
    isArray: true,
  })
  getAuthorities(@Req() req: any): any {
    const user: any = req.user;
    if (!user) {
        return [];
     }
    return user.authorities;
  }

}
