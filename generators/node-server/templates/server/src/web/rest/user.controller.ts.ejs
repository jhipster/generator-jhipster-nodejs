import { Body, Controller, NotFoundException, Delete, Get, Logger, Param, Post, Put, UseGuards, Req, UseInterceptors, ClassSerializerInterceptor } from '@nestjs/common';
import { AuthGuard,  Roles, RolesGuard, RoleType } from '../../security/index.ts';
import { PageRequest, Page } from '../../domain/base/pagination.entity.ts';
import { <%= user.dtoClass%> } from '../../service/dto/user.dto.ts';
import { HeaderUtil } from '../../common/header-util.ts';
import { Request } from '../../common/request.ts';
import {<%_ if (authenticationTypeJwt) { _%> ApiBearerAuth, <%_ } else { _%> ApiSecurity, <%_ } _%> ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { UserService } from '../../service/user.service.ts';
import { MailService } from '../../service/mail.service.ts';
import { randomBytes } from 'crypto';
import { BadRequestAlertException, EmailAlreadyUsedException, LoginAlreadyUsedException } from './errors/problem.exception.ts';
import { isSortableProperty } from '../../common/sortable-properties.ts';

// The columns of a user no list can be sorted on: its password, its activation and reset keys and the date of its reset.
const UNSORTABLE_PROPERTIES = ['password', 'activationKey', 'resetKey', 'resetDate'];

@Controller('api/admin/users')
@UseGuards(AuthGuard, RolesGuard)
@UseInterceptors(ClassSerializerInterceptor)
<%_ if (authenticationType === 'jwt') { _%>
@ApiBearerAuth()
<%_ } else { _%>
@ApiSecurity({})
<%_ } _%>
@ApiTags('user-resource')
export class UserController {
  logger = new Logger('UserController');

  constructor(
    private readonly userService: UserService,
    private readonly mailService: MailService,
    private readonly headerUtil: HeaderUtil,
  ) {}

  @Get('/')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Get the list of users' })
  @ApiResponse({
      status: 200,
      description: 'List all users',
      type: <%= user.dtoClass%>,
      isArray: true,
  })
  async getAllUsers(@Req() req: Request): Promise<<%= user.dtoClass%>[]> {
      const pageRequest: PageRequest = new PageRequest(
        req.query.page,
        req.query.size,
        req.query.sort ?? '<%- user.primaryKey.name %>,ASC',
        property => isSortableProperty(this.userService.metadata, property, { unsortable: UNSORTABLE_PROPERTIES }),
      );
      const [results, count] = await this.userService.findAndCount({
          skip: +pageRequest.page * pageRequest.size,
          take: +pageRequest.size,
          order: pageRequest.asOrder(),
      });
      this.headerUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
      return results;
  }

  @Post('/')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Create user' })
  @ApiResponse({
      status: 201,
      description: 'The record has been successfully created.',
      type: <%= user.dtoClass%>,
  })
  @ApiResponse({ status: 403, description: 'Forbidden.' })
  @ApiResponse({ status: 400, description: 'The user already has an id, or its login or mail is already used.' })
  async createUser(@Req() req: Request, @Body() userDTO: <%= user.dtoClass%>): Promise<<%= user.dtoClass%>> {
      if (userDTO.<%= user.primaryKey.name %> !== undefined && userDTO.<%= user.primaryKey.name %> !== null) {
          // Like JHipster Spring Boot, a new user cannot have an id: it would update an existing one.
          throw new BadRequestAlertException('A new user cannot already have an ID', 'userManagement', 'idexists');
      }
      // Like JHipster Spring Boot, the login and the mail in lower case, each one of a single user.
      const login = userDTO.login.toLowerCase();
      const email = userDTO.email.toLowerCase();
      if (await this.userService.findByFields({ where: { login } })) {
          throw new LoginAlreadyUsedException();
      }
      if (await this.userService.findByFields({ where: { email } })) {
          throw new EmailAlreadyUsedException();
      }
      // The fields of the UserService.createUser of JHipster Spring Boot only (not the password, the keys or the audit of
      // the body): the user is activated, with a random password and a reset key, the creation mail linking to the page that
      // sets the password.
      const created = await this.userService.save(
        {
          login,
          firstName: userDTO.firstName,
          lastName: userDTO.lastName,
          email,
          imageUrl: userDTO.imageUrl,
          langKey: userDTO.langKey ?? '<%= nativeLanguage %>',
          authorities: userDTO.authorities,
          activated: true,
          password: randomBytes(15).toString('base64url'),
          resetKey: randomBytes(15).toString('base64url'),
          resetDate: new Date(),
        },
        req.user?.login,
<%_ if (generateUserManagement) { _%>
        true,
<%_ } _%>
      );
      void this.mailService.sendCreationEmail(created);
      this.headerUtil.addUserManagementHeaders(req.res, 'created', created.login);
      return created;
  }

  @Put(['/', '/:login'])
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Update user' })
  @ApiResponse({
      status: 200,
      description: 'The record has been successfully updated.',
      type: <%= user.dtoClass%>,
  })
  @ApiResponse({ status: 400, description: 'The login or the mail is used by another user.' })
  @ApiResponse({ status: 404, description: 'No user of this id.' })
  async updateUser(@Req() req: Request, @Body() userDTO: <%= user.dtoClass%>): Promise<<%= user.dtoClass%>> {
    // Like JHipster Spring Boot, the user of the id of the body, whose login and mail are not the ones of another user.
    const id = userDTO.<%= user.primaryKey.name %>;
    const isAnotherUser = (other?: <%= user.dtoClass%>): boolean => other !== undefined && other !== null && String(other.<%= user.primaryKey.name %>) !== String(id);
    const login = userDTO.login.toLowerCase();
    const email = userDTO.email.toLowerCase();
    if (isAnotherUser(await this.userService.findByFields({ where: { email } }))) {
      throw new EmailAlreadyUsedException();
    }
    if (isAnotherUser(await this.userService.findByFields({ where: { login } }))) {
      throw new LoginAlreadyUsedException();
    }
    const existing = id === undefined || id === null ? undefined : await this.userService.findByFields({ where: { <%= user.primaryKey.name %>: id } });
    if (!existing) {
      throw new NotFoundException();
    }
    // The fields of the UserService.updateUser of JHipster Spring Boot only: the password, the keys and the audit stay.
    const updated = await this.userService.update(
      {
        ...existing,
        login,
        firstName: userDTO.firstName,
        lastName: userDTO.lastName,
        email,
        imageUrl: userDTO.imageUrl,
        activated: userDTO.activated,
        langKey: userDTO.langKey,
        authorities: userDTO.authorities,
      },
      req.user?.login,
    );
    this.headerUtil.addUserManagementHeaders(req.res, 'updated', updated.login);
    return updated;
  }

  @Get('/:login')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Get user' })
  @ApiResponse({
      status: 200,
      description: 'The found record',
      type: <%= user.dtoClass%>,
  })
  async getUser(@Param('login') loginValue: string): Promise<<%= user.dtoClass%>> {
      // With its authorities, which the edition page of the client shows and sends back.
      const user = await this.userService.findByFields({ where: { login: loginValue } });
      if (!user) {
        throw new NotFoundException();
      }
      return user;
  }

  @Delete('/:login')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Delete user' })
  @ApiResponse({
      status: 204,
      description: 'The record has been successfully deleted.',
      type: <%= user.dtoClass%>
  })
  async deleteUser(@Req() req: Request, @Param('login') loginValue: string): Promise<<%= user.dtoClass%> | undefined> {
      const userToDelete = await this.userService.find({ where: { login: loginValue } });
      if (!userToDelete) {
        throw new NotFoundException();
      }
      this.headerUtil.addUserManagementHeaders(req.res, 'deleted', loginValue);
      return await this.userService.delete(userToDelete);
  }
}
