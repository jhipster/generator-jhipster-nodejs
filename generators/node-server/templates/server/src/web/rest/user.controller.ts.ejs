import { Body, Controller, NotFoundException, Delete, Get, Logger, Param, Post, Put, UseGuards, Req, UseInterceptors, ClassSerializerInterceptor } from '@nestjs/common';
import { AuthGuard,  Roles, RolesGuard, RoleType } from '../../security/index.ts';
import { PageRequest, Page } from '../../domain/base/pagination.entity.ts';
import { <%= user.dtoClass%> } from '../../service/dto/user.dto.ts';
import { HeaderUtil } from '../../common/header-util.ts';
import { Request } from '../../common/request.ts';
import {<%_ if (authenticationType === 'jwt') { _%> ApiBearerAuth, <%_ } else if (authenticationType === 'oauth2') { _%> ApiSecurity, <%_ } _%> ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { UserService } from '../../service/user.service.ts';
import { EmailAlreadyUsedException, LoginAlreadyUsedException } from './errors/problem.exception.ts';
<%_ if (typeormOrderSupport) { _%>
import { isSortableProperty } from '../../common/sortable-properties.ts';
<%_ } _%>

<%_ if (typeormOrderSupport) { _%>
// The columns of a user no list can be sorted on: its password, its activation and reset keys and the date of its reset.
const UNSORTABLE_PROPERTIES = ['password', 'activationKey', 'resetKey', 'resetDate'];
<%_ } _%>

@Controller('api/admin/users')
@UseGuards(AuthGuard, RolesGuard)
@UseInterceptors(ClassSerializerInterceptor)
<%_ if (authenticationType === 'jwt') { _%>
@ApiBearerAuth()
<%_ } else if (authenticationType === 'oauth2') { _%>
@ApiSecurity({})
<%_ } _%>
@ApiTags('user-resource')
export class UserController {
  logger = new Logger('UserController');

  constructor(private readonly userService: UserService) {}

  @Get('/')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Get the list of users' })
  @ApiResponse({
      status: 200,
      description: 'List all users',
      type: <%= user.dtoClass%>,
      isArray: true,
  })
  async getAllUsers(@Req() req: Request): Promise<<%= user.dtoClass%>[]> {
      const pageRequest: PageRequest = new PageRequest(
        req.query.page,
        req.query.size,
<%_ if (typeormOrderSupport) { _%>
        req.query.sort ?? '<%- user.primaryKey.name %>,ASC',
        property => isSortableProperty(this.userService.metadata, property, { unsortable: UNSORTABLE_PROPERTIES }),
<%_ } _%>
      );
      const [results, count] = await this.userService.findAndCount({
          skip: +pageRequest.page * pageRequest.size,
          take: +pageRequest.size,
<%_ if (typeormOrderSupport) { _%>
          order: pageRequest.asOrder(),
<%_ } _%>
      });
      HeaderUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
      return results;
  }

  @Post('/')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Create user' })
  @ApiResponse({
      status: 201,
      description: 'The record has been successfully created.',
      type: <%= user.dtoClass%>,
  })
  @ApiResponse({ status: 403, description: 'Forbidden.' })
  async createUser(@Req() req: Request, @Body() userDTO: <%= user.dtoClass%>): Promise<<%= user.dtoClass%>> {
      // Like JHipster Spring Boot, the login and the mail in lower case, each one of a single user.
      userDTO.login = userDTO.login.toLowerCase();
      userDTO.email = userDTO.email.toLowerCase();
      if (await this.userService.findByFields({ where: { login: userDTO.login } })) {
          throw new LoginAlreadyUsedException();
      }
      if (await this.userService.findByFields({ where: { email: userDTO.email } })) {
          throw new EmailAlreadyUsedException();
      }
      userDTO.password = userDTO.login;
      const created = await this.userService.save(userDTO, req.user?.login);
      HeaderUtil.addEntityCreatedHeaders(req.res, 'User', created.id);
      return created;
  }

  @Put(['/', '/:login'])
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Update user' })
  @ApiResponse({
      status: 200,
      description: 'The record has been successfully updated.',
      type: <%= user.dtoClass%>,
  })
  async updateUser(@Req() req: Request, @Body() userDTO: <%= user.dtoClass%>): Promise<<%= user.dtoClass%>> {
    const userOnDb = await this.userService.find({ where: { login: userDTO.login } });
    let updated = false;
    if (userOnDb && userOnDb.id) {
      userDTO.id = userOnDb.id;
      updated = true;
    } else {
      userDTO.password = userDTO.login;
    }
    const createdOrUpdated = await this.userService.update(userDTO, req.user?.login);
    if (updated) {
      HeaderUtil.addEntityUpdatedHeaders(req.res, 'User', createdOrUpdated.id);
    } else {
      HeaderUtil.addEntityCreatedHeaders(req.res, 'User', createdOrUpdated.id);
    }
    return createdOrUpdated;
  }

  @Get('/:login')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Get user' })
  @ApiResponse({
      status: 200,
      description: 'The found record',
      type: <%= user.dtoClass%>,
  })
  async getUser(@Param('login') loginValue: string): Promise<<%= user.dtoClass%>> {
      const user = await this.userService.find({ where: { login: loginValue } });
      if (!user) {
        throw new NotFoundException();
      }
      return user;
  }

  @Delete('/:login')
  @Roles(RoleType.ADMIN)
  @ApiOperation({ summary: 'Delete user' })
  @ApiResponse({
      status: 204,
      description: 'The record has been successfully deleted.',
      type: <%= user.dtoClass%>
  })
  async deleteUser(@Req() req: Request, @Param('login') loginValue: string): Promise<<%= user.dtoClass%> | undefined> {
      const userToDelete = await this.userService.find({ where: { login: loginValue } });
      if (!userToDelete) {
        throw new NotFoundException();
      }
      HeaderUtil.addEntityDeletedHeaders(req.res, 'User', loginValue);
      return await this.userService.delete(userToDelete);
  }
}
