<%_
const pkType = primaryKey.tsType;
const idPipe = pkType === 'number' ? 'ParseIntPipe' : primaryKey.typeUUID ? 'ParseUUIDPipe' : undefined;
const idParam = `@Param('id'${idPipe ? `, ${idPipe}` : ''}) id: ${pkType}`;
_%>
import { BadRequestException, Body, ClassSerializerInterceptor, Controller, Delete, Get, Logger, NotFoundException, Param,<% if (idPipe) { %> <%= idPipe %>,<% } %> Patch, Post as PostMethod, Put, UseGuards, Req, UseInterceptors } from '@nestjs/common';
import { <% if (authenticationType === 'jwt') { _%> ApiBearerAuth, <% } else if (authenticationType === 'oauth2') { _%> ApiSecurity, <% } _%> ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { validate } from 'class-validator';
import { <%= dtoClass %> } from '../../service/dto/<%= entityFileName %>.dto';
import { <%= entityClass %>Service } from '../../service/<%= entityFileName %>.service';
import { PageRequest, Page } from '../../domain/base/pagination.entity';
import { AuthGuard,  Roles, RolesGuard, RoleType } from '../../security';
import { HeaderUtil } from '../../common/header-util';
import { Request } from '../../common/request';
import { LoggingInterceptor } from '../../common/interceptors/logging.interceptor';

const ENTITY_NAME = '<%= entityClass %>';

@Controller('api/<%= entityApiUrl %>')
@UseGuards(AuthGuard, RolesGuard)
@UseInterceptors(LoggingInterceptor, ClassSerializerInterceptor)
<%_ if (authenticationType === 'jwt') { _%>
@ApiBearerAuth()
<%_ } else if (authenticationType === 'oauth2') { _%>
@ApiSecurity({})
<%_ } _%>
@ApiTags('<%= entityApiUrl %>')
export class <%= entityClass %>Controller {
  logger = new Logger('<%= entityClass %>Controller');

  constructor(private readonly <%= entityInstance %>Service: <%= entityClass %>Service) {}


  @Get('/')
  @Roles(RoleType.USER)
  @ApiResponse({
    status: 200,
    description: 'List all records',
    type: <%= dtoClass %>,
  })
  async getAll(@Req() req: Request): Promise<<%= dtoClass %> []>  {
    const pageRequest: PageRequest = new PageRequest(
      req.query.page,
      req.query.size,
<%_ if (typeormOrderSupport) { _%>
      req.query.sort ?? '<%- primaryKey.name %>,ASC'
<%_ } _%>
    );
    const [results, count] = await this.<%= entityInstance %>Service.findAndCount({
      skip: +pageRequest.page * pageRequest.size,
      take: +pageRequest.size,
<%_ if (typeormOrderSupport) { _%>
      order: pageRequest.sort.asOrder(),
<%_ } _%>
    });
    HeaderUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
    return results;
  }

  @Get('/:id')
  @Roles(RoleType.USER)
  @ApiResponse({
    status: 200,
    description: 'The found record',
    type: <%= dtoClass %>,
  })
  async getOne(<%- idParam %>): Promise<<%= dtoClass %>>  {
    const <%= entityInstance %>DTO = await this.<%= entityInstance %>Service.findById(id);
    if (!<%= entityInstance %>DTO) {
      throw new NotFoundException();
    }
    return <%= entityInstance %>DTO;
  }

  @PostMethod('/')
  @Roles(RoleType.USER)
  @ApiOperation({ summary: 'Create <%= entityInstance %>' })
  @ApiResponse({
    status: 201,
    description: 'The record has been successfully created.',
    type: <%= dtoClass %>,
  })
  @ApiResponse({ status: 403, description: 'Forbidden.' })
  async post(@Req() req: Request, @Body() <%= entityInstance %>DTO: <%= dtoClass %>): Promise<<%= dtoClass %>>  {
    const created = await this.<%= entityInstance %>Service.save(<%= entityInstance %>DTO, req.user?.login);
    HeaderUtil.addEntityCreatedHeaders(req.res, ENTITY_NAME, created.id);
    return created;
  }

  @Put('/:id')
  @Roles(RoleType.USER)
  @ApiOperation({ summary: 'Update <%= entityInstance %> with id' })
  @ApiResponse({
    status: 200,
    description: 'The record has been successfully updated.',
    type: <%= dtoClass %>,
  })
  @ApiResponse({ status: 400, description: 'Invalid id, or the record does not exist.' })
  async putId(@Req() req: Request, <%- idParam %>, @Body() <%= entityInstance %>DTO: <%= dtoClass %>): Promise<<%= dtoClass %>>  {
    await this.validateIdForUpdate(req, id, <%= entityInstance %>DTO);
    const updated = await this.<%= entityInstance %>Service.update(<%= entityInstance %>DTO, req.user?.login);
    HeaderUtil.addEntityUpdatedHeaders(req.res, ENTITY_NAME, id);
    return updated;
  }

  @Patch('/:id')
  @Roles(RoleType.USER)
  @ApiOperation({ summary: 'Partially update <%= entityInstance %> with id, fields that are null or absent are ignored' })
  @ApiResponse({
    status: 200,
    description: 'The record has been successfully updated.',
    type: <%= dtoClass %>,
  })
  @ApiResponse({ status: 400, description: 'Invalid id or values, or the record does not exist.' })
  async patchId(@Req() req: Request, <%- idParam %>, @Body() <%= entityInstance %>DTO: Partial<<%= dtoClass %>>): Promise<<%= dtoClass %>>  {
    const existing = await this.validateIdForUpdate(req, id, <%= entityInstance %>DTO);
    const changes = Object.fromEntries(
      Object.entries(<%= entityInstance %>DTO ?? {}).filter(([, value]) => value !== null && value !== undefined),
    );
    // The global ValidationPipe requires every mandatory field, here only the given ones are validated
    const errors = await validate(Object.assign(new <%= dtoClass %>(), changes), {
      skipMissingProperties: true,
      forbidUnknownValues: false,
    });
    if (errors.length > 0) {
      throw new BadRequestException('Validation error');
    }
    const updated = await this.<%= entityInstance %>Service.update(Object.assign(existing, changes), req.user?.login);
    HeaderUtil.addEntityUpdatedHeaders(req.res, ENTITY_NAME, id);
    return updated;
  }

  @Delete('/:id')
  @Roles(RoleType.USER)
  @ApiOperation({ summary: 'Delete <%= entityInstance %>' })
  @ApiResponse({
    status: 204,
    description: 'The record has been successfully deleted.',
  })
  async deleteById(@Req() req: Request, <%- idParam %>): Promise<void>  {
    HeaderUtil.addEntityDeletedHeaders(req.res, ENTITY_NAME, id);
    return await this.<%= entityInstance %>Service.deleteById(id);
  }

  /**
   * Checks the id of an update like JHipster Spring Boot: the body must have the id of the path,
   * and the record must exist, otherwise answers 400.
   */
  private async validateIdForUpdate(req: Request, id: <%= pkType %>, <%= entityInstance %>DTO: Partial<<%= dtoClass %>> | undefined): Promise<<%= dtoClass %>> {
    if (<%= entityInstance %>DTO?.id === undefined || <%= entityInstance %>DTO.id === null) {
      HeaderUtil.addFailureAlertHeaders(req.res, ENTITY_NAME, 'idnull');
      throw new BadRequestException('Invalid id');
    }
    if (String(<%= entityInstance %>DTO.id) !== String(id)) {
      HeaderUtil.addFailureAlertHeaders(req.res, ENTITY_NAME, 'idinvalid');
      throw new BadRequestException('Invalid ID');
    }
    const existing = await this.<%= entityInstance %>Service.findById(id);
    if (!existing) {
      HeaderUtil.addFailureAlertHeaders(req.res, ENTITY_NAME, 'idnotfound');
      throw new BadRequestException('Entity not found');
    }
    return existing;
  }
}
