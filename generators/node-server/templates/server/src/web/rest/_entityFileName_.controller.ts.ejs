<%_
const pkType = primaryKey.tsType;
const idPipe = pkType === 'number' ? 'ParseIntPipe' : primaryKey.typeUUID ? 'ParseUUIDPipe' : undefined;
const idParam = `@Param('id'${idPipe ? `, ${idPipe}` : ''}) id: ${pkType}`;
_%>
import { Body, ClassSerializerInterceptor, Controller, Delete, Get, Logger, NotFoundException, Param,<% if (idPipe) { %> <%= idPipe %>,<% } %> Post as PostMethod, Put, UseGuards, Req, UseInterceptors } from '@nestjs/common';
import { <% if (authenticationTypeJwt) { _%> ApiBearerAuth, <% } else { _%> ApiSecurity, <% } _%> ApiTags, ApiResponse, ApiOperation } from '@nestjs/swagger';
import { <%= dtoClass %> } from '../../service/dto/<%= entityFileName %>.dto.ts';
import { <%= entityClass %>Service } from '../../service/<%= entityFileName %>.service.ts';
<%_ if (pagination !== 'no') { _%>
import { PageRequest, Page } from '../../domain/base/pagination.entity.ts';
<%_ } else { _%>
import { PageRequest } from '../../domain/base/pagination.entity.ts';
<%_ } _%>
import { AuthGuard, RolesGuard } from '../../security/index.ts';
import { HeaderUtil } from '../../common/header-util.ts';
import { isSortableProperty } from '../../common/sortable-properties.ts';
import { Request } from '../../common/request.ts';

import { BadRequestAlertException } from './errors/problem.exception.ts';

const ENTITY_NAME = '<%= entityAlertName %>';
<%_
const sortLabels = relationships
  .filter(relationship => relationship.ownerSide && !relationship.collection && relationship.otherEntityField)
  .map(relationship => `${relationship.propertyName}: '${relationship.otherEntityField}'`);
_%>
/** The label of each relationship to one, the other field a list can be sorted on besides the id. */
const SORT_LABELS: Record<string, string> = { <%- sortLabels.join(', ') %> };

@Controller('api/<%= entityApiUrl %>')
@UseGuards(AuthGuard, RolesGuard)
@UseInterceptors(ClassSerializerInterceptor)
<%_ if (authenticationTypeJwt) { _%>
@ApiBearerAuth()
<%_ } else { _%>
@ApiSecurity({})
<%_ } _%>
@ApiTags('<%= entityApiUrl %>')
export class <%= entityClass %>Controller {
  logger = new Logger('<%= entityClass %>Controller');

  constructor(
    private readonly <%= entityInstance %>Service: <%= entityClass %>Service,
    private readonly headerUtil: HeaderUtil,
  ) {}


  @Get('/')
  @ApiResponse({
    status: 200,
    description: 'List all records',
    type: <%= dtoClass %>,
    isArray: true,
  })
  async getAll(@Req() req: Request): Promise<<%= dtoClass %> []>  {
<%_ for (const relationship of nodejsMappedByRelationships.filter(relationship => relationship.relationshipOneToOne)) { _%>
    // The records without <%= relationship.relationshipName %>, for the form of the other entity, like JHipster Spring Boot.
    if (req.query.filter === '<%- relationship.relationshipName.toLowerCase() %>-is-null') {
      return this.<%= entityInstance %>Service.findAllWhere<%- relationship.relationshipNameCapitalized %>IsNull();
    }
<%_ } _%>
    const pageRequest: PageRequest = new PageRequest(
      req.query.page,
      req.query.size,
      req.query.sort ?? '<%- primaryKey.name %>,ASC',
      property => isSortableProperty(this.<%= entityInstance %>Service.metadata, property, { labels: SORT_LABELS }),
    );
<%_ if (pagination === 'no') { _%>
    // Like JHipster Spring Boot, an entity without pagination lists all its records, without the pagination headers.
    const [results] = await this.<%= entityInstance %>Service.findAndCount({
      order: pageRequest.asOrder(),
    });
    return results;
<%_ } else { _%>
    const [results, count] = await this.<%= entityInstance %>Service.findAndCount({
      skip: +pageRequest.page * pageRequest.size,
      take: +pageRequest.size,
      order: pageRequest.asOrder(),
    });
    this.headerUtil.addPaginationHeaders(req.res, new Page(results, count, pageRequest));
    return results;
<%_ } _%>
  }

  @Get('/:id')
  @ApiResponse({
    status: 200,
    description: 'The found record',
    type: <%= dtoClass %>,
  })
  async getOne(<%- idParam %>): Promise<<%= dtoClass %>>  {
    const <%= entityInstance %>DTO = await this.<%= entityInstance %>Service.findById(id);
    if (!<%= entityInstance %>DTO) {
      throw new NotFoundException();
    }
    return <%= entityInstance %>DTO;
  }

  @PostMethod('/')
  @ApiOperation({ summary: 'Create <%= entityInstance %>' })
  @ApiResponse({
    status: 201,
    description: 'The record has been successfully created.',
    type: <%= dtoClass %>,
  })
  @ApiResponse({ status: 400, description: 'The record already has an id.' })
  @ApiResponse({ status: 403, description: 'Forbidden.' })
  async post(@Req() req: Request, @Body() <%= entityInstance %>DTO: <%= dtoClass %>): Promise<<%= dtoClass %>>  {
    if (<%= entityInstance %>DTO.id !== undefined && <%= entityInstance %>DTO.id !== null) {
      // Like JHipster Spring Boot, a new record cannot have an id: it would update an existing one.
      throw new BadRequestAlertException('A new <%= entityInstance %> cannot already have an ID', ENTITY_NAME, 'idexists');
    }
    const created = await this.<%= entityInstance %>Service.save(<%= entityInstance %>DTO, req.user?.login);
    this.headerUtil.addEntityCreatedHeaders(req.res, ENTITY_NAME, created.id);
    req.res.location(`/api/<%= entityApiUrl %>/${created.id}`);
    return created;
  }

  @Put('/:id')
  @ApiOperation({ summary: 'Update <%= entityInstance %> with id' })
  @ApiResponse({
    status: 200,
    description: 'The record has been successfully updated.',
    type: <%= dtoClass %>,
  })
  @ApiResponse({ status: 400, description: 'Invalid id, or the record does not exist.' })
  async putId(@Req() req: Request, <%- idParam %>, @Body() <%= entityInstance %>DTO: <%= dtoClass %>): Promise<<%= dtoClass %>>  {
    await this.validateIdForUpdate(req, id, <%= entityInstance %>DTO);
    const updated = await this.<%= entityInstance %>Service.update(<%= entityInstance %>DTO, req.user?.login);
    this.headerUtil.addEntityUpdatedHeaders(req.res, ENTITY_NAME, id);
    return updated;
  }

  @Delete('/:id')
  @ApiOperation({ summary: 'Delete <%= entityInstance %>' })
  @ApiResponse({
    status: 204,
    description: 'The record has been successfully deleted.',
  })
  async deleteById(@Req() req: Request, <%- idParam %>): Promise<void>  {
    this.headerUtil.addEntityDeletedHeaders(req.res, ENTITY_NAME, id);
    return await this.<%= entityInstance %>Service.deleteById(id);
  }

  /**
   * Checks the id of an update like JHipster Spring Boot: the body must have the id of the path,
   * and the record must exist, otherwise answers 400.
   */
  private async validateIdForUpdate(req: Request, id: <%= pkType %>, <%= entityInstance %>DTO: Partial<<%= dtoClass %>> | undefined): Promise<<%= dtoClass %>> {
    if (<%= entityInstance %>DTO?.id === undefined || <%= entityInstance %>DTO.id === null) {
      throw new BadRequestAlertException('Invalid id', ENTITY_NAME, 'idnull');
    }
    if (String(<%= entityInstance %>DTO.id) !== String(id)) {
      throw new BadRequestAlertException('Invalid ID', ENTITY_NAME, 'idinvalid');
    }
    const existing = await this.<%= entityInstance %>Service.findById(id);
    if (!existing) {
      throw new BadRequestAlertException('Entity not found', ENTITY_NAME, 'idnotfound');
    }
    return existing;
  }
}
