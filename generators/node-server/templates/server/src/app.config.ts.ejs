import { INestApplication, ValidationPipe } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { CorsOptions } from '@nestjs/common/interfaces/external/cors-options.interface';
import { NextFunction, Request, Response } from 'express';
import { NestExpressApplication } from '@nestjs/platform-express';
<%_ if (authenticationTypeSession || authenticationTypeOauth2) { _%>
import session from 'express-session';
<%_ } _%>

import type { ApplicationConfig } from './application-config.ts';
import { HeaderUtil } from './common/header-util.ts';
import { ProblemDetailsFilter } from './web/rest/errors/problem-details.filter.ts';
import { ValidationException } from './web/rest/errors/problem.exception.ts';
<%_ if (authenticationTypeSession || authenticationTypeOauth2) { _%>
import { SESSION_MAX_AGE } from './security/csrf.middleware.ts';
import { SessionStore } from './security/session.store.ts';
<%_ } _%>

type AppConfigService = ConfigService<ApplicationConfig, true>;

// The paths of the API, which CORS applies to like the WebConfigurer of JHipster Spring Boot.
const CORS_PATHS = [/^\/api\//, /^\/management\//, /^\/v3\/api-docs(\?|$)/];
// The paths of the API as Express routes them: case insensitive, with or without a trailing slash.
const API_PATH = /^\/(?:api|management|v3\/api-docs)(?:\/|$)/i;
const REGEXP_SPECIAL_CHARACTERS = /[.+?^${}()|[\]\\]/g;

function propertyList(value: string | undefined): string[] {
  return String(value ?? '')
    .split(',')
    .map(value => value.trim())
    .filter(Boolean);
}

/**
 * The CORS options of the jhipster.cors properties, like the CorsConfiguration of JHipster Spring Boot: undefined when
 * neither allowed-origins nor allowed-origin-patterns is set (CORS disabled, the default but in the dev profile).
 * A pattern matches any value where it has a *, like https://*.githubpreview.dev; * as methods or headers allows them all.
 */
export function corsOptions(configService: AppConfigService): CorsOptions | undefined {
  const cors = configService.get('jhipster.cors', { infer: true });
  const allowedOrigins = propertyList(cors['allowed-origins']);
  const allowedOriginPatterns = propertyList(cors['allowed-origin-patterns']).map(
    pattern => new RegExp(`^${pattern.replace(REGEXP_SPECIAL_CHARACTERS, '\\$&').replaceAll('*', '.*')}$`),
  );
  if (allowedOrigins.length === 0 && allowedOriginPatterns.length === 0) {
    return undefined;
  }
  const allowedMethods = propertyList(cors['allowed-methods']);
  const allowedHeaders = propertyList(cors['allowed-headers']);
  const maxAge = Number(cors['max-age']);
  const credentials = String(cors['allow-credentials']) === 'true';
  if (credentials && allowedOrigins.includes('*')) {
    // Like the CorsConfiguration of Spring: browsers refuse * as the allowed origin of a request with credentials.
    throw new Error(
      'When jhipster.cors.allow-credentials is true, jhipster.cors.allowed-origins cannot contain *: list the origins, or use jhipster.cors.allowed-origin-patterns',
    );
  }
  return {
    // * allows any origin, like the allowed origins of the CorsConfiguration of Spring (cors compares the origins as given).
    origin: allowedOrigins.includes('*') ? '*' : [...allowedOrigins, ...allowedOriginPatterns],
    // Left out for *: the default methods of cors (all of them), the request headers echoed.
    ...(allowedMethods.includes('*') ? {} : { methods: allowedMethods }),
    ...(allowedHeaders.includes('*') ? {} : { allowedHeaders }),
    exposedHeaders: propertyList(cors['exposed-headers']),
    credentials,
    ...(maxAge > 0 ? { maxAge } : {}),
  };
}

/**
 * A middleware writing the headers of every response, like the default headers of Spring Security and the headers of
 * the SecurityConfiguration of JHipster Spring Boot<% if (!skipClient) { %> (jhipster.security.content-security-policy)<% } %>.
 */
function responseHeaders(<% if (!skipClient) { %>configService: AppConfigService<% } %>): (req: Request, res: Response, next: NextFunction) => void {
<%_ if (!skipClient) { _%>
  const contentSecurityPolicy = String(configService.get('jhipster.security.content-security-policy', { infer: true }) ?? '');
<%_ } _%>
  return (req, res, next) => {
    if (API_PATH.test(req.path)) {
      // The cache control of Spring Security on the responses of the API: not cached (the static files of the client are).
      res.setHeader('Cache-Control', 'no-cache, no-store, max-age=0, must-revalidate');
      res.setHeader('Pragma', 'no-cache');
      res.setHeader('Expires', '0');
    }
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-XSS-Protection', '0');
<%_ if (skipClient) { _%>
    res.setHeader('X-Frame-Options', 'DENY');
<%_ } else { _%>
    if (contentSecurityPolicy) {
      res.setHeader('Content-Security-Policy', contentSecurityPolicy);
    }
    res.setHeader('X-Frame-Options', 'SAMEORIGIN');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader(
      'Permissions-Policy',
      'camera=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), sync-xhr=()',
    );
<%_ } _%>
    if (req.secure) {
      // Like Spring Security, on the HTTPS requests only (the tls profile).
      res.setHeader('Strict-Transport-Security', 'max-age=31536000 ; includeSubDomains');
    }
    next();
  };
}

/**
 * Configures the application as it runs in production: main.ts and the e2e tests call it, so the e2e tests
 * exercise the same validation and HTTP behaviour as the started application.
 * It has no side effect at import (main.ts starts the application when imported), and does not listen.
 */
export function configureApp(app: INestApplication): INestApplication {
  // Without the X-Powered-By: Express header, like the responses of JHipster Spring Boot.
  app.getHttpAdapter().getInstance().disable('x-powered-by');
  const configService = app.get<AppConfigService>(ConfigService);
  app.use(responseHeaders(<% if (!skipClient) { %>configService<% } %>));
  const cors = corsOptions(configService);
  if (cors) {
    app.enableCors((req: Request, callback: (error: Error | null, options: CorsOptions) => void) =>
      callback(null, CORS_PATHS.some(path => path.test(req.url)) ? cors : { origin: false }),
    );
  }
<%_ if (authenticationTypeSession || authenticationTypeOauth2) { _%>
  app.use(
    session({
      secret: configService.get('jhipster.security.session.secret', { infer: true }),
      // The sessions in the database of the application, which outlive a restart and are shared by its instances.
      store: app.get(SessionStore),
      resave: false,
      saveUninitialized: false,
      // Like the session of JHipster Spring Boot, it expires after 30 minutes without requests.
      rolling: true,
      cookie: { httpOnly: true, sameSite: 'lax', secure: 'auto', maxAge: SESSION_MAX_AGE },
    }),
  );
<%_ } _%>
  app.useGlobalPipes(
    new ValidationPipe({
      // The errors of the fields, like JHipster Spring Boot.
      exceptionFactory: errors => new ValidationException(errors),
      // The body is an instance of its DTO without the properties the DTO does not declare, like JHipster Spring Boot
      // binds a request to its DTO and ignores the unknown properties: the declared properties without validation are
      // @Allow(). The instance keeps the properties excluded from the responses only (the password of a registration).
      whitelist: true,
      transform: true,
      // https://github.com/nestjs/nest/issues/10683#issuecomment-1349614194
      forbidUnknownValues: false,
      // The target of an error names the objectName of its field error (ValidationException), which is not sent: Nest
      // 12.2 leaves it out by default.
      validationError: { target: true },
    }),
  );
  // The errors as the problem details of JHipster Spring Boot.
  app.useGlobalFilters(new ProblemDetailsFilter(app.get(HeaderUtil)));
<%_ if (generateUserManagement) { _%>
  // The mail of a password reset request is a text/plain body, as the JHipster clients send it.
  (app as NestExpressApplication).useBodyParser('text');
<%_ } _%>
  // The JSON bodies up to 10 MB, the blobs of the entities as base64 included (the 100 KB default of Express refused an
  // image of about 75 KB with 413).
  (app as NestExpressApplication).useBodyParser('json', { limit: '10mb' });
  // Disable cache.
  app.getHttpAdapter().getInstance().set('etag', false);
  return app;
}
