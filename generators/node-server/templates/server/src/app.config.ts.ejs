import { INestApplication, ValidationPipe } from '@nestjs/common';
import { CorsOptions } from '@nestjs/common/interfaces/external/cors-options.interface';
import { NextFunction, Request, Response } from 'express';
<%_ if (authenticationTypeJwt && generateUserManagement) { _%>
import { NestExpressApplication } from '@nestjs/platform-express';
<%_ } _%>

import { ProblemDetailsFilter } from './web/rest/errors/problem-details.filter.ts';
import { ValidationException } from './web/rest/errors/problem.exception.ts';
import { config } from './config.ts';

// The paths CORS applies to, like the WebConfigurer of JHipster Spring Boot.
const CORS_PATHS = [/^\/api\//, /^\/management\//, /^\/v3\/api-docs(\?|$)/];
const REGEXP_SPECIAL_CHARACTERS = /[.+?^${}()|[\]\\]/g;

function propertyList(key: string): string[] {
  return String(config.get(key) ?? '')
    .split(',')
    .map(value => value.trim())
    .filter(Boolean);
}

/**
 * The CORS options of the jhipster.cors properties, like the CorsConfiguration of JHipster Spring Boot: undefined when
 * neither allowed-origins nor allowed-origin-patterns is set (CORS disabled, the default but in the dev profile).
 * A pattern matches any value where it has a *, like https://*.githubpreview.dev; * as methods or headers allows them all.
 */
export function corsOptions(): CorsOptions | undefined {
  const allowedOrigins = propertyList('jhipster.cors.allowed-origins');
  const allowedOriginPatterns = propertyList('jhipster.cors.allowed-origin-patterns').map(
    pattern => new RegExp(`^${pattern.replace(REGEXP_SPECIAL_CHARACTERS, '\\$&').replaceAll('*', '.*')}$`),
  );
  if (allowedOrigins.length === 0 && allowedOriginPatterns.length === 0) {
    return undefined;
  }
  const allowedMethods = propertyList('jhipster.cors.allowed-methods');
  const allowedHeaders = propertyList('jhipster.cors.allowed-headers');
  const maxAge = Number(config.get('jhipster.cors.max-age'));
  return {
    origin: [...allowedOrigins, ...allowedOriginPatterns],
    // Left out for *: the default methods of cors (all of them), the request headers echoed.
    ...(allowedMethods.includes('*') ? {} : { methods: allowedMethods }),
    ...(allowedHeaders.includes('*') ? {} : { allowedHeaders }),
    exposedHeaders: propertyList('jhipster.cors.exposed-headers'),
    credentials: String(config.get('jhipster.cors.allow-credentials')) === 'true',
    ...(maxAge > 0 ? { maxAge } : {}),
  };
}

/**
 * A middleware writing the headers of every response, like the default headers of Spring Security and the headers of
 * the SecurityConfiguration of JHipster Spring Boot<% if (!skipClient) { %> (jhipster.security.content-security-policy)<% } %>.
 */
function responseHeaders(): (req: Request, res: Response, next: NextFunction) => void {
<%_ if (!skipClient) { _%>
  const contentSecurityPolicy = String(config.get('jhipster.security.content-security-policy') ?? '');
<%_ } _%>
  return (req, res, next) => {
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-XSS-Protection', '0');
<%_ if (skipClient) { _%>
    res.setHeader('X-Frame-Options', 'DENY');
<%_ } else { _%>
    if (contentSecurityPolicy) {
      res.setHeader('Content-Security-Policy', contentSecurityPolicy);
    }
    res.setHeader('X-Frame-Options', 'SAMEORIGIN');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader(
      'Permissions-Policy',
      'camera=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), sync-xhr=()',
    );
<%_ } _%>
    if (req.secure) {
      // Like Spring Security, on the HTTPS requests only (the tls profile).
      res.setHeader('Strict-Transport-Security', 'max-age=31536000 ; includeSubDomains');
    }
    next();
  };
}

/**
 * Configures the application as it runs in production: main.ts and the e2e tests call it, so the e2e tests
 * exercise the same validation and HTTP behaviour as the started application.
 * It has no side effect at import (main.ts starts the application when imported), and does not listen.
 */
export function configureApp(app: INestApplication): INestApplication {
  // Without the X-Powered-By: Express header, like the responses of JHipster Spring Boot.
  app.getHttpAdapter().getInstance().disable('x-powered-by');
  app.use(responseHeaders());
  const cors = corsOptions();
  if (cors) {
    app.enableCors((req: Request, callback: (error: Error | null, options: CorsOptions) => void) =>
      callback(null, CORS_PATHS.some(path => path.test(req.url)) ? cors : { origin: false }),
    );
  }
  app.useGlobalPipes(
    new ValidationPipe({
      // The errors of the fields, like JHipster Spring Boot.
      exceptionFactory: errors => new ValidationException(errors),
      // https://github.com/nestjs/nest/issues/10683#issuecomment-1349614194
      forbidUnknownValues: false,
    }),
  );
  // The errors as the problem details of JHipster Spring Boot.
  app.useGlobalFilters(new ProblemDetailsFilter());
<%_ if (authenticationTypeJwt && generateUserManagement) { _%>
  // The mail of a password reset request is a text/plain body, as the JHipster clients send it.
  (app as NestExpressApplication).useBodyParser('text');
<%_ } _%>
  // Disable cache.
  app.getHttpAdapter().getInstance().set('etag', false);
  return app;
}
