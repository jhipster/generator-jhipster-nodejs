import { INestApplication } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { CorsOptions } from '@nestjs/common/interfaces/external/cors-options.interface';
import { NextFunction, Request, Response } from 'express';
import { NestExpressApplication } from '@nestjs/platform-express';
<%_ if (authenticationUsesCsrf && generateAuthenticationApi) { _%>
import session from 'express-session';
<%_ } _%>

import type { ApplicationConfig } from './application-config.ts';
<%_ if (authenticationUsesCsrf && generateAuthenticationApi) { _%>
import { SessionStore } from './auth/session.store.ts';
<%_ } _%>

type AppConfigService = ConfigService<ApplicationConfig, true>;

// The paths of the API, which CORS applies to like the WebConfigurer of JHipster Spring Boot.
const CORS_PATHS = [/^\/api\//, /^\/management\//, /^\/v3\/api-docs(\?|$)/];
// The paths of the API as Express routes them: case insensitive, with or without a trailing slash.
const API_PATH = /^\/(?:api|management|v3\/api-docs)(?:\/|$)/i;
const REGEXP_SPECIAL_CHARACTERS = /[.+?^${}()|[\]\\]/g;

function propertyList(value: string | undefined): string[] {
  return String(value ?? '')
    .split(',')
    .map(value => value.trim())
    .filter(Boolean);
}

/**
 * The CORS options of the jhipster.cors properties, like the CorsConfiguration of JHipster Spring Boot: undefined when
 * neither allowed-origins nor allowed-origin-patterns is set (CORS disabled, the default but in the dev profile).
 * A pattern matches any value where it has a *, like https://*.githubpreview.dev; * as methods or headers allows them all.
 * Without allowed-methods, GET and HEAD are, the default methods of Spring.
 */
export function corsOptions(configService: AppConfigService): CorsOptions | undefined {
  const cors = configService.get('jhipster.cors', { infer: true });
  const allowedOrigins = propertyList(cors['allowed-origins']);
  const allowedOriginPatterns = propertyList(cors['allowed-origin-patterns']).map(
    pattern => new RegExp(`^${pattern.replace(REGEXP_SPECIAL_CHARACTERS, '\\$&').replaceAll('*', '.*')}$`),
  );
  if (allowedOrigins.length === 0 && allowedOriginPatterns.length === 0) {
    return undefined;
  }
  const configuredMethods = propertyList(cors['allowed-methods']);
  const allowedMethods = configuredMethods.length > 0 ? configuredMethods : ['GET', 'HEAD'];
  const allowedHeaders = propertyList(cors['allowed-headers']);
  const maxAge = Number(cors['max-age']);
  const credentials = String(cors['allow-credentials']) === 'true';
  if (credentials && allowedOrigins.includes('*')) {
    // Like the CorsConfiguration of Spring: browsers refuse * as the allowed origin of a request with credentials.
    throw new Error(
      'When jhipster.cors.allow-credentials is true, jhipster.cors.allowed-origins cannot contain *: list the origins, or use jhipster.cors.allowed-origin-patterns',
    );
  }
  return {
    // * allows any origin, like the allowed origins of the CorsConfiguration of Spring (cors compares the origins as given).
    origin: allowedOrigins.includes('*') ? '*' : [...allowedOrigins, ...allowedOriginPatterns],
    // Left out for *: the method of a preflight request is the one allowed (corsRequestOptions), the request headers echoed.
    ...(allowedMethods.includes('*') ? {} : { methods: allowedMethods }),
    ...(allowedHeaders.includes('*') ? {} : { allowedHeaders }),
    exposedHeaders: propertyList(cors['exposed-headers']),
    credentials,
    ...(maxAge > 0 ? { maxAge } : {}),
    // The status of a preflight request allowed, like Spring.
    optionsSuccessStatus: 200,
  };
}

/** Whether a request is a preflight request of CORS: an OPTIONS with an Origin and the method it asks for. */
const isPreflight = (req: Request): boolean =>
  req.method === 'OPTIONS' && req.headers.origin !== undefined && req.headers['access-control-request-method'] !== undefined;

/** Whether the CORS options allow an origin: one of their origins or patterns, or any for *. */
const allowsOrigin = ({ origin }: CorsOptions, value: string): boolean =>
  origin === '*' ||
  (Array.isArray(origin) && origin.some(allowed => (allowed instanceof RegExp ? allowed.test(value) : allowed === value)));

/** A list of CORS options: undefined for * (all allowed). */
const optionList = (value: string | string[] | undefined): string[] | undefined =>
  value === undefined ? undefined : typeof value === 'string' ? value.split(',') : value;

/**
 * Whether the CORS options allow what a preflight request asks for, like the CorsConfiguration of Spring: its method, and
 * one of its headers at least when it asks for some.
 */
const allowsPreflight = ({ methods, allowedHeaders }: CorsOptions, req: Request): boolean => {
  const allowedMethods = optionList(methods);
  if (allowedMethods !== undefined && !allowedMethods.includes(String(req.headers['access-control-request-method']))) {
    return false;
  }
  const requestHeaders = String(req.headers['access-control-request-headers'] ?? '')
    .split(',')
    .map(header => header.trim().toLowerCase())
    .filter(Boolean);
  const headers = optionList(allowedHeaders)?.map(header => header.toLowerCase());
  return requestHeaders.length === 0 || headers === undefined || requestHeaders.some(header => headers.includes(header));
};

/**
 * The CORS options of a request, like the CorsFilter of JHipster Spring Boot: a request of an allowed origin to a path
 * of the API only, else none of the Access-Control-* headers, and a preflight request of a method or of headers not
 * allowed is refused (preflightRequests). With * as the allowed methods, a preflight request is allowed the method it
 * asks for.
 */
export function corsRequestOptions(cors: CorsOptions, req: Request): CorsOptions {
  const origin = req.headers.origin;
  if (
    origin === undefined ||
    !CORS_PATHS.some(path => path.test(req.url)) ||
    !allowsOrigin(cors, origin) ||
    (isPreflight(req) && !allowsPreflight(cors, req))
  ) {
    return { origin: false };
  }
  const method = req.headers['access-control-request-method'];
  return cors.methods === undefined && typeof method === 'string' ? { ...cors, methods: [method] } : cors;
}

/**
 * The preflight requests cors does not answer, like the CorsFilter of Spring, which answers every one: with CORS, 403 to
 * an origin, a method or headers not allowed on a path of the API, else 200 without headers. They never reach the rules of the paths.
 */
const preflightRequests =
  (corsEnabled: boolean) =>
  (req: Request, res: Response, next: NextFunction): void => {
    if (!isPreflight(req)) {
      next();
    } else if (corsEnabled && CORS_PATHS.some(path => path.test(req.url))) {
      res.status(403).type('text/plain').send('Invalid CORS request');
    } else {
      res.status(200).end();
    }
  };

/** The decoder of the JSON bodies, which refuses a byte sequence that is not UTF-8. */
const UTF8 = new TextDecoder('utf-8', { fatal: true });

/** Refuses a body that is not UTF-8, a SyntaxError like the one of a malformed JSON body (400). */
function rejectInvalidUtf8(_req: unknown, _res: unknown, body: Buffer): void {
  try {
    UTF8.decode(body);
  } catch {
    throw Object.assign(new SyntaxError('The body is not UTF-8'), { status: 400 });
  }
}

/**
 * A middleware writing the headers of every response, like the default headers of Spring Security and the headers of
 * the SecurityConfiguration of JHipster Spring Boot<%- skipClient ? '' : ' (jhipster.security.content-security-policy)' %>.
 */
function responseHeaders(<%- skipClient ? '' : 'configService: AppConfigService' %>): (req: Request, res: Response, next: NextFunction) => void {
<%_ if (!skipClient) { _%>
  const contentSecurityPolicy = String(configService.get('jhipster.security.content-security-policy', { infer: true }) ?? '');
<%_ } _%>
  return (req, res, next) => {
    if (API_PATH.test(req.path)) {
      // The cache control of Spring Security on the responses of the API: not cached (the static files of the client are).
      res.setHeader('Cache-Control', 'no-cache, no-store, max-age=0, must-revalidate');
      res.setHeader('Pragma', 'no-cache');
      res.setHeader('Expires', '0');
    }
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-XSS-Protection', '0');
<%_ if (skipClient) { _%>
    res.setHeader('X-Frame-Options', 'DENY');
<%_ } else { _%>
    if (contentSecurityPolicy) {
      res.setHeader('Content-Security-Policy', contentSecurityPolicy);
    }
    res.setHeader('X-Frame-Options', 'SAMEORIGIN');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader(
      'Permissions-Policy',
      'camera=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), sync-xhr=()',
    );
<%_ } _%>
    if (req.secure) {
      // Like Spring Security, on the HTTPS requests only (the tls profile).
      res.setHeader('Strict-Transport-Security', 'max-age=31536000 ; includeSubDomains');
    }
    next();
  };
}

/**
 * The proxies whose X-Forwarded-* headers (the protocol, the host and the address of the client) the application trusts, the
 * trust proxy setting of Express, like the server.forward-headers-strategy of Spring Boot: none, or native, the proxies of
 * the local networks like the internal proxies of the RemoteIpValve of Tomcat.<% if (authenticationUsesCsrf && generateAuthenticationApi) { %> Behind a proxy of HTTPS, the session cookie is then
 * secure.<% } %>
 */
export function trustProxy(strategy: string | undefined): string | false {
  return strategy === 'native' ? 'loopback, linklocal, uniquelocal' : false;
}

/**
 * Configures the HTTP server of the application as it runs in production: main.ts and the e2e tests call it, so the e2e
 * tests exercise the same HTTP behaviour as the started application (the headers, CORS, the sessions, the body parsers).
 * The validation and the errors are the global providers of the CommonModule. It has no side effect at import (main.ts
 * starts the application when imported), and does not listen.
 */
export function configureApp(app: INestApplication): INestApplication {
  // Without the X-Powered-By: Express header, like the responses of JHipster Spring Boot.
  app.getHttpAdapter().getInstance().disable('x-powered-by');
  const configService = app.get<AppConfigService>(ConfigService);
  (app as NestExpressApplication).set('trust proxy', trustProxy(configService.get('server.forward-headers-strategy', { infer: true })));
  app.use(responseHeaders(<%- skipClient ? '' : 'configService' %>));
  const cors = corsOptions(configService);
  if (cors) {
    app.enableCors((req: Request, callback: (error: Error | null, options: CorsOptions) => void) =>
      callback(null, corsRequestOptions(cors, req)),
    );
  }
  app.use(preflightRequests(cors !== undefined));
<%_ if (authenticationUsesCsrf && generateAuthenticationApi) { _%>
  app.use(
    session({
      // The session cookie of JHipster Spring Boot.
      name: 'JSESSIONID',
      secret: configService.get('jhipster.security.session.secret', { infer: true }),
      // The sessions in the database of the application, which outlive a restart and are shared by its instances.
      store: app.get(SessionStore),
      resave: false,
      saveUninitialized: false,
      // Like the JSESSIONID of JHipster Spring Boot, a cookie until the browser is closed, set when the session is created
      // only: the session expires on the server, after 30 minutes without requests (SessionStore). A cookie set again by
      // every response would let a response of a session ended by a login meanwhile put the ended session back.
      cookie: { httpOnly: true, sameSite: 'lax', secure: 'auto' },
    }),
  );
<%_ } _%>
<%_ if (generateUserManagement) { _%>
  // The mail of a password reset request is a text/plain body, as the JHipster clients send it.
  (app as NestExpressApplication).useBodyParser('text');
<%_ } _%>
  // The JSON bodies up to 10 MB, the blobs of the entities as base64 included (the 100 KB default of Express refused an
  // image of about 75 KB with 413). Like JHipster Spring Boot, application/json and the types of its suffix: the partial
  // updates (PATCH) accept application/merge-patch+json.
  // A body that is not UTF-8 is refused like a malformed one, as the JSON deserialization of Spring does. Nest reserves the
  // verify option of the parser for its rawBody option, which this application does not use, and its type leaves it out:
  // an application created with rawBody: true replaces this verify function, and has to check the UTF-8 of its bodies
  // from req.rawBody.
  const jsonOptions = { limit: '10mb', type: ['json', '+json'], verify: rejectInvalidUtf8 };
  (app as NestExpressApplication).useBodyParser('json', jsonOptions);
  // Disable cache.
  app.getHttpAdapter().getInstance().set('etag', false);
  return app;
}
