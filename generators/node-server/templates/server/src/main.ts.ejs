// The .env file, loaded before the configuration (an import runs before the code of this module).
import 'dotenv/config';
import { NestFactory } from '@nestjs/core';
import { NestExpressApplication } from '@nestjs/platform-express';
<%_ if (serviceDiscoveryEureka) { _%>
import cloudConfigClient from 'cloud-config-client';
<%_ } _%>
import { AppModule } from './app.module.ts';
import { configureApp } from './app.config.ts';
import { setupSwagger } from './swagger.ts';
import { <% if (serviceDiscoveryEureka) { %>activeProfiles, <% } %>config, isProfileActive } from './config.ts';
import { httpsOptions } from './tls.ts';
<%_ if (serviceDiscoveryEureka) { _%>
import { EurekaService } from './service/eureka.service.ts';
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
import { ConsulService } from './service/consul.service.ts';
<%_ } _%>
import { Logger } from '@nestjs/common';
import { LevelsConsoleLogger, loggerLevels } from './common/logging.ts';
<%_ if (!skipClient) { _%>
import * as fs from 'fs';
<%_ } _%>
<%_ if (authenticationType === 'oauth2') { _%>
import passport from 'passport';
import session from 'express-session';
<%_ } _%>
// The levels of the loggers (logging.level.* of the configuration), like Spring Boot, the loggers endpoint changes them.
loggerLevels.configure(config);
const appLogger = new LevelsConsoleLogger();
Logger.overrideLogger(appLogger);
const logger: Logger = new Logger('Main');
const port = process.env.NODE_SERVER_PORT || config.get('server.port');
<%_ if (serviceDiscoveryEureka) { _%>
const useJHipsterRegistry = config.get('eureka.client.enabled');
<%_ } _%>

async function bootstrap(): Promise<void> {
<%_ if (serviceDiscoveryEureka) { _%>
  await loadCloudConfig();
  loggerLevels.configure(config);
<%_ } _%>

  // abortOnError: false: an error of the initialization (the database still unreachable after the retries) rejects
  // to the catch of bootstrap() below, instead of Nest stopping the process by itself.
  const tlsOptions = httpsOptions();
  const app = await NestFactory.create<NestExpressApplication>(AppModule, { abortOnError: false, logger: appLogger, httpsOptions: tlsOptions });
  // Like JHipster Spring Boot, partial updates (PATCH) accept application/json and application/merge-patch+json
  app.useBodyParser('json', { type: ['application/json', 'application/merge-patch+json'] });
  // Close the application (HTTP server, database connections) on SIGTERM, the signal docker stop sends.
  app.enableShutdownHooks();
  // CORS, global validation and HTTP settings, shared with the e2e tests.
  configureApp(app);

  <%_ if (authenticationType === 'oauth2') { _%>
  app.use(
    session({
      secret: config.get('jhipster.security.session.secret'),
      resave: false,
      saveUninitialized: true,
      cookie: { secure: false, maxAge: 240000 }, // 4 minutes and session expires
    }),
  );

  app.use(passport.initialize());
  app.use(passport.session());

  app.use((req: any, res: any, next: any) => {
    if (req.session.user == null && req.path.indexOf(config.get('jhipster.swagger.path')) === 0) {
        return res.redirect('/oauth2/authorization/oidc');
    }
    next();
  });
  <%_ } _%>

  <%_ if (!skipClient) { _%>
  const staticClientPath = config.getClientPath();
  if (fs.existsSync(staticClientPath)) {
    logger.log(`Serving static client resources on ${staticClientPath}`);
  } else {
    logger.log(`No client it has been found`);
  }
  <%_ } else { _%>
    logger.log(`The client is not been generated`);
  <%_ } _%>
  // The API documentation of the api-docs profile, like JHipster Spring Boot.
  if (isProfileActive('api-docs')) {
    setupSwagger(app);
  }

  await app.listen(port);
  logger.log(`Application listening on ${tlsOptions ? 'https' : 'http'} port ${port}`);
<%_ if (serviceDiscoveryEureka) { _%>
  // Registered once it listens, so a gateway routes to the application once it answers.
  app.get(EurekaService).register(Number(port));
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
  // Registered once it listens, so a gateway routes to the application once it answers.
  await app.get(ConsulService).register(Number(port));
<%_ } _%>
}

<%_ if (serviceDiscoveryEureka) { _%>
async function loadCloudConfig(): Promise<void> {
  if (useJHipsterRegistry) {
    const endpoint = config.get('cloud.config.uri') || 'http://admin:admin@localhost:8761/config';
    logger.log(`Loading cloud config from ${endpoint}`);

    const cloudConfig = await cloudConfigClient.load({
      context: process.env,
      endpoint,
      name: config.get('cloud.config.name'),
      // The active profiles, like Spring Cloud Config.
      profiles: activeProfiles,
      // auth: {
      //   user: config.get('jhipster.registry.username') || 'admin',
      //   pass: config.get('jhipster.registry.password') || 'admin'
      // }
    });
    config.addAll(cloudConfig.properties);
  }
}

<%_ } _%>

bootstrap().catch((error: unknown) => {
  // A failed start (database unreachable after the retries, port in use, cloud config not loaded, ...) stops the process
  // with a failure exit code, for the container orchestrator or the process manager to see it and restart it.
  logger.error(`Application failed to start: ${error instanceof Error ? error.message : String(error)}`, error instanceof Error ? error.stack : undefined);
  process.exit(1);
});
