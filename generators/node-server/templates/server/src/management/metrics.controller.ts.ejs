import { Controller, Get, Res, UseGuards } from '@nestjs/common';
import { ApiExcludeController } from '@nestjs/swagger';
import { Response } from 'express';

import { SkipLogging } from '../common/interceptors/logging.interceptor.ts';
import { MetricsService, NodeMetrics } from '../common/metrics.ts';
import { AuthGuard, Roles, RolesGuard, RoleType } from '../auth/index.ts';

/**
 * The metrics endpoints: metrics for the metrics page of the client (administrators only), prometheus for the
 * Prometheus of docker/prometheus (public, like JHipster).
 */
@ApiExcludeController()
@Controller('management')
export class MetricsController {
  constructor(private readonly metricsService: MetricsService) {}

  @Get('/metrics')
  @UseGuards(AuthGuard, RolesGuard)
  @Roles(RoleType.ADMIN)
  metrics(): NodeMetrics {
    return this.metricsService.nodeMetrics();
  }

  @Get('/prometheus')
  @SkipLogging()
  async prometheus(@Res({ passthrough: true }) response: Response): Promise<string> {
    response.type(this.metricsService.registry.contentType);
    return this.metricsService.prometheus();
  }
}
