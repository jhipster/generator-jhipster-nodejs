import { Controller, Get } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { ApiTags, ApiResponse, ApiOperation, ApiExcludeEndpoint } from '@nestjs/swagger';
import { activeProfiles } from '../config.ts';
import { Public } from '../auth/index.ts';
import type { ApplicationConfig } from '../application-config.ts';

/** The info of the info endpoint of Spring Boot Actuator the JHipster clients read: the profiles and the ribbon. */
export interface Info {
  activeProfiles: string[];
  'display-ribbon-on-profiles': string;
}

@Controller('management')
@Public()
@ApiTags('management-controller')
export class ManagementController {

  constructor(private readonly configService: ConfigService<ApplicationConfig, true>) {}

  @ApiExcludeEndpoint()
  @Get('/info')
  @ApiOperation({ summary: 'Microservice Info' })
  @ApiResponse({
    status: 200,
    description: 'Check if the microservice is up',
  })
  info(): Info {
    return {
      activeProfiles,
      'display-ribbon-on-profiles': this.configService.get('info.display-ribbon-on-profiles', { infer: true }),
    };
  }

}
