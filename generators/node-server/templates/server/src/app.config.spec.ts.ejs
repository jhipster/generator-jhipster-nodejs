import { describe, expect, it } from 'vitest';
import { trustProxy } from './app.config.ts';

describe('trustProxy', () => {
  it('trusts no proxy by default, like the forward-headers-strategy none of Spring Boot', () => {
    expect(trustProxy('none')).toBe(false);
    expect(trustProxy(undefined)).toBe(false);
  });

  it('trusts the proxies of the local networks with native, like the internal proxies of the RemoteIpValve of Tomcat', () => {
    expect(trustProxy('native')).toBe('loopback, linklocal, uniquelocal');
  });
});
