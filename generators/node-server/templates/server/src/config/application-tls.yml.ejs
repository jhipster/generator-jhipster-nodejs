# ===================================================================
# Activate this profile to enable TLS (HTTPS).
#
# Provide your own PKCS#12 keystore, for example through the environment:
#   SERVER_SSL_KEY_STORE, SERVER_SSL_KEY_STORE_PASSWORD
# In development, add the "tls-samples" profile instead: it uses the self-signed sample keystore generated by JHipster,
# whose password is public.
# ===================================================================
server:
  ssl:
    enabled: true
    # A path relative to the working directory, or classpath:config/... for a file of the config folder.
    # key-store: /path/to/keystore.p12
    # key-store-password:
    key-store-type: PKCS12
