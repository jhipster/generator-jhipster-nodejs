# ===================================================================
# Configuration.
#
# This configuration will be overridden by the profiles you activate with BACKEND_ENV (a comma separated list),
# for example application-dev.yml if you use the "dev" profile.
#
# More information on profiles: https://www.jhipster.tech/profiles/
# More information on configuration properties: https://www.jhipster.tech/common-application-properties/
# ===================================================================

# ===================================================================
# Standard app properties.
# ===================================================================

profiles:
  # The profiles each profile activates, like spring.profiles.group of Spring Boot.
  group:
    dev:
      - secret-samples
      - api-docs
      # Uncomment to activate TLS for the dev profile
      #- tls
      #- tls-samples
    test:
      - secret-samples

<%_ if (serviceDiscoveryEureka) { _%>
eureka:
  client:
    enabled: false
    fetch-registry: true
    register-with-eureka: true
    instance-info-replication-interval-seconds: 10
    registry-fetch-interval-seconds: 10
  instance:
    appname: <%= baseName %>
    instanceId: <%= baseName %>:${random.value}
    lease-renewal-interval-in-seconds: 5
    lease-expiration-duration-in-seconds: 10
<%_ } _%>
<%_ if (serviceDiscoveryConsul) { _%>
# The registration in Consul, like the spring.cloud.consul properties of JHipster Spring Boot: enabled with
# CLOUD_CONSUL_ENABLED=true, at CLOUD_CONSUL_HOST and CLOUD_CONSUL_PORT.
cloud:
  consul:
    enabled: false
    host: localhost
    port: 8500
    discovery:
      service-name: <%= baseName.toLowerCase() %>
      instance-id: <%= baseName.toLowerCase() %>:${random.value}
      health-check-path: /management/health
      health-check-interval: 10s
      health-check-timeout: 5s
      prefer-ip-address: false
<%_ } _%>

# The management endpoints, like Spring Boot Actuator: the values of the env and configprops endpoints (the
# configuration page of the client) are shown as ****** unless show-values is always.
management:
  endpoint:
    env:
      show-values: never
    configprops:
      show-values: never

# ===================================================================
# JHipster specific properties
#
# Full reference is available at: https://www.jhipster.tech/common-application-properties/
# ===================================================================

jhipster:
  clientApp:
    name: '<%= frontendAppName %>'
  # By default, CORS is disabled. Uncomment to enable.
  # cors:
  #   allowed-origins: "http://localhost:8100,http://localhost:9000"
  #   allowed-methods: "*"
  #   allowed-headers: "*"
  #   exposed-headers: "Authorization,Link,X-Total-Count,X-${jhipster.clientApp.name}-alert,X-${jhipster.clientApp.name}-error,X-${jhipster.clientApp.name}-params"
  #   allow-credentials: true
  #   max-age: 1800
<%_ if (serviceDiscoveryEureka) { _%>
  registry:
    password: admin
<%_ } _%>
  security:
<%_ if (!skipClient) { _%>
    # The Content-Security-Policy header of the responses, like JHipster Spring Boot.
    content-security-policy: "default-src 'self'; frame-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'<%- locals.microfrontend && locals.clientFrameworkAngular ? ' blob:' : '' %> https://storage.googleapis.com; style-src 'self'<%- locals.clientThemeAny ? ' https://fonts.googleapis.com' : '' %> 'unsafe-inline'; img-src 'self' data:; font-src 'self'<%- locals.clientThemeAny ? ' https://fonts.gstatic.com' : '' %> data:"
<%_ } _%>
<%_ if (authenticationType === 'jwt') { _%>
    authentication:
      jwt:
        # The secret of the tokens (base64-secret), a sample of the secret-samples profile: set it in production, with
        # the JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64SECRET environment variable for example.
        # Token is valid 24 hours
        token-validity-in-seconds: 86400
        token-validity-in-seconds-for-remember-me: 2592000
<%_ } else if (authenticationType === 'oauth2') { _%>
    # The session secret and the OAuth2 client, samples of the secret-samples profile: set them in production, with
    # environment variables like JHIPSTER_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENTSECRET.
    oauth2:
      # The audiences of the access tokens the API accepts as bearer tokens, comma separated, like JHipster Spring Boot:
      # account for Keycloak, api://default for Okta.
      audience: account,api://default
<%_ } _%>
  mail:
    from: <%= baseName %>@localhost
  swagger:
    default-include-pattern: /api/.*
    title: <%= baseName %> API
    description: <%= baseName %> API documentation
    version: 0.0.1
    terms-of-service-url:
    contact-name:
    contact-url:
    contact-email:
    license:
    license-url:


# Properties to be exposed on the /management/info endpoint
info:
  # Comma separated list of profiles that will trigger the ribbon to show
  display-ribbon-on-profiles: 'dev'

<%_ if (serviceDiscoveryEureka) { _%>
cloud:
  config:
    uri: http://admin:${jhipster.registry.password}@localhost:8761/config
  # name of the config server's property source (file.yml) that we want to use
    name: <%= baseName %>
    profile: prod # profile(s) of the property source
    label: master # toggle to switch to a different version of the configuration as stored in git
    # it can be set to any label, branch or commit of the configuration source Git repository
<%_ } _%>

