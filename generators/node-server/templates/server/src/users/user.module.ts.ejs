import { Module } from '@nestjs/common';
import { User } from './user.entity.ts';
<%_ if (generateUserManagement) { _%>
import { UserController } from './user.controller.ts';
<%_ } _%>
import { ManagementController } from '../management/management.controller.ts';
import { TypeOrmModule } from '@nestjs/typeorm';
import { UserService } from './user.service.ts';
<%_ if (authenticationTypeSession) { _%>
import { PersistentToken } from '../auth/persistent-token.entity.ts';
import { RememberMeService } from '../auth/remember-me.service.ts';
<%_ } _%>
<%_ if (generateUserManagement) { _%>
import { MailModule } from '../mail/mail.module.ts';
<%_ } _%>

@Module({
  imports: [TypeOrmModule.forFeature([User<%- authenticationTypeSession ? ', PersistentToken' : '' %>])<%- generateUserManagement ? ', MailModule' : '' %>],
  controllers: [<%- generateUserManagement ? 'UserController, ' : '' %>ManagementController],
  providers: [UserService<%- authenticationTypeSession ? ', RememberMeService' : '' %>],
  exports: [UserService<%- authenticationTypeSession ? ', RememberMeService' : '' %><%- generateUserManagement ? ', MailModule' : '' %>],
})
export class UserModule {}
