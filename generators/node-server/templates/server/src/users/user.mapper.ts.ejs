import { Authority } from './authority.entity.ts';
import { <%= user.persistClass %> } from './user.entity.ts';
import { <%= user.dtoClass%> } from './dto/user.dto.ts';

/**
 * An User mapper object: the authorities of the entity, by their names in the DTO.
 */
export class UserMapper {

  static fromDTOtoEntity(userDTO: <%= user.dtoClass%>): <%= user.persistClass %>;
  static fromDTOtoEntity(userDTO: <%= user.dtoClass%> | null | undefined): <%= user.persistClass %> | undefined;
  static fromDTOtoEntity(userDTO: <%= user.dtoClass%> | null | undefined): <%= user.persistClass %> | undefined {
    if (!userDTO) {
      return undefined;
    }
    const { authorities, ...user } = userDTO;
    return Object.assign(new <%= user.persistClass %>(), user, authorities ? { authorities: authorities.map(name => Object.assign(new Authority(), { name })) } : {});
  }

  static fromEntityToDTO(user: <%= user.persistClass %>): <%= user.dtoClass%>;
  static fromEntityToDTO(user: <%= user.persistClass %> | null | undefined): <%= user.dtoClass%> | undefined;
  static fromEntityToDTO(user: <%= user.persistClass %> | null | undefined): <%= user.dtoClass%> | undefined {
    if (!user) {
      return undefined;
    }
    const { authorities, ...userDTO } = user;
    return Object.assign(new <%= user.dtoClass%>(), userDTO, authorities ? { authorities: authorities.map(({ name }) => name) } : {});
  }
}
