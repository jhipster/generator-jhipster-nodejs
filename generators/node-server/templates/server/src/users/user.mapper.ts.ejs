import { <%= user.persistClass %> } from './user.entity.ts';
import { <%= user.dtoClass%> } from './dto/user.dto.ts';

/**
 * An User mapper object.
 */
export class UserMapper {

  static fromDTOtoEntity(userDTO: <%= user.dtoClass%>): <%= user.persistClass %>;
  static fromDTOtoEntity(userDTO: <%= user.dtoClass%> | null | undefined): <%= user.persistClass %> | undefined;
  static fromDTOtoEntity(userDTO: <%= user.dtoClass%> | null | undefined): <%= user.persistClass %> | undefined {
    if (!userDTO) {
      return undefined;
    }
    return Object.assign(new <%= user.persistClass %>(), userDTO);
  }

  static fromEntityToDTO(user: <%= user.persistClass %>): <%= user.dtoClass%>;
  static fromEntityToDTO(user: <%= user.persistClass %> | null | undefined): <%= user.dtoClass%> | undefined;
  static fromEntityToDTO(user: <%= user.persistClass %> | null | undefined): <%= user.dtoClass%> | undefined {
    if (!user) {
      return undefined;
    }
    return Object.assign(new <%= user.dtoClass%>(), user);
  }
}
