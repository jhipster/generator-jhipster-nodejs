import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { EntityMetadata, FindManyOptions, FindOneOptions, Repository } from 'typeorm';
import { <%- user.persistClass %> } from './user.entity.ts';
import { PublicUserDTO, <%- user.dtoClass %> } from './dto/user.dto.ts';
import { UserMapper } from './user.mapper.ts';
<%_ if (databaseTypeMongodb) { _%>
import { documentOrder } from '../common/sortable-properties.ts';
<%_ } _%>
<%_ if (generateUserManagement) { _%>
import { PasswordService } from '../auth/password.service.ts';
<%_ } _%>
<%_ if (authenticationTypeSession) { _%>
import { RememberMeService } from '../auth/remember-me.service.ts';
<%_ } _%>

<%_ if (typeormRelationsSupport) { _%>
const relations = { authorities: true } as const;

<%_ } _%>
@Injectable()
export class UserService {
    constructor(
        @InjectRepository(<%- user.persistClass %>) private userRepository: Repository<<%- user.persistClass %>>,
<%_ if (generateUserManagement) { _%>
        private readonly passwordService: PasswordService,
<%_ } _%>
<%_ if (authenticationTypeSession) { _%>
        private readonly rememberMeService: RememberMeService,
<%_ } _%>
    ) {}

    /** The TypeORM metadata of the user, the sort of the user lists is validated with. */
    get metadata(): EntityMetadata {
        return this.userRepository.metadata;
    }

    async findById(id: <%- user.primaryKey.tsType %>): Promise<<%- user.dtoClass %> | undefined> {
        const result = await this.userRepository.findOneBy({ id });
        return UserMapper.fromEntityToDTO(result)
    }

    async findByFields(options: FindOneOptions<<%- user.persistClass %>>): Promise<<%- user.dtoClass %> | undefined> {
        const result = await this.userRepository.findOne(
<%_ if (typeormRelationsSupport) { _%>
          { ...options, relations },
<%_ } else { _%>
          options,
<%_ } _%>
        );
        return UserMapper.fromEntityToDTO(result);
    }

    async find(options: FindManyOptions<<%- user.persistClass %>>): Promise<<%- user.dtoClass %> | undefined> {
        const result = await this.userRepository.findOne(options);
        return UserMapper.fromEntityToDTO(result);
    }

    async findAndCount(options: FindManyOptions<<%- user.persistClass %>>): Promise<[<%- user.dtoClass %>[], number]> {
        const [users, count] = await this.userRepository.findAndCount(
<%_ if (typeormRelationsSupport) { _%>
          { ...options, relations },
<%_ } else { _%>
          { ...options, order: documentOrder(this.metadata, options.order) },
<%_ } _%>
        );
        return [users.map(user => UserMapper.fromEntityToDTO(user)), count];
    }

    /** The users of the public user list, like JHipster Spring Boot: the activated ones, by their id and login only. */
    async findPublicUsers(options: FindManyOptions<<%- user.persistClass %>>): Promise<[PublicUserDTO[], number]> {
        const [users, count] = await this.userRepository.findAndCount({
          ...options,
<%_ if (databaseTypeMongodb) { _%>
          order: documentOrder(this.metadata, options.order),
<%_ } _%>
          where: { activated: true },
        });
        return [users.map(user => ({ id: user.<%- user.primaryKey.name %>!, login: user.login })), count];
    }

    async save(userDTO: <%- user.dtoClass %>, creator?: string<%- generateUserManagement ? ', updatePassword = false' : '' %>): Promise<<%- user.dtoClass %>> {
        const user = UserMapper.fromDTOtoEntity(userDTO);
<%_ if (generateUserManagement) { _%>
        if (updatePassword) {
            await this.passwordService.transform(user);
        }
<%_ } _%>
        if (creator) {
            if (!user.createdBy ) {
                user.createdBy = creator;
            }
            user.lastModifiedBy = creator;
        }
        const result = await this.userRepository.save(user);
<%_ if (authenticationTypeSession) { _%>
        if (<%- generateUserManagement ? 'updatePassword || ' : '' %>!result.activated) {
            // A new password or a deactivated user ends its remember-me logins.
            await this.rememberMeService.removeOf(result.login);
        }
<%_ } _%>
        return UserMapper.fromEntityToDTO(result);
    }

    async update(userDTO: <%- user.dtoClass %>, updater?: string): Promise<<%- user.dtoClass %>> {
        return this.save(userDTO, updater);
    }

    async delete(userDTO: <%- user.dtoClass %>): Promise<<%- user.dtoClass %> | undefined> {
        const user = UserMapper.fromDTOtoEntity(userDTO);
        const result = await this.userRepository.remove(user)
<%_ if (authenticationTypeSession) { _%>
        await this.rememberMeService.removeOf(userDTO.login);
<%_ } _%>
        return UserMapper.fromEntityToDTO(result);
    }
}
