{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(/e2e/.*|\\.(e2e-spec))\\.(ts)$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "coverageDirectory": "coverage",
  "setupFiles": [
		"./e2e/setup.test.js"
  ],
<%_ if (databaseType === 'mongodb') { _%>
  "globalSetup": "<rootDir>/e2e/global-setup.ts",
<%_ } _%>
  "testTimeout": 10000
}
