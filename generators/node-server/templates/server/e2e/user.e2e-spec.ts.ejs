import { afterEach, beforeEach, describe, expect, it, type MockInstance, vi } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { INestApplication } from '@nestjs/common';
import { AuthGuard } from '../src/auth/guards/auth.guard.ts';
import { RolesGuard } from '../src/auth/guards/roles.guard.ts';
import { <%= user.dtoClass%> } from '../src/users/dto/user.dto.ts';
import { UserService } from '../src/users/user.service.ts';
import { MailService } from '../src/mail/mail.service.ts';
import { comparePassword } from '../src/auth/password-util.ts';
<%_ if (databaseTypeMongodb) { _%>
import { getRepositoryToken } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { User } from '../src/users/user.entity.ts';
<%_ } _%>

describe('User', () => {
    let app: INestApplication;
    let service: UserService;
    let sendCreationEmail: MockInstance<MailService['sendCreationEmail']>;
<%_ if (databaseTypeMongodb) { _%>
    let userRepository: Repository<User>;
<%_ } _%>

    const authGuardMock = { canActivate: (): any => true };
    const rolesGuardMock = { canActivate: (): any => true };

    const testUserRequestObject: any = {
        login: 'userTestLogin',
        firstName: 'UserTest',
        lastName: 'UserTest',
        email: 'usertest@localhost.it'
    };

    const testUserDTO: <%= user.dtoClass%> = {
        login: 'userTestLogin',
        firstName: 'UserTest',
        lastName: 'UserTest',
        email: 'usertest@localhost.it',
        password: 'userTestLogin'
    };

<%_ if (databaseType !== 'mongodb') { _%>
    // The user as the API gives it: without the keys the mails send.
    const withoutKeys = ({ activationKey: _activationKey, resetKey: _resetKey, resetDate: _resetDate, ...user }: Partial<<%= user.dtoClass%>>): Partial<<%= user.dtoClass%>> => user;

<%_ } _%>
    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        })
            .overrideGuard(AuthGuard)
            .useValue(authGuardMock)
            .overrideGuard(RolesGuard)
            .useValue(rolesGuardMock)
            .compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
        service = moduleFixture.get<UserService>(UserService);
        // The mails are not sent, the tests check the users they are for.
        sendCreationEmail = vi.spyOn(moduleFixture.get<MailService>(MailService), 'sendCreationEmail').mockResolvedValue();
<%_ if (databaseTypeMongodb) { _%>
        userRepository = moduleFixture.get<Repository<User>>(getRepositoryToken(User));
<%_ } _%>
    });

    it('/POST create user', async () => {
        const response = await request(app.getHttpServer())
            .post('/api/admin/users')
            .send(testUserRequestObject)
            .expect(201);
        const createdUser: <%= user.dtoClass%> = response.body;

        // Like JHipster Spring Boot, the login in lower case, and the location of the user by its login.
        expect(createdUser.login).toEqual(testUserRequestObject.login.toLowerCase());
        expect(response.headers.location).toBe(`/api/admin/users/${encodeURIComponent(createdUser.login)}`);
        // Like JHipster Spring Boot, an activated user with a random password, and a reset key sent by mail.
        const savedUser = (await service.findByFields({ where: { login: createdUser.login } }))!;
        expect(savedUser.activated).toBe(true);
        expect(savedUser.resetKey).toBeTruthy();
        expect(await comparePassword(testUserRequestObject.login, savedUser.password)).toBe(false);
        expect(sendCreationEmail).toHaveBeenCalledWith(expect.objectContaining({ login: createdUser.login, resetKey: savedUser.resetKey }));
        await service.delete(createdUser);
    });

    it('/POST create user with an id is a bad request, like JHipster Spring Boot', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/admin/users')
                .send({ ...testUserRequestObject, id: <%- databaseTypeMongodb ? "'000000000000000000000042'" : '42' %> })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ message: 'error.idexists', params: 'userManagement' });
        expect(await service.findByFields({ where: { login: testUserRequestObject.login.toLowerCase() } })).toBeFalsy();
    });

    it('/POST create user keeps the fields of the user only: activated, its own keys and audit', async () => {
        const createdUser: <%= user.dtoClass%> = (
            await request(app.getHttpServer())
                .post('/api/admin/users')
                .send({ ...testUserRequestObject, activated: false, password: 'chosenPassword', activationKey: 'chosenKey', resetKey: 'chosenKey', createdBy: 'someone' })
                .expect(201)
        ).body;

        const savedUser = (await service.findByFields({ where: { login: testUserRequestObject.login.toLowerCase() } }))!;
        expect(savedUser.activated).toBe(true);
        expect(savedUser.password).not.toEqual('chosenPassword');
        expect(savedUser.activationKey).toBeFalsy();
        expect(savedUser.resetKey).toEqual(expect.any(String));
        expect(savedUser.resetKey).not.toEqual('chosenKey');
        expect(savedUser.createdBy).not.toEqual('someone');
        await service.delete(createdUser);
    });

    it('/POST create user with the login of another user is a login already used problem', async () => {
        const savedUser = await service.save({ ...testUserDTO, login: 'usedlogin', email: 'usedlogin@localhost.it' });

        const problem = (
            await request(app.getHttpServer())
                .post('/api/admin/users')
                .send({ ...testUserRequestObject, login: 'UsedLogin' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/login-already-used' });
        await service.delete(savedUser);
    });

    it('removes the users not activated 3 days after their registration', async () => {
        const registeredDate = new Date(Date.now() - 4 * 24 * 60 * 60 * 1000);
        const notActivatedUser = await service.save({ ...testUserDTO, login: 'notactivated', email: 'notactivated@localhost.it', activated: false, activationKey: 'notActivatedKey', createdDate: registeredDate });
        const recentUser = await service.save({ ...testUserDTO, login: 'recentuser', email: 'recentuser@localhost.it', activated: false, activationKey: 'recentKey' });

<%_ if (databaseTypeMongodb) { _%>
        // MongoDB gives the date of the creation whatever the saved user has.
        await userRepository.update(notActivatedUser.id!, { createdDate: registeredDate });
<%_ } _%>
        await service.removeNotActivatedUsers();

        expect(await service.findByFields({ where: { login: notActivatedUser.login } })).toBeFalsy();
        expect(await service.findByFields({ where: { login: recentUser.login } })).toBeTruthy();
        await service.delete(recentUser);
    });

    it('/GET public users gives the activated users by their id and login only, like JHipster Spring Boot', async () => {
        const activated = await service.save({ ...testUserDTO, login: 'publicactive', email: 'publicactive@localhost.it', activated: true });
        const inactive = await service.save({ ...testUserDTO, login: 'publicinactive', email: 'publicinactive@localhost.it', activated: false });

        const users: Record<string, unknown>[] = (await request(app.getHttpServer()).get('/api/users?size=2000').expect(200)).body;

        expect(users.find(user => user.login === 'publicactive')).toEqual({ id: expect.anything(), login: 'publicactive' });
        expect(users.map(user => user.login)).not.toContain('publicinactive');
        expect(users.every(user => Object.keys(user).sort().join() === 'id,login')).toBe(true);
        await service.delete(activated);
        await service.delete(inactive);
    });

    it('/GET public users sorted on a property out of the allowed ones is a bad request', () =>
        request(app.getHttpServer()).get('/api/users?sort=password,asc').expect(400));

    it('/POST create user with an invalid email is a validation error', async () => {
        const response = await request(app.getHttpServer())
            .post('/api/admin/users')
            .send({ ...testUserRequestObject, email: 'not an email' })
            .expect(400)
            .expect('Content-Type', /application\/problem\+json/);

        // The problem detail of JHipster Spring Boot, with the errors of the fields.
        expect(response.body).toMatchObject({
            type: 'https://www.jhipster.tech/problem/constraint-violation',
            status: 400,
            message: 'error.validation',
            path: '/api/admin/users',
            fieldErrors: [{ objectName: 'user', field: 'email', message: expect.any(String) }],
        });
    });

    it('/GET all users', async () => {
        const savedUser = await service.save({ ...testUserDTO, login: 'listeduser', email: 'listeduser@localhost.it' });
        const response = await request(app.getHttpServer())
            .get('/api/admin/users')
            .expect(200);

        expect(response.body.map((user: any) => user.login)).toContain(savedUser.login);
        expect(Number(response.headers['x-total-count'])).toBeGreaterThanOrEqual(response.body.length);
    });

    it('/PUT update user', async () => {
        testUserDTO.login = 'TestUserUpdate';
        const { password: _savedPassword, lastModifiedDate: _savedLastModifiedDate, ...savedUser } = await service.save(testUserDTO);
        savedUser.firstName = 'Updated Name';

        const { password: _updatedPassword, lastModifiedDate: _updatedLastModifiedDate, ...updatedUser } = (
            await request(app.getHttpServer())
                .put('/api/admin/users')
                .send(savedUser)
                .expect(200)
        ).body;

        <%_ if (databaseType !== 'mongodb') { _%>
        // Like JHipster Spring Boot, the login in lower case.
        expect(updatedUser).toEqual(JSON.parse(JSON.stringify(withoutKeys({ ...savedUser, login: savedUser.login.toLowerCase() }))));
        <%_ } else { _%>
        expect(updatedUser.firstName).toEqual(savedUser.firstName);
        <%_ } _%>

        await service.delete(savedUser as <%= user.dtoClass%>);
    });

    it('/PUT update user with a login name', async () => {
        testUserDTO.login = 'TestUserUpdateLogin';
        const { password: _savedPassword, lastModifiedDate: _savedLastModifiedDate, ...savedUser } = await service.save(testUserDTO);
        savedUser.firstName = 'Updated Name';

        const { password: _updatedPassword, lastModifiedDate: _updatedLastModifiedDate, ...updatedUser } = (
            await request(app.getHttpServer())
                .put('/api/admin/users/' + savedUser.login)
                .send(savedUser)
                .expect(200)
        ).body;

        <%_ if (databaseType !== 'mongodb') { _%>
        // Like JHipster Spring Boot, the login in lower case.
        expect(updatedUser).toEqual(JSON.parse(JSON.stringify(withoutKeys({ ...savedUser, login: savedUser.login.toLowerCase() }))));
        <%_ } else { _%>
        expect(updatedUser.firstName).toEqual(savedUser.firstName);
        <%_ } _%>

        await service.delete(savedUser as <%= user.dtoClass%>);
    });

    it('/PUT update user keeps the password and the keys of the user', async () => {
        testUserDTO.login = 'testuserkeep';
        const savedUser = await service.save({ ...testUserDTO, resetKey: 'savedKey' });

        await request(app.getHttpServer())
            .put('/api/admin/users')
            .send({ ...savedUser, firstName: 'Updated Name', password: 'chosenPassword', resetKey: 'chosenKey' })
            .expect(200);

        const updatedUser = (await service.findByFields({ where: { login: 'testuserkeep' } }))!;
        expect(updatedUser.firstName).toEqual('Updated Name');
        expect(updatedUser.password).toEqual(savedUser.password);
        expect(updatedUser.resetKey).toEqual('savedKey');
        await service.delete(updatedUser);
    });

    it('/PUT update an unknown user is not found, like JHipster Spring Boot', () =>
        request(app.getHttpServer())
            .put('/api/admin/users')
            .send({ ...testUserRequestObject, login: 'unknownuser', email: 'unknownuser@localhost.it', id: <%- databaseTypeMongodb ? "'000000000000000000000042'" : '42' %> })
            .expect(404));

    it('/GET user with a login name gives its authorities', async () => {
        testUserDTO.login = 'testusergetauthorities';
        const savedUser = await service.save({ ...testUserDTO, authorities: ['ROLE_USER'] });

        const getUser: <%= user.dtoClass%> = (await request(app.getHttpServer()).get('/api/admin/users/testusergetauthorities').expect(200)).body;

        expect(getUser.authorities).toEqual(['ROLE_USER']);
        await service.delete(savedUser);
    });

    it('/GET user with a login name', async () => {
        testUserDTO.login = 'TestUserGet';
        const savedUser: <%= user.dtoClass%> = await service.save(testUserDTO);
        <%_ if (databaseType !== 'mongodb') { _%>
        const { password: _password, ...savedUserWithoutPassword } = savedUser;
        <%_ } _%>

        const getUser: <%= user.dtoClass%> = (
            await request(app.getHttpServer())
                .get('/api/admin/users/' + savedUser.login)
                .expect(200)
        ).body;

        <%_ if (databaseType !== 'mongodb') { _%>
        expect(getUser).toEqual(JSON.parse(JSON.stringify({ ...withoutKeys(savedUserWithoutPassword), authorities: [] })));
        <%_ } else { _%>
        expect(getUser.login).toEqual(savedUser.login);
        <%_ } _%>

        await service.delete(savedUser);
    });

    it('/DELETE user', async () => {
        testUserDTO.login = 'TestUserDelete';
        const savedUser: <%= user.dtoClass%> = await service.save(testUserDTO);

        await request(app.getHttpServer())
            .delete('/api/admin/users/' + savedUser.login)
            .expect(204);

        const userUndefined = await service.findById(savedUser.id!);
        expect(userUndefined).toBeUndefined();
    });

    it('/GET users sorted on a property of the user', async () => {
        await request(app.getHttpServer()).get('/api/admin/users?sort=login,desc').expect(200);
        await request(app.getHttpServer()).get('/api/admin/users?sort=createdDate,asc').expect(200);
    });

    it('/GET users sorted on the password or a key of the user', async () => {
        for (const property of ['password', 'activationKey', 'resetKey']) {
            const response = await request(app.getHttpServer()).get(`/api/admin/users?sort=${property},asc`).expect(400);
            expect(response.body.detail).toBe(`Invalid sort property: ${property}`);
        }
    });

    afterEach(async () => {
        await app?.close();
    });
});
