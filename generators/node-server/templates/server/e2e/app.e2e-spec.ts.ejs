import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { INestApplication } from '@nestjs/common';
<%_ if (authenticationType === 'jwt') { _%>
import { JwtService } from '@nestjs/jwt';
<%_ } _%>
<%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
import { UserLoginDTO } from '../src/service/dto/user-login.dto.ts';
<%_ } else if (authenticationType === 'jwt') { _%>
import { ConfigService } from '@nestjs/config';
import { JWT_ALGORITHM, jwtSecretKey } from '../src/security/jwt.config.ts';
<%_ } _%>

describe('App', () => {
    let app: INestApplication;

    // The test profile and the profiles of its group (application.yml).
    const infoService = {
        activeProfiles: ['test', 'secret-samples'],
        'display-ribbon-on-profiles': 'dev',
    };
<%_  if (authenticationType === 'jwt' && generateUserManagement) { _%>
    const testUserLogin: UserLoginDTO = {
        username: 'admin',
        password: 'admin',
        rememberMe: true
    };
<%_ } else if (authenticationType === 'oauth2') { _%>

    const testRequest: any = {};
<%_ }_%>

    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        }).compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
    });

    it('/GET up running info OK', () => request(app.getHttpServer())
        .get('/management/info')
        .expect(200)
        .expect(infoService));

    it('/GET health is UP without authentication', () => request(app.getHttpServer())
        .get('/management/health')
        .expect(200)
        .expect({ status: 'UP', components: { db: { status: 'UP' } } }));

    it('/GET the liveness and readiness probes are UP without authentication', async () => {
        await request(app.getHttpServer()).get('/management/health/liveness').expect(200).expect({ status: 'UP' });
        await request(app.getHttpServer()).get('/management/health/readiness').expect(200).expect({ status: 'UP' });
    });

<%_ if (generateBuiltInUserEntity) { _%>
    it('/GET public roles OK', () => request(app.getHttpServer())
        .get('/api/authorities')
        .expect(200));

<%_ } _%>
<%_ if (generateBuiltInUserEntity && authenticationTypeJwt) { _%>

    it('/GET public users without authentication is unauthorized, like JHipster Spring Boot', () => request(app.getHttpServer())
        .get('/api/users')
        .expect(401));
<%_ } _%>

    <%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
    it<%- databaseTypeMongodb ? '.skip' : ''%>('/POST authenticate get jwt authenticate OK', () => request(app.getHttpServer())
        .post('/api/authenticate')
        .send(testUserLogin)
        .expect(200));

    it('/POST authenticate without credentials is a validation error', () => request(app.getHttpServer())
        .post('/api/authenticate')
        .send({})
        .expect(400)
        .expect(response => expect(response.body).toMatchObject({ message: 'error.validation', fieldErrors: expect.arrayContaining([expect.objectContaining({ field: 'username' })]) })));

    it('/GET account with an expired jwt is unauthorized', () => {
        const expiredToken = app.get(JwtService).sign({ sub: 'admin', auth: '' }, { expiresIn: -10 });
        return request(app.getHttpServer())
            .get('/api/account')
            .set('Authorization', `Bearer ${expiredToken}`)
            .expect(401);
    });
    <%_ } else if (authenticationType === 'jwt') { _%>
    describe('with a token of the gateway', () => {
        // Signed like a JHipster Spring Boot gateway: HS512 with the base64 decoded secret, login as subject, authorities in auth.
        const gatewayJwtService = (): JwtService =>
            new JwtService({ secret: jwtSecretKey(app.get(ConfigService)), signOptions: { algorithm: JWT_ALGORITHM } });

        it('/GET account is the user of the token', () => {
            const token = gatewayJwtService().sign({ sub: 'gateway-user', auth: 'ROLE_USER ROLE_ADMIN', userId: 1 });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${token}`)
                .expect(200)
                .expect(res => expect(res.body).toMatchObject({ login: 'gateway-user', authorities: ['ROLE_USER', 'ROLE_ADMIN'] }));
        });

        it('/GET account without a token is unauthorized', () => request(app.getHttpServer())
            .get('/api/account')
            .expect(401));

        it('/GET account with an expired token is unauthorized', () => {
            const expiredToken = gatewayJwtService().sign({ sub: 'gateway-user', auth: '' }, { expiresIn: -10 });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${expiredToken}`)
                .expect(401);
        });

        it('/GET account with a token signed with the encoded secret is unauthorized', () => {
            const encodedSecret = app.get(ConfigService).getOrThrow<string>('jhipster.security.authentication.jwt.base64-secret');
            const token = new JwtService({ secret: encodedSecret }).sign({ sub: 'gateway-user', auth: 'ROLE_USER' });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${token}`)
                .expect(401);
        });
    });
    <%_ } else if (authenticationType === 'oauth2') { _%>
    it('/POST security oauth2 does not perform logout', () => request(app.getHttpServer())
        .post('/api/logout')
        .send(testRequest)
        .expect({})
        .expect(201));

    it('/GET account not logged', () => request(app.getHttpServer())
        .get('/api/account')
        .expect(200)
        .expect({}));
    <%_ } _%>

    afterEach(async () => {
        await app?.close();
    });
});
