import { afterEach, beforeEach, describe, expect, it } from '@jest/globals';
import { Test, TestingModule } from '@nestjs/testing';
import request = require('supertest');
import { AppModule } from '../src/app.module';
import { INestApplication } from '@nestjs/common';
<%_ if (authenticationType === 'jwt') { _%>
import { JwtService } from '@nestjs/jwt';
<%_ } _%>
<%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
import { UserLoginDTO } from '../src/service/dto/user-login.dto';
<%_ } else if (authenticationType === 'jwt') { _%>
import { config } from '../src/config';
<%_ } _%>

describe('App', () => {
    let app: INestApplication;

    const infoService = {
         activeProfiles : 'dev',
        'display-ribbon-on-profiles': 'dev',
    };
<%_  if (authenticationType === 'jwt' && generateUserManagement) { _%>
    const testUserLogin: UserLoginDTO = {
        username: 'system',
        password: 'system',
        rememberMe: true
    };
<%_ } else if (authenticationType === 'oauth2') { _%>

    const testRequest: any = {};
<%_ }_%>

    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        }).compile();

        app = moduleFixture.createNestApplication();
        await app.init();
    });

    it('/GET up running info OK', () => request(app.getHttpServer())
        .get('/management/info')
        .expect(200)
        .expect(infoService));

<%_ if (generateBuiltInUserEntity) { _%>
    it('/GET public roles OK', () => request(app.getHttpServer())
        .get('/api/authorities')
        .expect(200));

    it('/GET public users OK', () => request(app.getHttpServer())
        .get('/api/users')
        .expect(200));
<%_ } _%>

    <%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
    it<%- databaseTypeMongodb ? '.skip' : ''%>('/POST authenticate get jwt authenticate OK', () => request(app.getHttpServer())
        .post('/api/authenticate')
        .send(testUserLogin)
        .expect(200));

    it('/GET account with an expired jwt is unauthorized', () => {
        const expiredToken = app.get(JwtService).sign({ id: 1, username: 'system', authorities: [] }, { expiresIn: -10 });
        return request(app.getHttpServer())
            .get('/api/account')
            .set('Authorization', `Bearer ${expiredToken}`)
            .expect(401);
    });
    <%_ } else if (authenticationType === 'jwt') { _%>
    describe('with a token of the gateway', () => {
        const jwtService = new JwtService({ secret: config['jhipster.security.authentication.jwt.base64-secret'] });

        it('/GET account is the user of the token', () => {
            const token = jwtService.sign({ id: 1, username: 'gateway-user', authorities: ['ROLE_USER'] });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${token}`)
                .expect(200)
                .expect(res => expect(res.body).toMatchObject({ login: 'gateway-user', authorities: ['ROLE_USER'] }));
        });

        it('/GET account without a token is unauthorized', () => request(app.getHttpServer())
            .get('/api/account')
            .expect(401));

        it('/GET account with an expired token is unauthorized', () => {
            const expiredToken = jwtService.sign({ id: 1, username: 'gateway-user', authorities: [] }, { expiresIn: -10 });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${expiredToken}`)
                .expect(401);
        });
    });
    <%_ } else if (authenticationType === 'oauth2') { _%>
    it('/POST security oauth2 does not perform logout', () => request(app.getHttpServer())
        .post('/api/logout')
        .send(testRequest)
        .expect({})
        .expect(201));

    it('/GET account not logged', () => request(app.getHttpServer())
        .get('/api/account')
        .expect(200)
        .expect({}));
    <%_ } _%>

    afterEach(async () => {
        await app?.close();
    });
});
