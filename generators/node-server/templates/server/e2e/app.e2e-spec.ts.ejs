import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from '<%- authenticationTypeSession ? './csrf-request.ts' : 'supertest' %>';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { INestApplication } from '@nestjs/common';
<%_ if (authenticationType === 'jwt') { _%>
import { JwtService } from '@nestjs/jwt';
<%_ } _%>
<%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
import { UserLoginDTO } from '../src/auth/dto/user-login.dto.ts';
<%_ } else if (authenticationType === 'jwt') { _%>
import { ConfigService } from '@nestjs/config';
import { JWT_ALGORITHM, jwtSecretKey } from '../src/auth/jwt.config.ts';
<%_ } else if (authenticationType === 'oauth2' && generateBuiltInUserEntity) { _%>
import { oidcUserOfClaims } from '../src/auth/oauth2.authorities.ts';
import { AuthService } from '../src/auth/auth.service.ts';
import { UserService } from '../src/users/user.service.ts';
<%_ } _%>

describe('App', () => {
    let app: INestApplication;

    // The test profile and the profiles of its group (application.yml).
    const infoService = {
        activeProfiles: ['test', 'secret-samples'],
        'display-ribbon-on-profiles': 'dev',
    };
<%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
    const testUserLogin: UserLoginDTO = {
        username: 'admin',
        password: 'admin',
        rememberMe: true
    };
<%_ } _%>

    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        }).compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
    });

    it('/GET up running info OK', () => request(app.getHttpServer())
        .get('/management/info')
        .expect(200)
        .expect(infoService));

    it('/GET the headers of the responses, like JHipster Spring Boot', async () => {
        const response = await request(app.getHttpServer())
            .get('/management/info')
            .expect(200)
            .expect('Cache-Control', 'no-cache, no-store, max-age=0, must-revalidate')
            .expect('Pragma', 'no-cache')
            .expect('Expires', '0')
            .expect('X-Content-Type-Options', 'nosniff')
            .expect('X-XSS-Protection', '0')
<%_ if (skipClient) { _%>
            .expect('X-Frame-Options', 'DENY');
<%_ } else { _%>
            .expect('X-Frame-Options', 'SAMEORIGIN')
            .expect('Referrer-Policy', 'strict-origin-when-cross-origin')
            .expect('Content-Security-Policy', /^default-src 'self';/)
            .expect('Permissions-Policy', /camera=\(\)/);
<%_ } _%>
        expect(response.headers['x-powered-by']).toBeUndefined();
        // Only on HTTPS requests.
        expect(response.headers['strict-transport-security']).toBeUndefined();
    });

    it('/GET the API is not cached whatever the case of its path, like Express routes it', () => request(app.getHttpServer())
        .get('/MANAGEMENT/info')
        .expect(200)
        .expect('Cache-Control', 'no-cache, no-store, max-age=0, must-revalidate'));

    it('/GET an unknown path of the API is unauthorized without authentication, like JHipster Spring Boot, not the client', () => request(app.getHttpServer())
        .get('/api/unknown-resource')
        .expect(401));

    it('/GET health is UP without authentication', () => request(app.getHttpServer())
        .get('/management/health')
        .expect(200)
        .expect({ status: 'UP', components: { db: { status: 'UP' } } }));

    it('/GET the liveness and readiness probes are UP without authentication', async () => {
        await request(app.getHttpServer()).get('/management/health/liveness').expect(200).expect({ status: 'UP' });
        await request(app.getHttpServer()).get('/management/health/readiness').expect(200).expect({ status: 'UP' });
    });

<%_ if (generateUserManagement) { _%>
    it('/GET the authorities without authentication is unauthorized, like JHipster Spring Boot', () => request(app.getHttpServer())
        .get('/api/authorities')
        .expect(401));

    it('/GET public users without authentication is unauthorized, like JHipster Spring Boot', () => request(app.getHttpServer())
        .get('/api/users')
        .expect(401));
<%_ } _%>

<%_ if (authenticationType === 'jwt' && generateUserManagement) { _%>
    it<%- databaseTypeMongodb ? '.skip' : '' %>('/POST authenticate get jwt authenticate OK', () => request(app.getHttpServer())
        .post('/api/authenticate')
        .send(testUserLogin)
        .expect(200));

    it('/POST authenticate without credentials is a validation error', () => request(app.getHttpServer())
        .post('/api/authenticate')
        .send({})
        .expect(400)
        .expect(response => expect(response.body).toMatchObject({ message: 'error.validation', fieldErrors: expect.arrayContaining([expect.objectContaining({ field: 'username' })]) })));

    it('/POST authenticate with a blank login or a too short password is a validation error, like the LoginVM of JHipster Spring Boot', async () => {
        const { body } = await request(app.getHttpServer()).post('/api/authenticate').send({ username: '', password: 'abc' }).expect(400);
        expect(body).toMatchObject({ message: 'error.validation' });
        expect(body.fieldErrors.map(({ field }: { field: string }) => field).sort()).toEqual(['password', 'username']);
    });

    it('/GET account with an expired jwt is unauthorized', () => {
        const expiredToken = app.get(JwtService).sign({ sub: 'admin', auth: '' }, { expiresIn: -10 });
        return request(app.getHttpServer())
            .get('/api/account')
            .set('Authorization', `Bearer ${expiredToken}`)
            .expect(401)
            .expect('WWW-Authenticate', /^Bearer error="invalid_token", error_description="The access token expired", /);
    });
<%_ } _%>
<%_ if (authenticationType === 'jwt') { _%>

    it('/GET a public path with an invalid jwt is unauthorized, like the bearer token filter of Spring Security', () => request(app.getHttpServer())
        .get('/management/info')
        .set('Authorization', 'Bearer invalid')
        .expect(401)
        .expect('WWW-Authenticate', /^Bearer error="invalid_token", error_description="The access token is invalid", error_uri="https:\/\/tools\.ietf\.org\/html\/rfc6750#section-3\.1", resource_metadata="http:\/\/127\.0\.0\.1:\d+\/\.well-known\/oauth-protected-resource"$/));
<%_ } _%>
<%_ if (authenticationType === 'jwt' && !generateUserManagement) { _%>
    describe('with a token of the gateway', () => {
        // Signed like a JHipster Spring Boot gateway: HS512 with the base64 decoded secret, login as subject, authorities in auth.
        const gatewayJwtService = (): JwtService =>
            new JwtService({ secret: jwtSecretKey(app.get(ConfigService)), signOptions: { algorithm: JWT_ALGORITHM } });

  <%_ if (generateAuthenticationApi) { _%>
        it('/GET account is the user of the token', () => {
            const token = gatewayJwtService().sign({ sub: 'gateway-user', auth: 'ROLE_USER ROLE_ADMIN', userId: 1 });
            return request(app.getHttpServer())
                .get('/api/account')
                .set('Authorization', `Bearer ${token}`)
                .expect(200)
                .expect(res => expect(res.body).toMatchObject({ login: 'gateway-user', authorities: ['ROLE_USER', 'ROLE_ADMIN'] }));
        });
  <%_ } else { _%>
        // A microservice has no account API, like JHipster Spring Boot: a route of an administrator instead.
        it('/GET a route of an administrator is for the authorities of the token', async () => {
            const admin = gatewayJwtService().sign({ sub: 'gateway-user', auth: 'ROLE_USER ROLE_ADMIN', userId: 1 });
            await request(app.getHttpServer()).get('/management/env').set('Authorization', `Bearer ${admin}`).expect(200);
            const user = gatewayJwtService().sign({ sub: 'gateway-user', auth: 'ROLE_USER', userId: 1 });
            await request(app.getHttpServer()).get('/management/env').set('Authorization', `Bearer ${user}`).expect(403);
        });
  <%_ } _%>

        it('/GET a protected route without a token is unauthorized', () => request(app.getHttpServer())
            .get('<%- generateAuthenticationApi ? '/api/account' : '/management/env' %>')
            .expect(401));

        it('/GET a protected route with an expired token is unauthorized', () => {
            const expiredToken = gatewayJwtService().sign({ sub: 'gateway-user', auth: '' }, { expiresIn: -10 });
            return request(app.getHttpServer())
                .get('<%- generateAuthenticationApi ? '/api/account' : '/management/env' %>')
                .set('Authorization', `Bearer ${expiredToken}`)
                .expect(401);
        });

        it('/GET a protected route with a token signed with the encoded secret is unauthorized', () => {
            const encodedSecret = app.get(ConfigService).getOrThrow<string>('jhipster.security.authentication.jwt.base64-secret');
            const token = new JwtService({ secret: encodedSecret }).sign({ sub: 'gateway-user', auth: 'ROLE_USER' });
            return request(app.getHttpServer())
                .get('<%- generateAuthenticationApi ? '/api/account' : '/management/env' %>')
                .set('Authorization', `Bearer ${token}`)
                .expect(401);
        });
    });
<%_ } else if (authenticationType === 'oauth2') { _%>
    it('/POST logout without authentication is unauthorized, like JHipster Spring Boot', () => request(app.getHttpServer())
        .post('/api/logout')
        .send({})
        .expect(401));

  <%_ if (generateAuthenticationApi) { _%>
    it('/GET account not logged', () => request(app.getHttpServer())
        .get('/api/account')
        // Like JHipster Spring Boot, the clients take a 401 for not logged.
        .expect(401));
  <%_ } _%>
  <%_ if (generateBuiltInUserEntity) { _%>

    it('saves the user of the identity provider at its logins, without a password, like JHipster Spring Boot', async () => {
        const authService = app.get(AuthService);
        await authService.findUserOrSave(oidcUserOfClaims({ sub: 'idp-user', preferred_username: 'IdP-User', groups: ['ROLE_USER'] }));
        await authService.findUserOrSave(oidcUserOfClaims({ sub: 'idp-user', preferred_username: 'idp-user', given_name: 'Updated', groups: ['ROLE_USER'] }));

        const saved = await app.get(UserService).findByFields({ where: { login: 'idp-user' } });
        expect(saved).toMatchObject({ login: 'idp-user', firstName: 'Updated', email: 'idp-user@localhost', activated: true });
    });
  <%_ } _%>
<%_ } _%>

    afterEach(async () => {
        await app?.close();
    });
});
