import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
import { INestApplication } from '@nestjs/common';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { config } from '../src/config.ts';

describe('CORS', () => {
    let app: INestApplication;

    const createApp = async (properties: Record<string, any>): Promise<void> => {
        config.addAll(properties);
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        }).compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
    };

    afterEach(async () => {
        config.addAll({ 'jhipster.cors.allowed-origins': '', 'jhipster.cors.allowed-origin-patterns': '', 'jhipster.cors.allow-credentials': false });
        await app?.close();
    });

    describe('without allowed origins, like the test and prod profiles', () => {
        beforeEach(() => createApp({}));

        it('does not allow other origins', async () => {
            const response = await request(app.getHttpServer()).get('/management/health').set('Origin', 'http://localhost:9000').expect(200);
            if (response.headers['access-control-allow-origin'] !== undefined) {
                throw new Error(`Unexpected Access-Control-Allow-Origin: ${response.headers['access-control-allow-origin']}`);
            }
        });

        it('answers a preflight request 200 without headers, like the CorsFilter of Spring', async () => {
            const response = await request(app.getHttpServer())
                .options('/api/account')
                .set('Origin', 'http://localhost:9000')
                .set('Access-Control-Request-Method', 'GET')
                .expect(200);
            expect(Object.keys(response.headers).filter(name => name.startsWith('access-control-'))).toEqual([]);
        });
    });

    describe('with the properties of the dev profile', () => {
        beforeEach(() =>
            createApp({
                'jhipster.cors.allowed-origins': 'http://localhost:9000',
                'jhipster.cors.allowed-origin-patterns': 'https://*.githubpreview.dev',
                'jhipster.cors.allowed-methods': '*',
                'jhipster.cors.allowed-headers': '*',
                'jhipster.cors.exposed-headers': 'Authorization,Link,X-Total-Count',
                'jhipster.cors.allow-credentials': true,
                'jhipster.cors.max-age': 1800,
            }),
        );

        it('allows an allowed origin on /management', () =>
            request(app.getHttpServer())
                .get('/management/health')
                .set('Origin', 'http://localhost:9000')
                .expect(200)
                .expect('Access-Control-Allow-Origin', 'http://localhost:9000')
                .expect('Access-Control-Allow-Credentials', 'true')
                .expect('Access-Control-Expose-Headers', 'Authorization,Link,X-Total-Count'));

        it('allows an origin of a pattern on a preflight request of /api, the method it asks for', () =>
            request(app.getHttpServer())
                .options('/api/account')
                .set('Origin', 'https://my-codespace.githubpreview.dev')
                .set('Access-Control-Request-Method', 'POST')
                .set('Access-Control-Request-Headers', 'authorization,content-type')
                .expect(200)
                .expect('Access-Control-Allow-Origin', 'https://my-codespace.githubpreview.dev')
                .expect('Access-Control-Allow-Methods', 'POST')
                .expect('Access-Control-Allow-Headers', 'authorization,content-type')
                .expect('Access-Control-Max-Age', '1800'));

        it('gives no Access-Control-* header to another origin, like the CorsFilter of Spring', async () => {
            const response = await request(app.getHttpServer()).get('/management/health').set('Origin', 'http://other.example.com').expect(200);
            expect(Object.keys(response.headers).filter(name => name.startsWith('access-control-'))).toEqual([]);
            const preflight = await request(app.getHttpServer())
                .options('/api/account')
                .set('Origin', 'http://other.example.com')
                .set('Access-Control-Request-Method', 'GET')
                .expect(403);
            expect(preflight.text).toBe('Invalid CORS request');
            expect(Object.keys(preflight.headers).filter(name => name.startsWith('access-control-'))).toEqual([]);
        });

        it('answers a preflight request out of the paths of the API without headers, like the CorsFilter of Spring', async () => {
            const response = await request(app.getHttpServer())
                .options('/nothing')
                .set('Origin', 'http://localhost:9000')
                .set('Access-Control-Request-Method', 'GET')
                .expect(200);
            expect(Object.keys(response.headers).filter(name => name.startsWith('access-control-'))).toEqual([]);
        });

        it('answers an OPTIONS without Origin as any request, not a CORS one', async () => {
            const response = await request(app.getHttpServer()).options('/api/account').expect(401);
            expect(Object.keys(response.headers).filter(name => name.startsWith('access-control-'))).toEqual([]);
        });
    });

    describe('with * as allowed origins, without credentials', () => {
        beforeEach(() => createApp({ 'jhipster.cors.allowed-origins': '*', 'jhipster.cors.allow-credentials': false }));

        it('allows any origin, like the CorsConfiguration of Spring', async () => {
            const response = await request(app.getHttpServer())
                .get('/management/health')
                .set('Origin', 'http://any.example.com')
                .expect(200)
                .expect('Access-Control-Allow-Origin', '*');
            expect(response.headers['access-control-allow-credentials']).toBeUndefined();
        });
    });

    it('refuses * as allowed origins with credentials, which browsers refuse, like the CorsConfiguration of Spring', async () => {
        await expect(createApp({ 'jhipster.cors.allowed-origins': '*', 'jhipster.cors.allow-credentials': true })).rejects.toThrow(
            /allowed-origin-patterns/,
        );
    });

    describe('with * as allowed origin patterns and credentials', () => {
        beforeEach(() => createApp({ 'jhipster.cors.allowed-origin-patterns': '*', 'jhipster.cors.allow-credentials': true }));

        it('allows any origin with credentials, the origin given back', () =>
            request(app.getHttpServer())
                .get('/management/health')
                .set('Origin', 'http://any.example.com')
                .expect(200)
                .expect('Access-Control-Allow-Origin', 'http://any.example.com')
                .expect('Access-Control-Allow-Credentials', 'true'));
    });
});
