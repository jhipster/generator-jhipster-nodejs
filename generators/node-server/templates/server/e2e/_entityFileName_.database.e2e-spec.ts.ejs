        email: '<%= entityInstance.toLowerCase() %>-<%= property.toLowerCase() %>-e2e@localhost',
        password: '',
        activationKey: 'e2e-activation-key',
        resetKey: 'e2e-reset-key',
      }),
    );
<%_ } else { _%>
    const relatedValues: Record<string, any> = <%- literal(otherValues) %>;
    const { body: related } = await request(server).post('/api/<%= otherEntity.entityApiUrl %>').send(<%- spreads[otherEntity.entityInstance] ? `{ ...relatedValues${spreads[otherEntity.entityInstance]} }` : 'relatedValues' %>).expect(201);
<%_ } _%>
<%_ if (otherTextField) { _%>
    const reference = { <%= otherId %>: related.<%= otherId %>, <%= otherTextField.fieldName %>: 'not stored through the relationship' };
<%_ } else { _%>
    const reference = { <%= otherId %>: related.<%= otherId %> };
<%_ } _%>
    const { body: stored } = await request(server)
      .post('/api/<%= entityApiUrl %>')
      .send({ ...createdValues<%- spreads[entityInstance] ?? '' %>, <%= property %>: <%- collection ? '[reference]' : 'reference' %> })
      .expect(201);

    const { body: read } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
<%_ if (collection) { _%>
    expect(read.<%= property %>).toEqual([expect.objectContaining({ <%= otherId %>: related.<%= otherId %> })]);
<%_ } else { _%>
    expect(read.<%= property %>).toMatchObject({ <%= otherId %>: related.<%= otherId %> });
<%_ } _%>
<%_ if (otherEntity.builtInUser) { _%>
    // The keys of the user never in a response, like the @JsonIgnore keys of JHipster Spring Boot.
    expect(JSON.stringify(read.<%= property %>)).not.toMatch(/e2e-(activation|reset)-key/);
<%_ } _%>
<%_ if (otherTextField) { _%>
    const { body: relatedRead } = await request(server).get(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(200);
    expect(relatedRead.<%= otherTextField.fieldName %>).toBe(relatedValues.<%= otherTextField.fieldName %>);
<%_ } _%>

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
<%_ if (otherEntity.builtInUser) { _%>
    await users.remove(related);
<%_ } else if (otherValues) { _%>
    await request(server).delete(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(204);
<%_ } _%>
  });
<%_ } _%>
<%_ for (const relationship of inverseRelationships) {
    const otherEntity = relationship.otherEntity;
    const otherId = otherEntity.primaryKey.name;
    const property = relationship.propertyName;
    const collection = relationship.relationshipType !== 'one-to-one';
    const otherProperty = relationship.otherRelationship.propertyName;
    const otherCollection = relationship.relationshipType === 'many-to-many';
    const otherValues = relationship.nodejsRelatedValues;
_%>

  it('should not store the <%= property %> relationship from this side, like the mappedBy side of JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(<%- spreads[entityInstance] ? `{ ...createdValues${spreads[entityInstance]} }` : 'createdValues' %>).expect(201);
    const reference = { <%= primaryKey.name %>: stored.<%= primaryKey.name %> };
    const { body: related } = await request(server)
      .post('/api/<%= otherEntity.entityApiUrl %>')
      .send({ ...<%- literal(otherValues) %><%- spreads[otherEntity.entityInstance] ?? '' %>, <%= otherProperty %>: <%- otherCollection ? '[reference]' : 'reference' %> })
      .expect(201);

    await request(server)
      .put(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`)
