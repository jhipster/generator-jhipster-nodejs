const storedRelationships = databaseTypeSql ? persistableRelationships : [];
const anyUserRelationship = storedRelationships.some(relationship => relationship.otherEntity.builtInUser);
// The relationships the other entity stores (nodejsMappedByRelationships), with another entity of the application.
const inverseRelationships = databaseTypeSql
  ? nodejsMappedByRelationships.filter(relationship => relationship.otherEntity.entityRestLayer && relationship.otherRelationship?.propertyName)
  : [];
const literal = value => JSON.stringify(value);
// The references of the required relationships from the test samples (e2e/samples), by entity instance name.
const spreads = nodejsRequiredSamples.spreads;
