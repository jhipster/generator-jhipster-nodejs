/**
 * <%= entityClass %> stored in the database and read back through the REST API, like the resource tests of JHipster
 * Spring Boot: the values of every field as the API exchanges them<% if (storedRelationships.length > 0) { %>, and the relationships stored by the id of the related
 * record, without changing it<% } %>.
 */
describe('<%= entityClass %> on the database', () => {
  let app: INestApplication;
  const AUDITOR = 'database-e2e';

  // The values of the fields, of a creation then of an update.
  const createdValues: Record<string, any> = {
<%_ for (const [name, value] of Object.entries(created.values)) { _%>
    <%= name %>: <%- literal(value) %>,
<%_ } _%>
  };
  const updatedValues: Record<string, any> = {
<%_ for (const [name, value] of Object.entries(updated.values)) { _%>
    <%= name %>: <%- literal(value) %>,
<%_ } _%>
  };

  /** The values read back: a Float is approximate on the databases keeping it in single precision. */
  const expected = (values: Record<string, any>): Record<string, any> => ({
    ...values,
<%_ for (const name of approximateFields) { _%>
    <%= name %>: expect.closeTo(values.<%= name %>, 1),
<%_ } _%>
  });

  beforeAll(async () => {
    const moduleFixture: TestingModule = await Test.createTestingModule({
      imports: [AppModule],
    })
      .overrideGuard(AuthGuard)
      // The user of the requests, which the audit fields record.
      .useValue({
        canActivate: (context: ExecutionContext) => {
          context.switchToHttp().getRequest().user = { login: AUDITOR };
          return true;
        },
      })
      .overrideGuard(RolesGuard)
      .useValue({ canActivate: () => true })
      .compile();

    app = moduleFixture.createNestApplication();
    configureApp(app);
<%_ if (nodejsRequiredSamples.entities.length > 0) { _%>
    // Listening, for the requests storing the samples of the required relationships while the request of a test is built.
    await app.listen(0);
<%_ } else { _%>
    await app.init();
<%_ } _%>
  });

  afterAll(async () => {
    await app?.close();
  });

  it('should store every field and read it back, then update and delete it', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(<%- spreads[entityInstance] ? `{ ...createdValues${spreads[entityInstance]} }` : 'createdValues' %>).expect(201);
    const { body: read } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
    expect(read).toMatchObject(expected(createdValues));
    // The audit fields, of the user of the creation.
    expect(read).toMatchObject({ createdBy: AUDITOR, lastModifiedBy: AUDITOR });

    await request(server)
      .put(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`)
      .send({ ...updatedValues<%- spreads[entityInstance] ?? '' %>, <%= primaryKey.name %>: stored.<%= primaryKey.name %> })
      .expect(200);
    const { body: readUpdated } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
    expect(readUpdated).toMatchObject(expected({ ...updatedValues, <%= primaryKey.name %>: stored.<%= primaryKey.name %> }));

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
    await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(404);
  });
<%_ const optionalField = fields.find(field => !field.id && !field.transient && !field.fieldValidationRequired && field.fieldName in created.values); _%>
<%_ if (optionalField) { _%>

  it('should clear the <%= optionalField.fieldName %> a PUT does not give, like JHipster Spring Boot replacing the record', async () => {
    const server = app.getHttpServer();
