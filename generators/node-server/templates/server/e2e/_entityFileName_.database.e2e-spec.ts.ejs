    const { <%= optionalField.fieldName %>: _<%= optionalField.fieldName %>, ...withoutField } = stored;

    const { body: updated } = await request(server).put(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).send(withoutField).expect(200);
    expect(updated.<%= optionalField.fieldName %>).toBeNull();
    const { body: read } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
    expect(read.<%= optionalField.fieldName %>).toBeNull();

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ } _%>

  it('should list the stored records<% if (pagination !== 'no') { %>, with the pagination headers of JHipster Spring Boot<% } %>', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(<%- spreads[entityInstance] ? `{ ...createdValues${spreads[entityInstance]} }` : 'createdValues' %>).expect(201);

    const response = await request(server).get('/api/<%= entityApiUrl %>?size=2000').expect(200);
    expect(response.body.map((record: Record<string, unknown>) => record.<%= primaryKey.name %>)).toContain(stored.<%= primaryKey.name %>);
<%_ if (pagination !== 'no') { _%>
    expect(Number(response.headers['x-total-count'])).toBe(response.body.length);
    expect(response.headers.link).toContain('rel="first"');
<%_ } _%>

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ if (!primaryKey.autoGenerate) { _%>

  it('should refuse a new record with the <%= primaryKey.name %> of an existing one, like JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    const values = <%- spreads[entityInstance] ? `{ ...createdValues${spreads[entityInstance]} }` : 'createdValues' %>;
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(values).expect(201);

    expect(stored.<%= primaryKey.name %>).toEqual(createdValues.<%= primaryKey.name %>);
    await request(server).post('/api/<%= entityApiUrl %>').send(values).expect(400);

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ } _%>
<%_ if (databaseTypeSql && primaryKey.typeString && primaryKey.autoGenerate) { _%>

  it('should give a new record a UUID as its String <%= primaryKey.name %>, like the @GeneratedValue of JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(<%- spreads[entityInstance] ? `{ ...createdValues${spreads[entityInstance]} }` : 'createdValues' %>).expect(201);

    expect(stored.<%= primaryKey.name %>).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);
    await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ } _%>
<%_ for (const relationship of storedRelationships) {
