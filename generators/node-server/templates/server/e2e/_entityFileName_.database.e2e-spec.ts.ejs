<%_
// The values of the fields as the API exchanges them, reproducible: the faker of the entity is seeded for this test.
resetFakerSeed('nodejs-database-e2e');
const created = nodejsApiFakeEntity();
const updated = nodejsApiFakeEntity();
const approximateFields = created.approximateFields;
// The relationships of the entity with a join column or a join table (the persistableRelationships of JHipster): stored
// by the id of the related record.
const storedRelationships = databaseTypeSql ? persistableRelationships : [];
const anyUserRelationship = storedRelationships.some(relationship => relationship.otherEntity.builtInUser);
// The relationships the other entity stores (nodejsMappedByRelationships), with another entity of the application.
const inverseRelationships = databaseTypeSql
  ? nodejsMappedByRelationships.filter(relationship => !relationship.otherEntity.builtIn && relationship.otherRelationship?.propertyName)
  : [];
const literal = value => JSON.stringify(value);
_%>
import { afterAll, beforeAll, describe, expect, it } from 'vitest';
import { ExecutionContext, INestApplication } from '@nestjs/common';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
<%_ if (anyUserRelationship) { _%>
import { DataSource } from 'typeorm';
<%_ } _%>

import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
<%_ if (anyUserRelationship) { _%>
import { <%= user.persistClass %> } from '../src/users/user.entity.ts';
<%_ } _%>
import { AuthGuard } from '../src/auth/guards/auth.guard.ts';
import { RolesGuard } from '../src/auth/guards/roles.guard.ts';

/**
 * <%= entityClass %> stored in the database and read back through the REST API, like the resource tests of JHipster
 * Spring Boot: the values of every field as the API exchanges them<% if (storedRelationships.length > 0) { %>, and the relationships stored by the id of the related
 * record, without changing it<% } %>.
 */
describe('<%= entityClass %> on the database', () => {
  let app: INestApplication;
  const AUDITOR = 'database-e2e';

  // The values of the fields, of a creation then of an update.
  const createdValues: Record<string, any> = {
<%_ for (const [name, value] of Object.entries(created.values)) { _%>
    <%= name %>: <%- literal(value) %>,
<%_ } _%>
  };
  const updatedValues: Record<string, any> = {
<%_ for (const [name, value] of Object.entries(updated.values)) { _%>
    <%= name %>: <%- literal(value) %>,
<%_ } _%>
  };

  /** The values read back: a Float is approximate on the databases keeping it in single precision. */
  const expected = (values: Record<string, any>): Record<string, any> => ({
    ...values,
<%_ for (const name of approximateFields) { _%>
    <%= name %>: expect.closeTo(values.<%= name %>, 1),
<%_ } _%>
  });

  beforeAll(async () => {
    const moduleFixture: TestingModule = await Test.createTestingModule({
      imports: [AppModule],
    })
      .overrideGuard(AuthGuard)
      // The user of the requests, which the audit fields record.
      .useValue({
        canActivate: (context: ExecutionContext) => {
          context.switchToHttp().getRequest().user = { login: AUDITOR };
          return true;
        },
      })
      .overrideGuard(RolesGuard)
      .useValue({ canActivate: () => true })
      .compile();

    app = moduleFixture.createNestApplication();
    configureApp(app);
    await app.init();
  });

  afterAll(async () => {
    await app?.close();
  });

  it('should store every field and read it back, then update and delete it', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(createdValues).expect(201);
    const { body: read } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
    expect(read).toMatchObject(expected(createdValues));
    // The audit fields, of the user of the creation.
    expect(read).toMatchObject({ createdBy: AUDITOR, lastModifiedBy: AUDITOR });

    await request(server)
      .put(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`)
      .send({ ...updatedValues, <%= primaryKey.name %>: stored.<%= primaryKey.name %> })
      .expect(200);
    const { body: readUpdated } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
    expect(readUpdated).toMatchObject(expected(updatedValues));

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
    await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(404);
  });

  it('should list the stored records<% if (pagination !== 'no') { %>, with the pagination headers of JHipster Spring Boot<% } %>', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(createdValues).expect(201);

    const response = await request(server).get('/api/<%= entityApiUrl %>?size=2000').expect(200);
    expect(response.body.map((record: Record<string, unknown>) => record.<%= primaryKey.name %>)).toContain(stored.<%= primaryKey.name %>);
<%_ if (pagination !== 'no') { _%>
    expect(Number(response.headers['x-total-count'])).toBe(response.body.length);
    expect(response.headers.link).toContain('rel="first"');
<%_ } _%>

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ for (const relationship of storedRelationships) {
    const otherEntity = relationship.otherEntity;
    const otherId = otherEntity.primaryKey.name;
    const collection = relationship.relationshipType === 'many-to-many';
    const property = relationship.propertyName;
    const otherValues = relationship.nodejsRelatedValues;
    // A text field of the related record, sent changed with its id: the relationship does not store it (no cascade).
    const otherTextField = otherValues && otherEntity.fields.find(field => !field.id && field.fieldType === 'String' && field.fieldName in otherValues);
_%>

  it('should store the <%= property %> relationship by the id of the related record, without changing it', async () => {
    const server = app.getHttpServer();
<%_ if (otherEntity.builtInUser) { _%>
    // A user of this test: the applications without seed users (OAuth2) have none.
    const users = app.get(DataSource).getRepository(<%= user.persistClass %>);
    const related = await users.save(
      users.create({
        login: '<%= entityInstance.toLowerCase() %>-<%= property.toLowerCase() %>-e2e',
        email: '<%= entityInstance.toLowerCase() %>-<%= property.toLowerCase() %>-e2e@localhost',
        password: '',
        activationKey: 'e2e-activation-key',
        resetKey: 'e2e-reset-key',
      }),
    );
<%_ } else { _%>
    const relatedValues: Record<string, any> = <%- literal(otherValues) %>;
    const { body: related } = await request(server).post('/api/<%= otherEntity.entityApiUrl %>').send(relatedValues).expect(201);
<%_ } _%>
<%_ if (otherTextField) { _%>
    const reference = { <%= otherId %>: related.<%= otherId %>, <%= otherTextField.fieldName %>: 'not stored through the relationship' };
<%_ } else { _%>
    const reference = { <%= otherId %>: related.<%= otherId %> };
<%_ } _%>
    const { body: stored } = await request(server)
      .post('/api/<%= entityApiUrl %>')
      .send({ ...createdValues, <%= property %>: <%- collection ? '[reference]' : 'reference' %> })
      .expect(201);

    const { body: read } = await request(server).get(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(200);
<%_ if (collection) { _%>
    expect(read.<%= property %>).toEqual([expect.objectContaining({ <%= otherId %>: related.<%= otherId %> })]);
<%_ } else { _%>
    expect(read.<%= property %>).toMatchObject({ <%= otherId %>: related.<%= otherId %> });
<%_ } _%>
<%_ if (otherEntity.builtInUser) { _%>
    // The keys of the user never in a response, like the @JsonIgnore keys of JHipster Spring Boot.
    expect(JSON.stringify(read.<%= property %>)).not.toMatch(/e2e-(activation|reset)-key/);
<%_ } _%>
<%_ if (otherTextField) { _%>
    const { body: relatedRead } = await request(server).get(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(200);
    expect(relatedRead.<%= otherTextField.fieldName %>).toBe(relatedValues.<%= otherTextField.fieldName %>);
<%_ } _%>

    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
<%_ if (otherEntity.builtInUser) { _%>
    await users.remove(related);
<%_ } else if (!otherEntity.builtIn) { _%>
    await request(server).delete(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(204);
<%_ } _%>
  });
<%_ } _%>
<%_ for (const relationship of inverseRelationships) {
    const otherEntity = relationship.otherEntity;
    const otherId = otherEntity.primaryKey.name;
    const property = relationship.propertyName;
    const collection = relationship.relationshipType !== 'one-to-one';
    const otherProperty = relationship.otherRelationship.propertyName;
    const otherCollection = relationship.relationshipType === 'many-to-many';
    const otherValues = relationship.nodejsRelatedValues;
_%>

  it('should not store the <%= property %> relationship from this side, like the mappedBy side of JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    const { body: stored } = await request(server).post('/api/<%= entityApiUrl %>').send(createdValues).expect(201);
    const reference = { <%= primaryKey.name %>: stored.<%= primaryKey.name %> };
    const { body: related } = await request(server)
      .post('/api/<%= otherEntity.entityApiUrl %>')
      .send({ ...<%- literal(otherValues) %>, <%= otherProperty %>: <%- otherCollection ? '[reference]' : 'reference' %> })
      .expect(201);

    await request(server)
      .put(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`)
      .send({ ...stored, <%= property %>: <%- collection ? '[]' : 'null' %> })
      .expect(200);

    const { body: relatedRead } = await request(server).get(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(200);
<%_ if (otherCollection) { _%>
    expect(relatedRead.<%= otherProperty %>).toEqual([expect.objectContaining(reference)]);
<%_ } else { _%>
    expect(relatedRead.<%= otherProperty %>).toMatchObject(reference);
<%_ } _%>

    await request(server).delete(`/api/<%= otherEntity.entityApiUrl %>/${related.<%= otherId %>}`).expect(204);
    await request(server).delete(`/api/<%= entityApiUrl %>/${stored.<%= primaryKey.name %>}`).expect(204);
  });
<%_ } _%>

<%_
const pk = primaryKey.name;
// The one-to-one relationships the other entity stores, whose records without one the controller lists (its is-null filter).
const inverseOneToOnes = nodejsMappedByRelationships.filter(relationship => relationship.relationshipOneToOne);
_%>
<%_ if (!primaryKey.typeUUID) { _%>

  it('should sort the list by id, the newest first with id,desc, like Spring Data', async () => {
    const server = app.getHttpServer();
    const { body: first } = await request(server).post('/api/<%= entityApiUrl %>').send(createdValues).expect(201);
    const { body: second } = await request(server).post('/api/<%= entityApiUrl %>').send(updatedValues).expect(201);

    const { body: list } = await request(server).get('/api/<%= entityApiUrl %>?sort=<%= pk %>,desc&size=100').expect(200);
    const ids = list.map((record: any) => String(record.<%= pk %>));
    expect(ids.indexOf(String(second.<%= pk %>))).toBeLessThan(ids.indexOf(String(first.<%= pk %>)));

    await request(server).delete(`/api/<%= entityApiUrl %>/${first.<%= pk %>}`).expect(204);
    await request(server).delete(`/api/<%= entityApiUrl %>/${second.<%= pk %>}`).expect(204);
  });
<%_ } _%>
<%_ if (databaseTypeMongodb) { _%>

  it('should answer an id that is not an ObjectId as an unknown one, like JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    await request(server).get('/api/<%= entityApiUrl %>/not-an-id').expect(404);
    await request(server).delete('/api/<%= entityApiUrl %>/not-an-id').expect(204);
  });
<%_ } _%>
<%_ for (const relationship of inverseOneToOnes) {
    const otherEntity = relationship.otherEntity;
    const ownerProperty = relationship.otherRelationship.propertyName;
    const ownerValues = (otherEntity.resetFakerSeed('nodejs-database-e2e'), otherEntity.nodejsApiFakeEntity().values);
_%>

  it('should give the records without <%= relationship.propertyName %> to its is-null filter, like JHipster Spring Boot', async () => {
    const server = app.getHttpServer();
    const { body: free } = await request(server).post('/api/<%= entityApiUrl %>').send(createdValues).expect(201);
    const { body: linked } = await request(server).post('/api/<%= entityApiUrl %>').send(updatedValues).expect(201);
    const { body: owner } = await request(server)
      .post('/api/<%= otherEntity.entityApiUrl %>')
      .send({ ...<%- literal(ownerValues) %>, <%= ownerProperty %>: { <%= pk %>: linked.<%= pk %> } })
      .expect(201);

    const { body: list } = await request(server).get('/api/<%= entityApiUrl %>?filter=<%- relationship.relationshipName.toLowerCase() %>-is-null').expect(200);
    const ids = list.map((record: any) => record.<%= pk %>);
    expect(ids).toContain(free.<%= pk %>);
    expect(ids).not.toContain(linked.<%= pk %>);

    await request(server).delete(`/api/<%= otherEntity.entityApiUrl %>/${owner.<%= otherEntity.primaryKey.name %>}`).expect(204);
    await request(server).delete(`/api/<%= entityApiUrl %>/${free.<%= pk %>}`).expect(204);
    await request(server).delete(`/api/<%= entityApiUrl %>/${linked.<%= pk %>}`).expect(204);
  });
<%_ } _%>
});
