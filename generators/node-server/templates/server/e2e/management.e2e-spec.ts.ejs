import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
import { ExecutionContext, INestApplication } from '@nestjs/common';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { loggerLevels } from '../src/common/logging.ts';
import { setupSwagger } from '../src/swagger.ts';
import { AuthGuard } from '../src/security/guards/auth.guard.ts';
import { RolesGuard } from '../src/security/guards/roles.guard.ts';

describe('Management', () => {
    let app: INestApplication;

    /** The application with its guards, without them (an administrator), or with an authenticated user of some roles. */
    const createApp = async (guards: boolean | string[]): Promise<INestApplication> => {
        let builder = Test.createTestingModule({ imports: [AppModule] });
        if (guards === false) {
            // An administrator.
            builder = builder.overrideGuard(AuthGuard).useValue({ canActivate: () => true }).overrideGuard(RolesGuard).useValue({ canActivate: () => true });
        } else if (Array.isArray(guards)) {
            // A user of these roles, checked by the RolesGuard of the application.
            builder = builder.overrideGuard(AuthGuard).useValue({
                canActivate: (context: ExecutionContext) => {
                    context.switchToHttp().getRequest().user = { login: 'managementtest', authorities: guards };
                    return true;
                },
            });
        }
        const moduleFixture: TestingModule = await builder.compile();
        const nestApp = moduleFixture.createNestApplication();
        configureApp(nestApp);
        await nestApp.init();
        return nestApp;
    };

    afterEach(async () => {
        loggerLevels.setLevel('ManagementTest', null);
        await app?.close();
    });

    describe('as an administrator', () => {
        beforeEach(async () => {
            app = await createApp(false);
        });

        it('/GET loggers gives the levels and the ROOT logger', async () => {
            const { body } = await request(app.getHttpServer()).get('/management/loggers').expect(200);

            expect(body.levels).toEqual(['OFF', 'ERROR', 'WARN', 'INFO', 'DEBUG', 'TRACE']);
            expect(Object.keys(body.loggers)[0]).toBe('ROOT');
            expect(body.loggers.ROOT.configuredLevel).toEqual(expect.any(String));
        });

        it('/POST loggers changes the level of a logger, and null gives it the ROOT level again', async () => {
            await request(app.getHttpServer()).post('/management/loggers/ManagementTest').send({ configuredLevel: 'TRACE' }).expect(204);
            await request(app.getHttpServer())
                .get('/management/loggers/ManagementTest')
                .expect(200)
                .expect({ configuredLevel: 'TRACE', effectiveLevel: 'TRACE' });

            await request(app.getHttpServer()).post('/management/loggers/ManagementTest').send({ configuredLevel: null }).expect(204);
            const { body } = await request(app.getHttpServer()).get('/management/loggers/ManagementTest').expect(200);
            expect(body).toEqual({ configuredLevel: null, effectiveLevel: loggerLevels.getLevel('ROOT').effectiveLevel });
        });

        it('/POST loggers with an unknown level is a bad request', () =>
            request(app.getHttpServer()).post('/management/loggers/ManagementTest').send({ configuredLevel: 'LOUD' }).expect(400));

        it('/GET jhimetrics gives the memory, the processor and the requests by endpoint', async () => {
            await request(app.getHttpServer()).get('/management/info').expect(200);
            const { body } = await request(app.getHttpServer()).get('/management/jhimetrics').expect(200);

            expect(body.jvm.heap).toEqual({ used: expect.any(Number), committed: expect.any(Number), max: expect.any(Number) });
            expect(body.processMetrics['system.cpu.count']).toBeGreaterThan(0);
            expect(body['http.server.requests'].percode['200'].count).toBeGreaterThan(0);
            expect(body.services['/management/info'].GET.count).toBe(1);
        });

        it('/GET env gives the sources of the configuration, their values hidden like Spring Boot', async () => {
            const { body } = await request(app.getHttpServer()).get('/management/env').expect(200);

            expect(body.activeProfiles).toContain('test');
            expect(body.propertySources.map((source: { name: string }) => source.name)).toEqual([
                'systemEnvironment',
                "Config resource 'config/application-secret-samples.yml'",
                "Config resource 'config/application-test.yml'",
                "Config resource 'config/application.yml'",
            ]);
            const applicationYml = body.propertySources[3];
            expect(applicationYml.properties['management.endpoint.env.show-values']).toEqual({ value: '******' });
        });

        it('/GET configprops gives the properties of the application by prefix, their values hidden like Spring Boot', async () => {
            const { body } = await request(app.getHttpServer()).get('/management/configprops').expect(200);

            const [context] = Object.values<{ beans: Record<string, { prefix: string; properties: any }> }>(body.contexts);
            expect(context.beans.jhipster.prefix).toBe('jhipster');
            expect(context.beans.jhipster.properties.mail.from).toBe('******');
        });

        it('/GET threaddump gives the thread of the event loop', async () => {
            const { body } = await request(app.getHttpServer()).get('/management/threaddump').expect(200);

            expect(body.threads).toEqual([expect.objectContaining({ threadName: 'main', threadState: 'RUNNABLE' })]);
        });
    });

    describe('as a user without the administrator role', () => {
        beforeEach(async () => {
            app = await createApp(['ROLE_USER']);
        });

        it('/GET and /POST loggers are forbidden, the role of the controller class applies to its routes', async () => {
            await request(app.getHttpServer()).get('/management/loggers').expect(403);
            await request(app.getHttpServer()).post('/management/loggers/ManagementTest').send({ configuredLevel: 'OFF' }).expect(403);
            expect(loggerLevels.getLevel('ManagementTest').configuredLevel).toBeNull();
        });

        it('/GET jhimetrics is forbidden', () => request(app.getHttpServer()).get('/management/jhimetrics').expect(403));

        it('/GET v3/api-docs is forbidden, like JHipster Spring Boot', async () => {
            setupSwagger(app);
            await request(app.getHttpServer()).get('/v3/api-docs').expect(403);
        });
    });

    describe('as a user with the administrator role', () => {
        beforeEach(async () => {
            app = await createApp(['ROLE_ADMIN']);
        });

        it('/GET loggers is allowed', () => request(app.getHttpServer()).get('/management/loggers').expect(200));

        it('/GET v3/api-docs is not found without the api-docs profile', () => request(app.getHttpServer()).get('/v3/api-docs').expect(404));

        it('/GET v3/api-docs gives the OpenAPI document of the api-docs profile', async () => {
            setupSwagger(app);
            const { body } = await request(app.getHttpServer()).get('/v3/api-docs').expect(200);

            expect(body.openapi).toEqual(expect.any(String));
            expect(body.info.title).toBe('<%= baseName %> API');
            expect(Object.keys(body.paths)).toContainEqual(expect.stringMatching(/^\/api\//));
            // The controller of the document itself is left out.
            expect(Object.keys(body.paths)).not.toContain('/v3/api-docs');
        });
    });

    describe('Prometheus', () => {
        beforeEach(async () => {
            app = await createApp(true);
        });

        it('/GET prometheus gives the metrics without authentication', async () => {
            await request(app.getHttpServer()).get('/management/info').expect(200);
            const response = await request(app.getHttpServer()).get('/management/prometheus').expect(200).expect('Content-Type', /text\/plain/);

            expect(response.text).toContain('http_server_requests_seconds_count{method="GET",uri="/management/info",status="200",outcome="SUCCESS"} 1');
            expect(response.text).toContain('nodejs_heap_size_used_bytes');
        });
    });

<%_ if (authenticationTypeJwt || authenticationTypeSession) { _%>
    describe('without authentication', () => {
        beforeEach(async () => {
            app = await createApp(true);
        });

        it('/GET loggers is refused', async () => {
            const { status } = await request(app.getHttpServer()).get('/management/loggers');
            expect([401, 403]).toContain(status);
        });

        it('/GET v3/api-docs is refused', async () => {
            setupSwagger(app);
            await request(app.getHttpServer()).get('/v3/api-docs').expect(401);
        });
    });
<%_ } _%>
});
