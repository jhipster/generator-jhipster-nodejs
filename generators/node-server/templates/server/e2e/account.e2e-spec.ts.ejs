import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from 'supertest';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { ExecutionContext, INestApplication } from '@nestjs/common';
import { AuthGuard } from '../src/security/guards/auth.guard.ts';
import { RolesGuard } from '../src/security/guards/roles.guard.ts';
import { <%= user.dtoClass%> } from '../src/service/dto/user.dto.ts';
import { UserService } from '../src/service/user.service.ts';
import { PasswordChangeDTO } from '../src/service/dto/password-change.dto.ts';
import { AuthService } from '../src/service/auth.service.ts';

describe('Account', () => {
    let app: INestApplication;
    let service: UserService;
    let authService: AuthService;

    const testUserDTO: <%= user.dtoClass%> = {
        login: 'userTestLogin',
        email: 'usertest@localhost.it',
        password: 'testPassword',
    };

    const testUserAuthenticated: any = {
<%_ if (databaseType === 'mongodb') { _%>
        // the mongodb driver rejects an id that is not a valid ObjectId
        id: '000000000000000000000042',
<%_ } else { _%>
        id: 42,
<%_ } _%>
        login: 'userlogged',
        email: 'userlogged@localhost.it',
        password: 'userloggedPassword',
        activated: true
    };

    const testPasswordChange: PasswordChangeDTO = {
        currentPassword: testUserAuthenticated.password,
        newPassword: 'newPassword',
    };

    let userAuthenticated: <%= user.dtoClass%>;

    const authGuardMock = { canActivate: (context: ExecutionContext): any => {
        const req = context.switchToHttp().getRequest();
        req.user = testUserAuthenticated;
        return true;
    },
    };

    const rolesGuardMock = { canActivate: (): any => true };


    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        })
            .overrideGuard(AuthGuard)
            .useValue(authGuardMock)
            .overrideGuard(RolesGuard)
            .useValue(rolesGuardMock)
            .compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
        service = moduleFixture.get<UserService>(UserService);
        authService = moduleFixture.get<AuthService>(AuthService);
        userAuthenticated = await service.save(testUserAuthenticated, testUserAuthenticated.login, true);
    });

    it('/POST register new user', async () => {
        const createdUser: <%= user.dtoClass%> = (
            await request(app.getHttpServer())
                .post('/api/register')
                .send({ ...testUserDTO, activated: true })
                .expect(201)
        ).body;

        // Like JHipster Spring Boot, the login in lower case, and a user not activated whatever the request.
        expect(createdUser.login).toEqual(testUserDTO.login.toLowerCase());
        const registeredUser = (await service.findByFields({ where: { login: testUserDTO.login.toLowerCase() } }))!;
        expect(registeredUser.activated).toBe(false);
        await service.delete(registeredUser);
    });

    it('/POST register with the login of a not activated user replaces it', async () => {
        await request(app.getHttpServer()).post('/api/register').send(testUserDTO).expect(201);
        await request(app.getHttpServer())
            .post('/api/register')
            .send({ ...testUserDTO, email: 'usertest2@localhost.it' })
            .expect(201);

        const registeredUser = (await service.findByFields({ where: { login: testUserDTO.login.toLowerCase() } }))!;
        expect(registeredUser.email).toEqual('usertest2@localhost.it');
        await service.delete(registeredUser);
    });

    it('/POST register with a too short password is an invalid password problem', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/register')
                .send({ ...testUserDTO, password: 'abc' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/invalid-password' });
    });

    it('/POST register with the login of another user is a login already used problem', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/register')
                .send({ ...testUserDTO, login: testUserAuthenticated.login })
                .expect(400)
        ).body;

        // The type the registration page of the JHipster clients reads.
        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/login-already-used', message: 'error.userexists' });
    });

    it('/POST register with the email of another user is an email already used problem', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/register')
                .send({ ...testUserDTO, email: testUserAuthenticated.email })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/email-already-used', message: 'error.emailexists' });
    });

    it('/GET activate account', async () => {
        await request(app.getHttpServer())
            .get('/api/activate')
            .expect(500);
    });


    it('/GET authenticate', async () => {
        const loginValue: any = (await request(app.getHttpServer())
            .get('/api/authenticate')
            .expect(200)).text;

        expect(loginValue).toEqual(testUserAuthenticated.login);
    });

    it('/GET account', async () => {

        <%_ if (databaseType !== 'mongodb') { _%>
        const loggedUser: any = JSON.parse(( await request(app.getHttpServer())
            .get('/api/account')
            .expect(200)).text);

        expect(loggedUser.id).toEqual(userAuthenticated.id);
        expect(loggedUser.login).toEqual(userAuthenticated.login);
        expect(loggedUser.email).toEqual(userAuthenticated.email);
        <%_ } else { _%>
        await request(app.getHttpServer())
              .get('/api/account')
              .expect(200);
        <%_ } _%>

    });

    it('/POST account update settings', async () => {

        const savedTestUser: <%= user.dtoClass%> = {
            firstName: 'updateFirstName',
            lastName: 'updateLastName',
            ...testUserAuthenticated,
        };
        await request(app.getHttpServer())
            .post('/api/account')
            .send(savedTestUser)
            .expect(200);

        const updatedUserSettings = await service.findByFields({ where: { login: testUserAuthenticated.login } });
        expect(updatedUserSettings?.firstName).toEqual(savedTestUser.firstName);
        expect(updatedUserSettings?.lastName).toEqual(savedTestUser.lastName);

    });

    it<%- databaseTypeMongodb ? '.skip' : ''%>('/POST change password', async () => {
        await request(app.getHttpServer())
            .post('/api/account/change-password')
            .send(testPasswordChange)
            .expect(200);

        const successFullyLoggedInWithNewPassword = await authService.login(
            {
                username: testUserAuthenticated.login,
                password: testPasswordChange.newPassword
            }).then(() => true, () => false);

        expect(successFullyLoggedInWithNewPassword).toEqual(true);
    });

    it<%- databaseTypeMongodb ? '.skip' : ''%>('logs in with the login in another case', async () => {
        const loggedIn = await authService
            .login({ username: testUserAuthenticated.login.toUpperCase(), password: testUserAuthenticated.password })
            .then(() => true, () => false);
        expect(loggedIn).toEqual(true);
    });

    it<%- databaseTypeMongodb ? '.skip' : ''%>('/POST change password with a wrong current password is an invalid password problem', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/account/change-password')
                .send({ ...testPasswordChange, currentPassword: 'wrongPassword' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/invalid-password', title: 'Incorrect password' });
    });

    it('/POST reset password init and finish', async () => {
        // The mail is a text/plain body, as the JHipster clients send it.
        await request(app.getHttpServer())
            .post('/api/account/reset-password/init')
            .set('Content-Type', 'text/plain')
            .send(testUserAuthenticated.email)
            .expect(200);

        const { resetKey } = (await service.findByFields({ where: { login: testUserAuthenticated.login } }))!;
        expect(resetKey).toBeTruthy();

        await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: resetKey, newPassword: 'resetPassword' })
            .expect(200);

        expect((await service.findByFields({ where: { login: testUserAuthenticated.login } }))?.resetKey).toBeFalsy();
        const loggedInWithNewPassword = await authService
            .login({ username: testUserAuthenticated.login, password: 'resetPassword' })
            .then(() => true, () => false);
        expect(loggedInWithNewPassword).toEqual(true);
    });

    it('/POST reset password init of an unknown mail answers 200 too', async () => {
        await request(app.getHttpServer())
            .post('/api/account/reset-password/init')
            .set('Content-Type', 'text/plain')
            .send('unknown@localhost.it')
            .expect(200);
    });

    it('/POST reset password finish with an unknown key', async () => {
        await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: 'unknownKey', newPassword: 'resetPassword' })
            .expect(500);
    });

    it('/POST reset password finish with a too short password is a validation error', async () => {
        await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: 'unknownKey', newPassword: 'a' })
            .expect(400);
    });

    afterEach(async () => {
        await service.delete(userAuthenticated);
        await app?.close();
    });
});
