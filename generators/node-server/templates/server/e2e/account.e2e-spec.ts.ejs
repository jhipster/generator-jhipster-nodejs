import { afterEach, beforeEach, describe, expect, it, type MockInstance, vi } from 'vitest';
import { Test, TestingModule } from '@nestjs/testing';
import request from '<%- authenticationTypeSession ? './csrf-request.ts' : 'supertest' %>';
import { AppModule } from '../src/app.module.ts';
import { configureApp } from '../src/app.config.ts';
import { INestApplication } from '@nestjs/common';
import { RequestAuthenticator } from '../src/auth/request-authenticator.ts';
import { RolesGuard } from '../src/auth/guards/roles.guard.ts';
import { <%- user.dtoClass %> } from '../src/users/dto/user.dto.ts';
import { UserService } from '../src/users/user.service.ts';
import { PasswordChangeDTO } from '../src/auth/dto/password-change.dto.ts';
import { AuthService } from '../src/auth/auth.service.ts';
import { MailService } from '../src/mail/mail.service.ts';

describe('Account', () => {
    let app: INestApplication;
    let service: UserService;
    let authService: AuthService;
    let sendPasswordResetMail: MockInstance<MailService['sendPasswordResetMail']>;

<%_ if (!generateUserRegistration) { _%>
    // The user the registration would create.
    const testUserDTO: <%- user.dtoClass %> = {
        login: 'userTestLogin',
        email: 'usertest@localhost.it',
        password: 'testPassword',
    };
<%_ } _%>

    // Saved before each test, with the id the database gives it: the authenticated user of the requests.
    const testUserAuthenticated: any = {
        login: 'userlogged',
        email: 'userlogged@localhost.it',
        password: 'userloggedPassword',
        activated: true
    };

    const testPasswordChange: PasswordChangeDTO = {
        currentPassword: testUserAuthenticated.password,
        newPassword: 'newPassword',
    };

    let userAuthenticated: <%- user.dtoClass %>;

    // The user of the requests, which the PathRulesMiddleware authenticates.
    const authenticatorMock = { authenticate: (): Promise<any> => Promise.resolve(userAuthenticated) };

    const rolesGuardMock = { canActivate: (): any => true };


    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        })
            .overrideProvider(RequestAuthenticator)
            .useValue(authenticatorMock)
            .overrideGuard(RolesGuard)
            .useValue(rolesGuardMock)
            .compile();

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
        service = moduleFixture.get<UserService>(UserService);
        authService = moduleFixture.get<AuthService>(AuthService);
        // The mails are not sent, the tests check the users they are for.
        const mailService = moduleFixture.get<MailService>(MailService);
        sendPasswordResetMail = vi.spyOn(mailService, 'sendPasswordResetMail').mockResolvedValue();
        userAuthenticated = await service.save(testUserAuthenticated, testUserAuthenticated.login, true);
    });

<%_ if (!generateUserRegistration) { _%>
    it('/POST register is not found without the registration of the users', async () => {
        await request(app.getHttpServer()).post('/api/register').send(testUserDTO).expect(404);
        expect(await service.findByFields({ where: { login: testUserDTO.login.toLowerCase() } })).toBeFalsy();
    });

    it('/GET activate is not found', async () => {
        await request(app.getHttpServer()).get('/api/activate').query({ key: 'key' }).expect(404);
    });

<%_ } _%>
    it('/GET authenticate', async () => {
        // Like JHipster Spring Boot, nothing in the answer.
        await request(app.getHttpServer())
            .get('/api/authenticate')
            .expect(204);
    });

    it('/GET account', async () => {

        const loggedUser: any = JSON.parse(( await request(app.getHttpServer())
            .get('/api/account')
            .expect(200)).text);

        expect(String(loggedUser.id)).toEqual(String(userAuthenticated.id));
        expect(loggedUser.login).toEqual(userAuthenticated.login);
        expect(loggedUser.email).toEqual(userAuthenticated.email);

    });

    it('/POST account update settings', async () => {

        const savedTestUser: <%- user.dtoClass %> = {
            firstName: 'updateFirstName',
            lastName: 'updateLastName',
            ...testUserAuthenticated,
        };
        // Like JHipster Spring Boot, nothing in the answer.
        const { text } = await request(app.getHttpServer())
            .post('/api/account')
            .send(savedTestUser)
            .expect(200);
        expect(text).toBe('');

        const updatedUserSettings = await service.findByFields({ where: { login: testUserAuthenticated.login } });
        expect(updatedUserSettings?.firstName).toEqual(savedTestUser.firstName);
        expect(updatedUserSettings?.lastName).toEqual(savedTestUser.lastName);

    });

    it('/POST account update settings keeps the mail in lower case, like JHipster Spring Boot', async () => {
        await request(app.getHttpServer())
            .post('/api/account')
            .send({ ...testUserAuthenticated, email: 'UserLogged@LocalHost.it' })
            .expect(200);

        const updatedUserSettings = await service.findByFields({ where: { login: testUserAuthenticated.login } });
        expect(updatedUserSettings?.email).toEqual('userlogged@localhost.it');
    });

    it('/POST account update settings with the mail of another user in another case is an email already used problem', async () => {
        const otherUser = await service.save({ login: 'otheruser', email: 'otheruser@localhost.it', password: 'otherPassword' });
        const problem = (
            await request(app.getHttpServer())
                .post('/api/account')
                .send({ ...testUserAuthenticated, email: 'OtherUser@localhost.it' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/email-already-used' });
        await service.delete(otherUser);
    });

    it('/POST change password with a too short new password is an invalid password problem, like JHipster Spring Boot', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/account/change-password')
                .send({ currentPassword: testUserAuthenticated.password, newPassword: 'abc' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({ type: 'https://www.jhipster.tech/problem/invalid-password' });
    });

    it<%- databaseTypeMongodb ? '.skip' : '' %>('/POST change password', async () => {
        await request(app.getHttpServer())
            .post('/api/account/change-password')
            .send(testPasswordChange)
            .expect(200);

        const successFullyLoggedInWithNewPassword = await authService
            .authenticate(testUserAuthenticated.login, testPasswordChange.newPassword)
            .then(() => true, () => false);

        expect(successFullyLoggedInWithNewPassword).toEqual(true);
        // The authenticated user is the auditor of its own change.
        expect((await service.findByFields({ where: { login: testUserAuthenticated.login } }))?.lastModifiedBy).toEqual(testUserAuthenticated.login);
    });

    it<%- databaseTypeMongodb ? '.skip' : '' %>('logs in with the login in another case', async () => {
        const loggedIn = await authService
            .authenticate(testUserAuthenticated.login.toUpperCase(), testUserAuthenticated.password)
            .then(() => true, () => false);
        expect(loggedIn).toEqual(true);
    });

    it<%- databaseTypeMongodb ? '.skip' : '' %>('/POST change password with a wrong current password is an invalid password problem', async () => {
        const problem = (
            await request(app.getHttpServer())
                .post('/api/account/change-password')
                .send({ ...testPasswordChange, currentPassword: 'wrongPassword' })
                .expect(400)
        ).body;

        expect(problem).toMatchObject({
            type: 'https://www.jhipster.tech/problem/invalid-password',
            title: 'Bad Request',
            detail: 'Incorrect password',
            instance: '/api/account/change-password',
        });
    });

    it('/POST reset password init and finish', async () => {
        // The mail is a text/plain body, as the JHipster clients send it.
        await request(app.getHttpServer())
            .post('/api/account/reset-password/init')
            .set('Content-Type', 'text/plain')
            .send(testUserAuthenticated.email)
            .expect(200);

        const { resetKey, createdBy, lastModifiedBy } = (await service.findByFields({ where: { login: testUserAuthenticated.login } }))!;
        expect(resetKey).toBeTruthy();
        // Like JHipster Spring Boot, system modifies the user, its creator kept.
        expect({ createdBy, lastModifiedBy }).toEqual({ createdBy: testUserAuthenticated.login, lastModifiedBy: 'system' });
        expect(sendPasswordResetMail).toHaveBeenCalledWith(expect.objectContaining({ login: testUserAuthenticated.login, resetKey }));

        await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: resetKey, newPassword: 'resetPassword' })
            .expect(200);

        const resetUser = (await service.findByFields({ where: { login: testUserAuthenticated.login } }))!;
        expect(resetUser.resetKey).toBeFalsy();
        expect(resetUser).toMatchObject({ createdBy: testUserAuthenticated.login, lastModifiedBy: 'system' });
        const loggedInWithNewPassword = await authService
            .authenticate(testUserAuthenticated.login, 'resetPassword')
            .then(() => true, () => false);
        expect(loggedInWithNewPassword).toEqual(true);
    });

    it('/POST reset password init of an unknown mail answers 200 too', async () => {
        await request(app.getHttpServer())
            .post('/api/account/reset-password/init')
            .set('Content-Type', 'text/plain')
            .send('unknown@localhost.it')
            .expect(200);
        expect(sendPasswordResetMail).not.toHaveBeenCalled();
    });

    it('/POST reset password finish with an unknown key', async () => {
        const { body: problem } = await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: 'unknownKey', newPassword: 'resetPassword' })
            .expect(400);
        expect(problem).toMatchObject({ title: 'Account resource request invalid', status: 400 });
    });

    it('/POST reset password finish with a too short password is a validation error', async () => {
        await request(app.getHttpServer())
            .post('/api/account/reset-password/finish')
            .send({ key: 'unknownKey', newPassword: 'a' })
            .expect(400);
    });

    afterEach(async () => {
        await service.delete(userAuthenticated);
        await app?.close();
    });
});
