<%_
const numericId = primaryKey.tsType === 'number';
// The fake data of the fields, reproducible (the faker of the entity is seeded), as TypeScript literals: distinct ids of
// the type of the primary key, and a value for each field of the entity.
const idField = primaryKey.fields[0];
const [entityId, unknownId, anotherId] = [idField.generateFakeData('ts'), idField.generateFakeData('ts'), idField.generateFakeData('ts')];
const fakeFields = fields
  .filter(field => !field.id && !field.transient && !field.collection)
  .map(field => [field.propertyName, field.generateFakeData('ts')])
  .filter(([, value]) => value !== undefined && value !== null);
// An id the pipe of the path rejects: neither a number nor a UUID.
const invalidId = faker.lorem.word({ length: { min: 5, max: 10 } });
_%>
import { afterEach, beforeEach, describe, expect, it } from '@jest/globals';
import { Test, TestingModule } from '@nestjs/testing';
import request = require('supertest');
import { AppModule } from '../src/app.module';
import { configureApp } from '../src/app.config';
import { INestApplication } from '@nestjs/common';
import { AuthGuard } from '../src/security/guards/auth.guard';
import { RolesGuard } from '../src/security/guards/roles.guard';
import { <%= dtoClass %> } from '../src/service/dto/<%= entityFileName %>.dto';
import { <%= entityClass %>Service } from '../src/service/<%= entityFileName %>.service';
<%_ if (typeormOrderSupport) { _%>
import { DataSource, EntityMetadata } from 'typeorm';
import { <%= entityClass %> } from '../src/domain/<%= entityFileName %>.entity';
<%_ } _%>

const alertHeader = (headers: Record<string, unknown>, suffix: string): unknown =>
    Object.entries(headers).find(([name]) => name.endsWith(suffix))?.[1];

describe('<%= entityClass %> Controller', () => {
    let app: INestApplication;

    const authGuardMock = { canActivate: (): any => true };
    const rolesGuardMock = { canActivate: (): any => true };
    const entityMock: any = {
        id: <%- entityId %>,
<%_ for (const [propertyName, value] of fakeFields) { _%>
        <%- propertyName %>: <%- value %>,
<%_ } _%>
    }
    const unknownId = <%- unknownId %>;
    const anotherId = <%- anotherId %>;
<%_
// The global ValidationPipe of configureApp validates the requests: a body with valid values of the validated fields.
resetFakerSeed('nodejs-e2e');
const validatedFields = fields.filter(field => !field.id && field.fieldValidate && field.fieldType !== 'byte[]');
const validValues = Object.fromEntries(
    validatedFields
        .map(field => [field.fieldName, field.generateFakeData('json-serializable')])
        .filter(([, value]) => value !== undefined && value !== null),
);
const requiredField = validatedFields.find(field => field.fieldValidateRules.includes('required'));
const enumField = fields.find(field => !field.id && field.fieldIsEnum);
_%>
    const validEntity: any = {
        ...entityMock,
<%_ for (const [fieldName, value] of Object.entries(validValues)) { _%>
        <%= fieldName %>: <%- JSON.stringify(value) %>,
<%_ } _%>
    };

    const serviceMock<% if (typeormOrderSupport) { %>: { metadata?: EntityMetadata, [method: string]: unknown }<% } %> = {
        findById: (id: any): any => (id === entityMock.id ? { ...entityMock } : undefined),
        findAndCount: (): any => [entityMock, 0],
        save: (): any => entityMock,
        update: (dto: any): any => dto,
        deleteById: (): any => entityMock
    };


    beforeEach(async () => {
        const moduleFixture: TestingModule = await Test.createTestingModule({
            imports: [AppModule],
        }).overrideGuard(AuthGuard)
        .useValue(authGuardMock)
        .overrideGuard(RolesGuard)
        .useValue(rolesGuardMock)
        .overrideProvider(<%= entityClass %>Service)
        .useValue(serviceMock)
        .compile();
<%_ if (typeormOrderSupport) { _%>
        // The sort is validated with the TypeORM metadata of the entity.
        serviceMock.metadata = moduleFixture.get(DataSource).getMetadata(<%= entityClass %>);
<%_ } _%>

        app = moduleFixture.createNestApplication();
        configureApp(app);
        await app.init();
    });

    it('/GET all <%= entityApiUrl %> ', async () => {

        const getEntities: <%= dtoClass %>[] = (await request(app.getHttpServer())
        .get('/api/<%= entityApiUrl %>')
        .expect(200)).body;

        expect(getEntities).toEqual(entityMock);

    }
    );

<%_ if (typeormOrderSupport) { _%>
<%_
const sortField = fields.find(field => !field.id && !field.transient);
const sortRelationship = relationships.find(relationship => relationship.ownerSide && !relationship.collection);
_%>

    it('/GET all <%= entityApiUrl %> sorted on a property of the entity', async () => {
        await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>?sort=<%= sortField ? sortField.fieldName : primaryKey.name %>,desc')
            .expect(200);
    });
<%_ if (sortRelationship) { _%>

    it('/GET all <%= entityApiUrl %> sorted on the id and the label of a relationship', async () => {
        await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>?sort=<%= sortRelationship.propertyName %>.id,asc')
            .expect(200);
        await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>?sort=<%= sortRelationship.propertyName %>.<%= sortRelationship.otherEntityField %>,desc')
            .expect(200);
    });

    it('/GET all <%= entityApiUrl %> sorted on a deeper property of a relationship', async () => {
        await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>?sort=<%= sortRelationship.propertyName %>.id.unknown,asc')
            .expect(400);
    });
<%_ } _%>

    it('/GET all <%= entityApiUrl %> sorted on an unknown property', async () => {
        const response = await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>?sort=unknownProperty,asc')
            .expect(400);

        expect(response.body.message).toBe('Invalid sort property: unknownProperty');
    });
<%_ } _%>

    it('/GET all <%= entityApiUrl %> with the links of the pages', async () => {
        const { findAndCount } = serviceMock;
        // 45 records, 3 pages of 20.
        serviceMock.findAndCount = (): any => [[entityMock], 45];
        try {
            const response = await request(app.getHttpServer())
                .get('/api/<%= entityApiUrl %>?page=1&size=20')
                .expect(200);

            expect(response.headers['x-total-count']).toBe('45');
            expect(response.headers.link.split(',')).toEqual([
                '</api/<%= entityApiUrl %>?page=2&size=20>; rel="next"',
                '</api/<%= entityApiUrl %>?page=0&size=20>; rel="prev"',
                '</api/<%= entityApiUrl %>?page=2&size=20>; rel="last"',
                '</api/<%= entityApiUrl %>?page=0&size=20>; rel="first"',
            ]);
        } finally {
            serviceMock.findAndCount = findAndCount;
        }
    });

    it('/GET all <%= entityApiUrl %> without records links the first page as the last one', async () => {
        const response = await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>')
            .expect(200);

        expect(response.headers.link).toContain('page=0&size=20>; rel="last"');
        expect(response.headers.link).not.toContain('rel="next"');
    });

    it('/GET <%= entityApiUrl %> by id', async () => {


        const getEntity: <%= dtoClass %> = (await request(app.getHttpServer())
            .get(`/api/<%= entityApiUrl %>/${entityMock.id}`)
            .expect(200)).body;

        expect(getEntity).toEqual(entityMock);

    }
    );

    it('/GET <%= entityApiUrl %> by an unknown id', async () => {
        await request(app.getHttpServer())
            .get(`/api/<%= entityApiUrl %>/${unknownId}`)
            .expect(404);
    });
<%_ if (numericId || primaryKey.typeUUID) { _%>

    it('/GET <%= entityApiUrl %> by an invalid id', async () => {
        await request(app.getHttpServer())
            .get('/api/<%= entityApiUrl %>/<%= invalidId %>')
            .expect(400);
    });
<%_ } _%>

    it('/POST create <%= entityApiUrl %>', async () => {

        const createdEntity: <%= dtoClass %> = (await request(app.getHttpServer())
            .post('/api/<%= entityApiUrl %>')
            .send(validEntity)
            .expect(201)).body;

        expect(createdEntity).toEqual(entityMock);

    }
    );

<%_ if (requiredField) { _%>
    it('/POST create <%= entityApiUrl %> without <%= requiredField.fieldName %> is a validation error', async () => {
        const { <%= requiredField.fieldName %>: _<%= requiredField.fieldName %>, ...invalidEntity } = validEntity;

        const error = (await request(app.getHttpServer())
            .post('/api/<%= entityApiUrl %>')
            .send(invalidEntity)
            .expect(400)).body;

        expect(error.message).toEqual('Validation error');
    });

<%_ } _%>
<%_ if (enumField) { _%>
    it('/POST create <%= entityApiUrl %> with a <%= enumField.fieldName %> out of its enum is a validation error', async () => {
        const error = (await request(app.getHttpServer())
            .post('/api/<%= entityApiUrl %>')
            .send({ ...validEntity, <%= enumField.fieldName %>: 'NOT_A_<%= enumField.fieldType.toUpperCase() %>' })
            .expect(400)).body;

        expect(error.message).toEqual('Validation error');
    });

<%_ } _%>
    it('/PUT update <%= entityApiUrl %> from id', async () => {
        const response = await request(app.getHttpServer())
            .put(`/api/<%= entityApiUrl %>/${entityMock.id}`)
            .send(validEntity)
            .expect(200);

        expect(response.body).toEqual(validEntity);
        expect(alertHeader(response.headers, '-alert')).toMatch(<%- enableTranslation ? `/\\.${entityClass}\\.updated$/` : `/^A ${entityClass} is updated with identifier /` %>);
        expect(alertHeader(response.headers, '-params')).toBe(String(entityMock.id));
    }
    );

    it('/PUT update <%= entityApiUrl %> from another id', async () => {
        const response = await request(app.getHttpServer())
            .put(`/api/<%= entityApiUrl %>/${anotherId}`)
            .send(validEntity)
            .expect(400);

        expect(alertHeader(response.headers, '-error')).toBe('error.idinvalid');
    });

    it('/PUT update <%= entityApiUrl %> without id', async () => {
        const response = await request(app.getHttpServer())
            .put(`/api/<%= entityApiUrl %>/${entityMock.id}`)
            .send({ ...validEntity, id: undefined })
            .expect(400);

        expect(alertHeader(response.headers, '-error')).toBe('error.idnull');
    });

    it('/PUT update an unknown <%= entityApiUrl %>', async () => {
        const response = await request(app.getHttpServer())
            .put(`/api/<%= entityApiUrl %>/${unknownId}`)
            .send({ ...validEntity, id: unknownId })
            .expect(400);

        expect(alertHeader(response.headers, '-error')).toBe('error.idnotfound');
    });

    it('/DELETE <%= entityApiUrl %>', async () => {


        const deletedEntity: <%= dtoClass %> = (await request(app.getHttpServer())
            .delete(`/api/<%= entityApiUrl %>/${entityMock.id}`)
            .expect(204)).body;

            expect(deletedEntity).toEqual({});
    }
    );

    afterEach(async () => {
        await app?.close();
    });
});
