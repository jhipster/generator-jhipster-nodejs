{
  "$schema": "https://json.schemastore.org/nest-cli",
  "language": "ts",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "config/**/*", "outDir": "dist" }<% if (generateUserManagement) { %>, { "include": "i18n/**/*", "outDir": "dist" }, { "include": "templates/**/*", "outDir": "dist" }<% } %>],
    "watchAssets": true
  }
}
