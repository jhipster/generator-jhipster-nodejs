import { beforeEach, describe, expect, it, jest } from '@jest/globals';
import { ServiceUnavailableException } from '@nestjs/common';
import { Test, TestingModule } from '@nestjs/testing';
import { HealthCheckService, TypeOrmHealthIndicator } from '@nestjs/terminus';
import { HealthController } from '../../src/web/rest/health.controller';

describe('Health Controller', () => {
  let controller: HealthController;
  const check = jest.fn<HealthCheckService['check']>();

  beforeEach(async () => {
    check.mockReset();
    const module: TestingModule = await Test.createTestingModule({
      controllers: [HealthController],
      providers: [
        { provide: HealthCheckService, useValue: { check } },
        { provide: TypeOrmHealthIndicator, useValue: { pingCheck: jest.fn() } },
      ],
    }).compile();

    controller = module.get<HealthController>(HealthController);
  });

  it('is UP when the database is up', async () => {
    check.mockResolvedValue({ status: 'ok', info: { db: { status: 'up' } }, error: {}, details: { db: { status: 'up' } } });
    await expect(controller.health()).resolves.toEqual({ status: 'UP', components: { db: { status: 'UP' } } });
  });

  it('is DOWN with the status 503 when the database is down', async () => {
    check.mockRejectedValue(
      new ServiceUnavailableException({
        status: 'error',
        info: {},
        error: { db: { status: 'down', message: 'connection refused' } },
        details: { db: { status: 'down', message: 'connection refused' } },
      }),
    );
    const error = await controller.health().catch((e: ServiceUnavailableException) => e);
    expect(error).toBeInstanceOf(ServiceUnavailableException);
    expect((error as ServiceUnavailableException).getResponse()).toEqual({ status: 'DOWN', components: { db: { status: 'DOWN' } } });
  });
});
