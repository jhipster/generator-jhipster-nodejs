import { afterEach, describe, expect, it } from 'vitest';
import { ConfigModule, ConfigService } from '@nestjs/config';
import { Test } from '@nestjs/testing';
import { validateConfiguration } from '../src/application-config.ts';
import { Config, config, configuration } from '../src/config.ts';

describe('Config', () => {
  const variables = [
    'JHIPSTER_MAIL_BASEURL',
    'JHIPSTER_MAIL_BASE_URL',
    'SAMPLE_INTERVALSECONDS',
    'SAMPLE_ENABLED',
  ];

  afterEach(() => {
    for (const variable of variables) {
      delete process.env[variable];
    }
  });

  it('should keep the properties without environment variable', () => {
    const config = new Config({ jhipster: { mail: { 'base-url': 'from-yaml' } } });
    expect(config.get('jhipster.mail.base-url')).toBe('from-yaml');
  });

  it('should override a property with its canonical environment variable', () => {
    process.env.JHIPSTER_MAIL_BASEURL = 'from-env';
    const config = new Config({ jhipster: { mail: { 'base-url': 'from-yaml' } } });
    expect(config.get('jhipster.mail.base-url')).toBe('from-env');
  });

  it('should override a property with the dashes as underscores', () => {
    process.env.JHIPSTER_MAIL_BASE_URL = 'from-env';
    const config = new Config({ jhipster: { mail: { 'base-url': 'from-yaml' } } });
    expect(config.get('jhipster.mail.base-url')).toBe('from-env');
  });

  it('should keep the type of numbers and booleans', () => {
    process.env.SAMPLE_INTERVALSECONDS = '60';
    process.env.SAMPLE_ENABLED = 'false';
    const config = new Config({ sample: { 'interval-seconds': 10, enabled: true } });
    expect(config.get('sample.interval-seconds')).toBe(60);
    expect(config.get('sample.enabled')).toBe(false);
  });
});

describe('ConfigService', () => {
  const createConfigService = async (): Promise<ConfigService> => {
    const module = await Test.createTestingModule({
      imports: [ConfigModule.forRoot({ ignoreEnvFile: true, load: [configuration] })],
    }).compile();
    return module.get(ConfigService);
  };

  it('should read the properties of config by their dotted names', async () => {
    const configService = await createConfigService();
    expect(configService.get('jhipster.clientApp.name')).toBe(config.get('jhipster.clientApp.name'));
    expect(configService.get('server.port')).toBe(config.get('server.port'));
  });

  it('should read the properties added before the application is created, like the cloud config', async () => {
    config.addAll({ sample: { 'added-later': 'from the cloud config' } });
    const configService = await createConfigService();
    expect(configService.get('sample.added-later')).toBe('from the cloud config');
  });
});

describe('validateConfiguration', () => {
  it('should accept the configuration of the application', () => {
    expect(() => configuration()).not.toThrow();
  });

  it('should refuse an invalid property, telling the property and what it expects', () => {
    const invalid = configuration() as any;
    invalid.server.port = 'not a port';
    invalid.jhipster.cors['max-age'] = -1;
    expect(() => validateConfiguration(invalid)).toThrow(
      /server\.port is "not a port", expected a port\n.*jhipster\.cors\.max-age is -1, expected a number of seconds/,
    );
  });
});
