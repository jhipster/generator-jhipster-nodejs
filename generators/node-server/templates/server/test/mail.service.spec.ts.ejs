import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

import { MAILER_OPTIONS, MailerService } from '@nestjs-modules/mailer';
import { ConfigModule, ConfigService } from '@nestjs/config';
import { Test, TestingModule } from '@nestjs/testing';

import { MailModule, mailerOptions } from '../src/module/mail.module.ts';
import { MailService, parseProperties } from '../src/service/mail.service.ts';

describe('MailService', () => {
  let moduleRef: TestingModule;
  let mailService: MailService;
  let sendMail: ReturnType<typeof vi.spyOn>;

  const user = { login: 'mailuser', email: 'mailuser@localhost.it', password: '', langKey: 'en', activationKey: 'activationKey', resetKey: 'resetKey' };

  /** The mail the JSON transport of nodemailer gives back instead of sending it. */
  const sentMail = async (): Promise<{ from: { address: string }; subject: string; html: string }> =>
    JSON.parse(((await sendMail.mock.results[0].value) as { message: string }).message);

  beforeEach(async () => {
    moduleRef = await Test.createTestingModule({
      imports: [
        ConfigModule.forRoot({
          isGlobal: true,
          ignoreEnvFile: true,
          load: [() => ({ mail: { host: 'localhost', port: 25 }, jhipster: { mail: { from: '<%= baseName %>@localhost', 'base-url': 'http://127.0.0.1:<%= serverPort %>' } } })],
        }),
        MailModule,
      ],
    })
      .overrideProvider(MAILER_OPTIONS)
      .useFactory({ factory: (configService: ConfigService) => ({ ...mailerOptions(configService), transport: { jsonTransport: true } }), inject: [ConfigService] })
      .compile();
    mailService = moduleRef.get(MailService);
    sendMail = vi.spyOn(moduleRef.get(MailerService), 'sendMail');
  });

  afterEach(async () => {
    await moduleRef.close();
  });

  it('should send the activation mail with the activation link', async () => {
    await mailService.sendActivationEmail(user);

    const mail = await sentMail();
    expect(mail.from.address).toBe('<%= baseName %>@localhost');
    expect(mail.subject).toBe('<%- baseName %> account activation');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%= serverPort %>/account/activate?key=activationKey">');
    expect(mail.html).toContain('<p>Dear mailuser</p>');
  });

  it('should send the creation mail with the link to set the password', async () => {
    await mailService.sendCreationEmail(user);

    const mail = await sentMail();
    expect(mail.subject).toBe('<%- baseName %> account activation');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%= serverPort %>/account/reset/finish?key=resetKey">');
  });

  it('should send the password reset mail with the reset link', async () => {
    await mailService.sendPasswordResetMail(user);

    const mail = await sentMail();
    expect(mail.subject).toBe('<%- baseName %> password reset');
    expect(mail.html).toContain('<a href="http://127.0.0.1:<%= serverPort %>/account/reset/finish?key=resetKey">');
  });

  it('should escape the user values in the mail', async () => {
    await mailService.sendActivationEmail({ ...user, login: '<b>mailuser</b>' });

    expect((await sentMail()).html).toContain('<p>Dear &lt;b&gt;mailuser&lt;/b&gt;</p>');
  });

  it('should use the default messages for a language without its messages file', async () => {
    await mailService.sendPasswordResetMail({ ...user, langKey: 'unknown' });

    expect((await sentMail()).subject).toBe('<%- baseName %> password reset');
  });

  it('should use the default messages for a langKey that is not a language tag', async () => {
    await mailService.sendPasswordResetMail({ ...user, langKey: '../config/application' });

    expect((await sentMail()).subject).toBe('<%- baseName %> password reset');
  });

  it('should not send a mail to a user without email', async () => {
    await mailService.sendActivationEmail({ ...user, email: '' });

    expect(sendMail).not.toHaveBeenCalled();
  });

  it('should not fail when the mail could not be sent', async () => {
    sendMail.mockRejectedValue(new Error('Connection refused'));

    await expect(mailService.sendActivationEmail(user)).resolves.toBeUndefined();
  });

  it('should parse the messages of a properties file', () => {
    expect(parseProperties('# comment\nemail.greeting=Caro {0}\nemail.title = \\u00c9quipe\n')).toEqual({
      'email.greeting': 'Caro {0}',
      'email.title': 'Équipe',
    });
  });
});
