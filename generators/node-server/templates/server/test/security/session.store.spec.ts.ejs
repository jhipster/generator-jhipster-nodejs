import { beforeEach, describe, expect, it } from 'vitest';
import { promisify } from 'node:util';
import { Session } from '../../src/domain/session.entity.ts';
import { SessionStore } from '../../src/security/session.store.ts';

/** The threshold of a criterion on the expiry, a LessThan of TypeORM or a $lt of MongoDB. */
const lessThan = (criterion: any): number => new Date(criterion.value ?? criterion.$lt).getTime();

/** A repository of the sessions in memory, with the queries the store makes. */
const repository = (rows: Session[]): any => ({
  findOne: ({ where }: any) => Promise.resolve(rows.find(row => row.sid === where.sid) ?? null),
  find: (options?: any) => Promise.resolve(rows.filter(row => !options?.where?.login || row.login === options.where.login)),
  save: (entity: Session) => {
    const index = rows.findIndex(row => row.sid === entity.sid);
    rows.splice(index < 0 ? rows.length : index, index < 0 ? 0 : 1, { ...entity });
    return Promise.resolve(entity);
  },
  update: ({ sid }: any, values: Partial<Session>) => Promise.resolve(Object.assign(rows.find(row => row.sid === sid) ?? {}, values)),
  delete: (criteria: any) => {
    const kept = rows.filter(row => (criteria.sid ? row.sid !== criteria.sid : row.expires.getTime() >= lessThan(criteria.expires)));
    rows.splice(0, rows.length, ...kept);
    return Promise.resolve();
  },
});

/** All the sessions of the store, by their ids. */
const allOf = (store: SessionStore): Promise<Record<string, unknown>> =>
  new Promise((resolve, reject) => store.all((error, sessions) => (error ? reject(error as Error) : resolve(sessions ?? {}))));

const sessionData = (login: string | undefined, expires: Date): any => ({ cookie: { expires: expires.toISOString() }, ...(login ? { user: { login } } : {}) });

describe('SessionStore', () => {
  let rows: Session[];
  let store: SessionStore;
  const inOneHour = new Date(Date.now() + 60 * 60 * 1000);
  const anHourAgo = new Date(Date.now() - 60 * 60 * 1000);

  beforeEach(() => {
    rows = [];
    store = new SessionStore(repository(rows));
  });

  it('saves a session with the login of its user and the expiry of its cookie, and gives it back', async () => {
    await promisify(store.set.bind(store))('s1', sessionData('user', inOneHour));
    await promisify(store.set.bind(store))('s1', { ...sessionData('user', inOneHour), series: 'a' });
    expect(rows).toHaveLength(1);
    expect(rows[0]).toMatchObject({ sid: 's1', login: 'user', expires: inOneHour });
    expect(await promisify(store.get.bind(store))('s1')).toMatchObject({ user: { login: 'user' }, series: 'a' });
  });

  it('gives no session for an expired or unknown id', async () => {
    rows.push({ sid: 'old', login: 'user', expires: anHourAgo, data: '{}' });
    expect(await promisify(store.get.bind(store))('old')).toBeNull();
    expect(await promisify(store.get.bind(store))('unknown')).toBeNull();
  });

  it('extends a session its request did not change', async () => {
    rows.push({ sid: 's1', login: 'user', expires: anHourAgo, data: '{}' });
    await promisify(store.touch.bind(store))('s1', sessionData('user', inOneHour));
    expect(rows[0].expires).toEqual(inOneHour);
  });

  it('ends a session', async () => {
    rows.push({ sid: 's1', login: 'user', expires: inOneHour, data: '{}' });
    await promisify(store.destroy.bind(store))('s1');
    expect(rows).toHaveLength(0);
  });

  it('lists the sessions not expired, of every user and of a user', async () => {
    rows.push(
      { sid: 's1', login: 'user', expires: inOneHour, data: '{"a":1}' },
      { sid: 's2', login: 'other', expires: inOneHour, data: '{}' },
      { sid: 's3', login: 'user', expires: anHourAgo, data: '{}' },
    );
    expect(Object.keys(await allOf(store))).toEqual(['s1', 's2']);
    expect(await store.sessionsOf('user')).toEqual([{ sid: 's1', data: { a: 1 } }]);
  });

  it('waits for the operations in progress before the database is closed, like a touch ending a response', async () => {
    let finish!: () => void;
    const slow = new SessionStore({ ...repository(rows), update: () => new Promise<void>(resolve => (finish = resolve)) });
    let touched = false;
    slow.touch('s1', sessionData('user', inOneHour), () => (touched = true));
    let closed = false;
    const closing = slow.onModuleDestroy().then(() => (closed = true));
    await Promise.resolve();
    expect(closed).toBe(false);
    finish();
    await closing;
    expect(touched).toBe(true);
    expect(closed).toBe(true);
  });

  it('removes the expired sessions', async () => {
    rows.push({ sid: 's1', login: 'user', expires: inOneHour, data: '{}' }, { sid: 's2', login: 'user', expires: anHourAgo, data: '{}' });
    await store.prune();
    expect(rows.map(row => row.sid)).toEqual(['s1']);
  });
});
