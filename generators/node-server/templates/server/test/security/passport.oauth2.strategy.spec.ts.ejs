import { describe, expect, it, vi } from 'vitest';
import { Oauth2Strategy } from '../../src/security/passport.oauth2.strategy.ts';

const token = (claims: object): string => `${Buffer.from('{"alg":"none"}').toString('base64url')}.${Buffer.from(JSON.stringify(claims)).toString('base64url')}.`;

describe('OAuth2 login strategy', () => {
  it('should build the user of the ID token of the token response, which passport-oauth2 gives to the verify', async () => {
    const authService = { findUserOrSave: vi.fn() };
    const configService = { get: () => 'value' };
    const oauth2Config = { authorizationURL: 'http://localhost/auth', tokenURL: 'http://localhost/token', callbackURL: 'http://localhost/callback' };
    const strategy: any = new Oauth2Strategy(authService as any, configService as any, oauth2Config as any);
    // passport-oauth2 gives the params of the token response with a verify of 5 parameters only (4 without them).
    expect(strategy._verify).toHaveLength(5);

    const idToken = token({ sub: 'abc', preferred_username: 'User', email: 'User@Example.com', groups: ['ROLE_USER'] });
    const user = await new Promise((resolve, reject) =>
      strategy._verify(token({ sub: 'abc' }), 'refresh', { id_token: idToken }, undefined, (error: Error | null, result: unknown) =>
        error ? reject(error) : resolve(result),
      ),
    );

    expect(user).toMatchObject({ login: 'user', email: 'user@example.com', authorities: ['ROLE_USER'], idToken });
<%_ if (generateBuiltInUserEntity) { _%>
    expect(authService.findUserOrSave).toHaveBeenCalledWith(expect.objectContaining({ login: 'user' }));
<%_ } _%>
  });
});
