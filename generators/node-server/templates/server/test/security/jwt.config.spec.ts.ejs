import { describe, expect, it } from 'vitest';
import { ConfigService } from '@nestjs/config';
import { JWT_MIN_KEY_BYTES, jwtSecretKey } from '../../src/security/jwt.config.ts';

const configServiceOf = (secret: string): ConfigService =>
  ({ getOrThrow: () => secret }) as unknown as ConfigService;

describe('JWT key', () => {
  it('is the base64 decoded secret', () => {
    const key = Buffer.alloc(JWT_MIN_KEY_BYTES, 1);
    expect(jwtSecretKey(configServiceOf(key.toString('base64')))).toEqual(key);
  });

  it('refuses a secret shorter than 512 bits, like the HS512 key of JHipster Spring Boot', () => {
    const secret = Buffer.alloc(JWT_MIN_KEY_BYTES - 1, 1).toString('base64');
    expect(() => jwtSecretKey(configServiceOf(secret))).toThrow(/too short: 504 bits/);
  });

  it('refuses a missing secret', () => {
    expect(() => jwtSecretKey(configServiceOf(''))).toThrow(/is not set/);
  });
});
