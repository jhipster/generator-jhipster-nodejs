import fs from 'fs';
import path from 'path';

// The configuration files next to the build (dist/config), read by src/config.ts.
const out = path.join(import.meta.dirname, '..', 'dist');
fs.mkdirSync(path.join(out, 'config'), { recursive: true });
fs.cpSync(path.join(import.meta.dirname, '..', 'src', 'config'), path.join(out, 'config'), { recursive: true });
