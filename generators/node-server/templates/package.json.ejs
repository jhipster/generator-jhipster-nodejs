{
  "name": "<%= dasherizedBaseName %>",
  "version": "0.0.0",
  "description": "Description for <%= baseName %>",
  "private": true,
  "license": "UNLICENSED",
  "cacheDirectories": [
    "node_modules"
  ],
  "devDependencies": {
    "@eslint/js": "<%- nodeServerDependencies['@eslint/js'] %>",
    "concurrently": "<%= nodeDependencies['concurrently'] %>",
    "eslint": "<%- nodeServerDependencies['eslint'] %>",
    "eslint-config-prettier": "<%- nodeServerDependencies['eslint-config-prettier'] %>",
    "globals": "<%- nodeServerDependencies['globals'] %>",
    "prettier": "<%= nodeDependencies['prettier'] %>",
    "prettier-plugin-packagejson": "<%= nodeDependencies['prettier-plugin-packagejson'] %>",
    "typescript-eslint": "<%- nodeServerDependencies['typescript-eslint'] %>"<% if (clientFrameworkAny) { %>,
    "wait-on": "<%= nodeDependencies['wait-on'] %>"<% } %>
  },
  "engines": {
    "node": ">=<%= nodeVersion %>"
  },
<%_ if (clientFrameworkAny) { _%>
  "config": {
    "backend_port": <%= serverPort %>
  },
<%_ } _%>
  "workspaces": [
      "server"
  ],
  "scripts": {
    "backend:start": "<%= clientPackageManager %> run start:server",
<%_ if (clientFrameworkAny) { _%>
    "app:start": "<%= clientPackageManager %> run build && BACKEND_ENV=dev <%= clientPackageManager %> run start:prod -w server",
    "ci:e2e:package": "<%= clientPackageManager %> run build",
<%_ if ((testFrameworks ?? []).some(testFramework => ['cypress', 'playwright'].includes(testFramework))) { _%>
    "e2e": "<%= clientPackageManager %> run e2e -w client",
<%_ } _%>
    "ci:e2e:server:start": "BACKEND_ENV=test <%= clientPackageManager %> run start:prod -w server",
    "ci:server:await": "echo \"Waiting for server at port $npm_package_config_backend_port to start\" && wait-on -t 180000 <%- nodejsServerAwaitEndpoint %> && echo \"Server at port $npm_package_config_backend_port started\"",
    "build": "<%= clientPackageManager %> run build -w server && <%= clientPackageManager %> run build -w client",
<%_ } else { _%>
    "build": "<%= clientPackageManager %> run build -w server",
<%_ } _%>
    "build:app": "<%= clientPackageManager %> run build -w server",
    "ci:docker:build": "<%= clientPackageManager %> run docker:build",
    "docker:build": "docker build -t <%= baseName.toLowerCase() %> .",
    "lint": "<%= clientPackageManager %> run lint --workspaces",
    "lint:fix": "<%= clientPackageManager %> run lint:fix --workspaces",
    "prettier:check": "prettier --check \"{,src/**/}*.{<%= prettierExtensions %>}\"",
    "prettier:format": "prettier --write \"{,src/**/}*.{<%= prettierExtensions %>}\"",
<%_ if (clientFrameworkAny) { _%>
    "start": "concurrently -k -s first -n application,client -c red,green npm:start:server npm:start:client",
<%_ } else { _%>
    "start": "<%= clientPackageManager %> run start:server",
<%_ } _%>
    "start:server": "<%= clientPackageManager %> run start -w server",
<%_ if (clientFrameworkAny) { _%>
    "start:client": "<%= clientPackageManager %> run start -w client",
    "test:client": "<%= clientPackageManager %> test -w client",
<%_ } _%>
    "test:server": "<%= clientPackageManager %> test -w server",
    "test:server:e2e": "<%= clientPackageManager %> run test:e2e -w server",
    "test": "<%= clientPackageManager %> test --workspaces"
  }
}
