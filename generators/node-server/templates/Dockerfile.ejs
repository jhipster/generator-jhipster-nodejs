<%_
const serverDir = nodeServerRootDir.replace(/\/$/, '');
const clientDir = clientRootDir.replace(/\/$/, '');
_%>
# Build stage: installs every dependency and builds the application.
FROM node:<%- nodeVersion %>-alpine AS build

WORKDIR /usr/src/app

# The package-lock.json of the application, missing in a workspace of applications (its lock is the one of the workspace).
COPY package*.json ./
COPY <%- nodeServerRootDir %>package.json <%- nodeServerRootDir %>
<%_ if (clientFrameworkAny) { _%>
COPY <%- clientRootDir %>package.json <%- clientRootDir %>
<%_ } _%>
# The install scripts (native bindings of the development database, husky, Cypress) are not needed to build. npm install
# installs the versions of the package-lock.json, or resolves them and writes one, the runtime stage installs from it.
RUN npm install --ignore-scripts

COPY . .
RUN npm run build --workspace <%- serverDir %>
<%_ if (clientFrameworkAny) { _%>
# The client is built into <%- nodeServerRootDir %>dist/static, served by the server.
RUN npm run build --workspace <%- clientDir %>
<%_ } _%>

# Runtime stage: the production dependencies of the server and its build only.
FROM node:<%- nodeVersion %>-alpine

WORKDIR /usr/src/app

ENV NODE_ENV=production
ENV BACKEND_ENV=prod
ENV NODE_SERVER_PORT=<%- serverPort %>

COPY package.json ./
COPY --from=build /usr/src/app/package-lock.json ./
COPY <%- nodeServerRootDir %>package.json <%- nodeServerRootDir %>
<%_ if (clientFrameworkAny) { _%>
COPY <%- clientRootDir %>package.json <%- clientRootDir %>
<%_ } _%>
RUN npm ci --omit=dev --ignore-scripts --workspace <%- serverDir %> && npm cache clean --force

COPY --from=build /usr/src/app/<%- nodeServerRootDir %>dist <%- nodeServerRootDir %>dist

USER node
WORKDIR /usr/src/app/<%- serverDir %>

EXPOSE <%- serverPort %>

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD ["node", "-e", "fetch(`http://localhost:${process.env.NODE_SERVER_PORT}/management/health`).then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

CMD ["node", "dist/main.js"]
